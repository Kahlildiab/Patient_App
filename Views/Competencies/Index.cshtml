@model List<DentalCollegeManagementSystem_AAU.Models.Competency>
@using DentalCollegeManagementSystem_AAU.Models

@{
    ViewData["Title"] = "Student Competencies";

    string userRole =
        ViewBag.UserRole as string
        ?? string.Empty;

    bool isStudent =
        ViewBag.IsStudent != null
        &&
        (bool)ViewBag.IsStudent;

    bool canEdit =
        ViewBag.CanEdit != null
        &&
        (bool)ViewBag.CanEdit;

    string search =
        ViewBag.Search as string
        ?? string.Empty;

    string status =
        ViewBag.Status as string
        ?? "all";

    var students =
        ViewBag.Students as List<User>
        ?? new List<User>();

    var completedCountByStudent =
        ViewBag.CompletedCountByStudent
        as Dictionary<int, int>
        ?? new Dictionary<int, int>();

    int totalTemplates =
        ViewBag.TotalTemplates != null
            ? Convert.ToInt32(
                ViewBag.TotalTemplates
            )
            : Model.Count;

    var selectedStudent =
        ViewBag.SelectedStudent
        as User;

    var studentRecords =
        ViewBag.StudentRecords
        as List<Competency>
        ?? new List<Competency>();

    var recordsByTemplate =
        studentRecords
            .Where(
                record =>
                    record.TemplateCompetencyID
                        .HasValue
            )
            .GroupBy(
                record =>
                    record.TemplateCompetencyID!
                        .Value
            )
            .ToDictionary(
                group =>
                    group.Key,

                group =>
                    group
                        .OrderByDescending(
                            record =>
                                record.UpdatedDate
                        )
                        .First()
            );

    var categories =
        Model
            .GroupBy(
                item =>
                    new
                    {
                        item.CategoryName,
                        item.CategoryOrder
                    }
            )
            .OrderBy(
                group =>
                    group.Key.CategoryOrder
            )
            .ToList();

    int selectedCompletedCount =
        studentRecords.Count(
            record =>
                record.IsCompleted
        );

    selectedCompletedCount =
        totalTemplates > 0
            ? Math.Min(
                selectedCompletedCount,
                totalTemplates
            )
            : 0;

    int selectedPercentage =
        totalTemplates > 0
            ? (int)Math.Round(
                (double)selectedCompletedCount
                / totalTemplates
                * 100
            )
            : 0;
}


<link rel="stylesheet" href="~/css/Site.css" />
<link rel="stylesheet" href="~/css/RTE.css" />

<style>
    :root {
        --comp-blue: #252468;
        --comp-blue-light: #eef0f8;
        --comp-gold: #daa328;
        --comp-pink: #c81589;
        --comp-gray-bg: #e9e8e8;
        --comp-border: #dddddd;
        --comp-text: #333333;
        --comp-muted: #777777;
        --comp-success: #16a34a;
        --comp-danger: #dc2626;
    }

    .comp-page-wrapper {
        width: 100%;
    }

    .comp-container {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 15px;
    }

    /* ==============================
           SEARCH AREA — مثل AllocatedStudent
           ============================== */
    .comp-search-band {
        background: var(--comp-gray-bg);
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        padding: 30px 40px;
    }

    .comp-search-inner {
        max-width: 1300px;
        margin: 0 auto;
    }

    .comp-search-box {
        background: #ffffff;
        padding: 18px 20px;
    }

    .comp-search-row {
        display: grid;
        grid-template-columns: 190px minmax(0, 1fr);
        gap: 16px;
        align-items: center;
        margin-bottom: 16px;
    }

        .comp-search-row:last-child {
            margin-bottom: 0;
        }

    .comp-label {
        color: var(--comp-blue);
        font-size: 13px;
        font-weight: 600;
        margin: 0;
    }

    .comp-input,
    .comp-select {
        width: 100%;
        min-height: 40px;
        border: 1px solid var(--comp-border);
        border-radius: 0;
        background: #ffffff;
        color: var(--comp-text);
        padding: 8px 12px;
        font-size: 13px;
        box-sizing: border-box;
        outline: none;
    }

        .comp-input:focus,
        .comp-select:focus {
            border-color: var(--comp-blue);
            box-shadow: 0 0 0 2px rgba(37, 36, 104, .08);
        }

    .comp-search-button-wrap {
        text-align: center;
    }

    .comp-search-button {
        width: 90%;
        margin-top: 3px;
        border: 0;
        background: var(--comp-pink);
        color: #ffffff;
        padding: 12px;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: pointer;
        transition: opacity .2s ease;
    }

        .comp-search-button:hover {
            opacity: .9;
        }

    /* ==============================
           COMMON CARDS
           ============================== */
    .comp-custom-card {
        background: #ffffff;
        border: 1px solid #e3e3e3;
        padding: 22px;
        box-shadow: 0 3px 14px rgba(37, 36, 104, .07);
    }

    .comp-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .comp-total-title {
        color: rgb(38, 76, 159);
        font-size: 17px;
        font-weight: 600;
        margin: 0;
    }

    .comp-total-badge {
        display: inline-block;
        background: var(--comp-gold);
        color: #ffffff;
        padding: 4px 12px;
        font-weight: 600;
        margin-left: 5px;
    }

    .comp-role-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fff8e1;
        color: #805d0b;
        border: 1px solid #f0cf75;
        padding: 5px 11px;
        font-size: 11px;
        font-weight: 700;
    }

    .comp-alert {
        margin-bottom: 16px;
        background: #fdecea;
        color: #b71c1c;
        border: 1px solid #ef9a9a;
        padding: 11px 14px;
        font-size: 12px;
    }

    .comp-active-filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

    .comp-active-filter-title {
        color: var(--comp-pink);
        font-size: 12px;
        font-weight: 600;
    }

    .comp-filter-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e8eaf6;
        color: var(--comp-blue);
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 600;
    }

    /* ==============================
           STUDENTS TABLE
           ============================== */
    .comp-table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .comp-table {
        width: 100%;
        margin-bottom: 0;
        border-collapse: collapse;
        font-size: 13px;
    }

        .comp-table th {
            background: var(--comp-blue);
            color: #ffffff;
            border: 1px solid #dedede;
            padding: 12px 14px;
            text-align: left;
            vertical-align: middle;
            font-weight: 600;
            white-space: nowrap;
        }

        .comp-table td {
            border: 1px solid #dedede;
            padding: 12px 14px;
            color: var(--comp-text);
            vertical-align: middle;
        }

        .comp-table tbody tr:nth-child(odd) {
            background: #fafafa;
        }

        .comp-table tbody tr:hover {
            background: #f2f4fb;
        }

    .comp-student-name {
        color: var(--comp-blue);
        font-size: 14px;
        font-weight: 700;
    }

    .comp-muted {
        margin-top: 3px;
        color: #8b8b8b;
        font-size: 11px;
    }

    .comp-progress-row {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 180px;
    }

    .comp-progress-track {
        flex: 1;
        height: 9px;
        overflow: hidden;
        border-radius: 999px;
        background: #e5e7eb;
    }

    .comp-progress-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--comp-blue), var(--comp-gold));
        transition: width .3s ease;
    }

    .comp-progress-text {
        min-width: 42px;
        color: var(--comp-blue);
        text-align: right;
        font-size: 12px;
        font-weight: 700;
    }

    .comp-status {
        display: inline-block;
        border-radius: 4px;
        padding: 3px 10px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .comp-status-completed {
        background: #d1e7dd;
        color: #0f5132;
        border: 1px solid #a3cfbb;
    }

    .comp-status-progress {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffc107;
    }

    .comp-status-new {
        background: #e2e3e5;
        color: #383d41;
        border: 1px solid #d6d8db;
    }

    .comp-open-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 0;
        background: none;
        color: #2563eb !important;
        padding: 5px 6px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
    }

        .comp-open-btn:hover {
            color: var(--comp-pink) !important;
        }

    .comp-empty {
        padding: 35px 15px;
        color: #8e8e8e;
        text-align: center;
        font-size: 13px;
    }

    /* ==============================
           STUDENT DETAILS
           ============================== */
    .comp-back-wrap {
        margin-bottom: 14px;
    }

    .comp-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid var(--comp-blue);
        background: #ffffff;
        color: var(--comp-blue) !important;
        padding: 7px 14px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none !important;
    }

        .comp-back-btn:hover {
            background: var(--comp-blue);
            color: #ffffff !important;
        }

    .comp-profile-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 250px;
        gap: 14px;
        margin-bottom: 16px;
    }

    .comp-profile-card,
    .comp-progress-card {
        border: 1px solid #dfe3ea;
        background: #ffffff;
        padding: 18px;
    }

    .comp-profile-card {
        border-left: 5px solid var(--comp-gold);
    }

    .comp-profile-name {
        color: var(--comp-blue);
        font-size: 19px;
        font-weight: 700;
    }

    .comp-profile-meta {
        margin-top: 8px;
        color: #666666;
        font-size: 12px;
        line-height: 1.9;
    }

    .comp-total-percentage {
        color: var(--comp-blue);
        font-size: 33px;
        font-weight: 800;
        text-align: center;
    }

    .comp-total-label,
    .comp-total-summary {
        color: #777777;
        font-size: 11px;
        text-align: center;
    }

    .comp-total-summary {
        margin-top: 8px;
        font-size: 12px;
    }

    .comp-readonly {
        margin-bottom: 16px;
        border: 1px solid #f0cf75;
        background: #fff8e1;
        color: #805a00;
        padding: 12px 15px;
        font-size: 12px;
        font-weight: 600;
    }

    .comp-details-filter-box {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        padding: 14px;
        margin-bottom: 16px;
    }

    .comp-details-filters {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, 1fr);
        gap: 12px;
    }

    /* ==============================
           COMPETENCY CATEGORIES
           ============================== */
    .comp-category {
        overflow: hidden;
        margin-bottom: 12px;
        border: 1px solid #dfe3ea;
        background: #ffffff;
    }

    .comp-category-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        background: #f8fafc;
        border-left: 5px solid var(--comp-gold);
        cursor: pointer;
    }

        .comp-category-header:hover {
            background: #f1f3f8;
        }

    .comp-category-title {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--comp-blue);
        font-size: 14px;
        font-weight: 700;
    }

    .comp-category-stat {
        display: inline-block;
        background: var(--comp-blue);
        color: #ffffff;
        border-radius: 20px;
        padding: 3px 10px;
        font-size: 10px;
        font-weight: 700;
    }

    .comp-items {
        border-top: 1px solid #e5e7eb;
    }

    .comp-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 11px 16px;
        border-bottom: 1px solid #ececec;
    }

        .comp-item:last-child {
            border-bottom: 0;
        }

        .comp-item:hover {
            background: #fafafa;
        }

    .comp-item-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .comp-circle {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 2px solid #bcc4d1;
        border-radius: 50%;
        background: #ffffff;
    }

        .comp-circle.editable {
            cursor: pointer;
        }

            .comp-circle.editable:hover {
                border-color: var(--comp-blue);
                background: var(--comp-blue-light);
            }

        .comp-circle.done {
            border-color: var(--comp-success);
            background: var(--comp-success);
        }

            .comp-circle.done::after {
                content: "";
                width: 6px;
                height: 10px;
                display: block;
                border: 2px solid #ffffff;
                border-top: 0;
                border-left: 0;
                transform: rotate(45deg) translateY(-1px);
            }

    .comp-item-name {
        color: #333333;
        font-size: 13px;
        font-weight: 600;
    }

        .comp-item-name.done {
            color: #777777;
        }

    .comp-item-meta {
        color: #999999;
        font-size: 10px;
        text-align: right;
        white-space: nowrap;
    }

    .comp-no-results {
        display: none;
        padding: 30px;
        color: #8f95a0;
        text-align: center;
    }

    @@media (max-width: 900px) {
        .comp-search-band {
            padding: 25px 15px;
        }

        .comp-search-row,
        .comp-profile-grid,
        .comp-details-filters {
            grid-template-columns: 1fr;
        }

        .comp-search-button {
            width: 100%;
        }

        .comp-table {
            min-width: 820px;
        }
    }

    @@media (max-width: 600px) {
        .comp-custom-card {
            padding: 14px;
        }

        .comp-item {
            align-items: flex-start;
        }

        .comp-item-meta {
            white-space: normal;
        }
    }
</style>


<div class="comp-page-wrapper">

    @if (TempData["CompetencyError"] != null)
    {
        <div class="comp-container">
            <div class="comp-alert">
                <i class="fa-solid fa-circle-exclamation me-1"></i>
                @TempData["CompetencyError"]
            </div>
        </div>
    }

    @if (
        !isStudent
        &&
        selectedStudent == null
    )
    {
        <!-- ═════════ SEARCH ═════════ -->
        <div class="comp-search-band">
            <div class="comp-search-inner">

                <section id="title-wrapper"
                         style="justify-content:flex-start;">

                    <div class="lineright"
                         style="display:block;
                        background-color:#daa328;
                        max-width:650px;">
                    </div>

                    <h1 class="sectiontitle heading6">
                        <p style="text-align:left;">
                            <span style="color:#252468;">
                                SEARCH
                            </span>
                        </p>
                    </h1>
                </section>

                <br />

                <form asp-controller="Competencies"
                      asp-action="Index"
                      method="get">

                    <div class="comp-search-box">
                        <div class="comp-search-row">
                            <label class="comp-label">
                                Search Student
                            </label>

                            <input type="text"
                                   name="search"
                                   value="@search"
                                   class="comp-input"
                                   placeholder="Name, username, or email..." />
                        </div>

                        <div class="comp-search-row">
                            <label class="comp-label">
                                Completion Status
                            </label>

                            <select name="status"
                                    class="comp-select">

                                @if (status == "all")
                                {
                                    <option value="all" selected>
                                        All Students
                                    </option>
                                }
                                else
                                {
                                    <option value="all">
                                        All Students
                                    </option>
                                }

                                @if (status == "completed")
                                {
                                    <option value="completed" selected>
                                        Completed
                                    </option>
                                }
                                else
                                {
                                    <option value="completed">
                                        Completed
                                    </option>
                                }

                                @if (status == "inprogress")
                                {
                                    <option value="inprogress" selected>
                                        In Progress
                                    </option>
                                }
                                else
                                {
                                    <option value="inprogress">
                                        In Progress
                                    </option>
                                }

                                @if (status == "notstarted")
                                {
                                    <option value="notstarted" selected>
                                        Not Started
                                    </option>
                                }
                                else
                                {
                                    <option value="notstarted">
                                        Not Started
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="comp-search-button-wrap">
                        <button type="submit"
                                class="comp-search-button">
                            Search
                            &nbsp;
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <br />

        <!-- ═════════ STUDENTS TABLE ═════════ -->
        <div class="page-wrapper">
            <div class="container">

                <section id="title-wrapper"
                         style="justify-content:End;">

                    <div class="lineleft"></div>

                    <h1 class="sectiontitle heading6">
                        <p style="text-align:center;">
                            <span style="color:#252468;">
                                STUDENT COMPETENCIES
                            </span>
                        </p>
                    </h1>

                    <div class="lineright"
                         style="display:block;
                        background-color:#daa328;">
                    </div>
                </section>

                <br />

                <div class="comp-custom-card">

                    <div class="comp-card-header">
                        <h5 class="comp-total-title">
                            Total Students
                            <span class="comp-total-badge">
                                @students.Count
                            </span>
                        </h5>

                        <span class="comp-role-badge">
                            <i class="fa-solid fa-user-shield"></i>
                            Admin / Supervisor Edit
                        </span>
                    </div>

                    @if (
                        !string.IsNullOrWhiteSpace(search)
                        ||
                        status != "all"
                    )
                    {
                        <div class="comp-active-filters">
                            <span class="comp-active-filter-title">
                                Active filters:
                            </span>

                            @if (
                                !string.IsNullOrWhiteSpace(search)
                            )
                            {
                                <span class="comp-filter-tag">
                                    <i class="fa-solid fa-user"></i>
                                    @search
                                </span>
                            }

                            @if (status != "all")
                            {
                                <span class="comp-filter-tag">
                                    <i class="fa-solid fa-filter"></i>
                                    @(
                                        status == "completed"
                                            ? "Completed"
                                            : status == "inprogress"
                                                ? "In Progress"
                                                : "Not Started"
                                    )
                                </span>
                            }
                        </div>
                    }

                    <div class="comp-table-responsive">
                        @if (!students.Any())
                        {
                            <div class="comp-empty">
                                <i class="fa-solid fa-circle-exclamation me-2"></i>
                                No students match the selected filters.
                            </div>
                        }
                        else
                        {
                            <table class="comp-table">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Username</th>
                                        <th>Progress</th>
                                        <th>Status</th>
                                        <th style="text-align:center;">
                                            Actions
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var student in students)
                                    {
                                        int completedCount =
                                            completedCountByStudent
                                                .TryGetValue(
                                                    student.UserID,
                                                    out int savedCount
                                                )
                                                    ? Math.Min(
                                                        savedCount,
                                                        totalTemplates
                                                    )
                                                    : 0;

                                        int percentage =
                                            totalTemplates > 0
                                                ? (int)Math.Round(
                                                    (double)completedCount
                                                    / totalTemplates
                                                    * 100
                                                )
                                                : 0;

                                        string statusText =
                                            completedCount <= 0
                                                ? "Not Started"
                                                : (
                                                    totalTemplates > 0
                                                    &&
                                                    completedCount
                                                        >= totalTemplates
                                                )
                                                    ? "Completed"
                                                    : "In Progress";

                                        string statusClass =
                                            statusText == "Completed"
                                                ? "comp-status-completed"
                                                : statusText == "In Progress"
                                                    ? "comp-status-progress"
                                                    : "comp-status-new";

                                        <tr>
                                            <td>
                                                <div class="comp-student-name">
                                                    @(
                                                        string.IsNullOrWhiteSpace(
                                                            student.FullName
                                                        )
                                                            ? student.Username
                                                            : student.FullName
                                                    )
                                                </div>

                                                <div class="comp-muted">
                                                    @(
                                                        string.IsNullOrWhiteSpace(
                                                            student.Email
                                                        )
                                                            ? "No email"
                                                            : student.Email
                                                    )
                                                </div>
                                            </td>

                                            <td>
                                                @student.Username
                                            </td>

                                            <td>
                                                <div class="comp-progress-row">
                                                    <div class="comp-progress-track">
                                                        <div class="comp-progress-fill"
                                                             style="width:@percentage%;">
                                                        </div>
                                                    </div>

                                                    <span class="comp-progress-text">
                                                        @percentage%
                                                    </span>
                                                </div>

                                                <div class="comp-muted">
                                                    @completedCount / @totalTemplates
                                                </div>
                                            </td>

                                            <td>
                                                <span class="comp-status @statusClass">
                                                    @statusText
                                                </span>
                                            </td>

                                            <td style="text-align:center;
                                                white-space:nowrap;">

                                                <a class="comp-open-btn"
                                                   asp-controller="Competencies"
                                                   asp-action="Index"
                                                   asp-route-studentId="@student.UserID"
                                                   asp-route-search="@search"
                                                   asp-route-status="@status">

                                                    <i class="fa-solid fa-list-check"></i>
                                                    View &amp; Manage
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (selectedStudent != null)
    {
        <!-- ═════════ COMPETENCY DETAILS ═════════ -->
        <div class="page-wrapper">
            <div class="container">

                <section id="title-wrapper"
                         style="justify-content:End;">

                    <div class="lineleft"></div>

                    <h1 class="sectiontitle heading6">
                        <p style="text-align:center;">
                            <span style="color:#252468;">
                                COMPETENCY DETAILS
                            </span>
                        </p>
                    </h1>

                    <div class="lineright"
                         style="display:block;
                        background-color:#daa328;">
                    </div>
                </section>

                <br />

                @if (!isStudent)
                {
                    <div class="comp-back-wrap">
                        <a class="comp-back-btn"
                           asp-controller="Competencies"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-status="@status">

                            <i class="fa-solid fa-arrow-left"></i>
                            Back to Students
                        </a>
                    </div>
                }

                <div class="comp-custom-card">

                    <div class="comp-card-header">
                        <h5 class="comp-total-title">
                            Student Competencies
                        </h5>

                        <span class="comp-role-badge">
                            <i class="fa-solid @(canEdit ? "fa-pen-to-square" : "fa-eye")"></i>
                            @(
                                canEdit
                                    ? "Admin / Supervisor Edit"
                                    : "Student View Only"
                            )
                        </span>
                    </div>

                    <div class="comp-profile-grid">
                        <div class="comp-profile-card">
                            <div class="comp-profile-name">
                                @(
                                    string.IsNullOrWhiteSpace(
                                        selectedStudent.FullName
                                    )
                                        ? selectedStudent.Username
                                        : selectedStudent.FullName
                                )
                            </div>

                            <div class="comp-profile-meta">
                                <div>
                                    <strong>Username:</strong>
                                    @selectedStudent.Username
                                </div>

                                <div>
                                    <strong>Email:</strong>
                                    @(
                                        string.IsNullOrWhiteSpace(
                                            selectedStudent.Email
                                        )
                                            ? "---"
                                            : selectedStudent.Email
                                    )
                                </div>
                            </div>
                        </div>

                        <div class="comp-progress-card">
                            <div id="comp-total-percentage"
                                 class="comp-total-percentage">
                                @selectedPercentage%
                            </div>

                            <div class="comp-total-label">
                                Overall Completion
                            </div>

                            <div class="comp-progress-track"
                                 style="margin-top:12px;">
                                <div id="comp-total-progress"
                                     class="comp-progress-fill"
                                     style="width:@selectedPercentage%;">
                                </div>
                            </div>

                            <div class="comp-total-summary">
                                <span id="comp-total-completed">
                                    @selectedCompletedCount
                                </span>
                                of
                                <span id="comp-total-items">
                                    @totalTemplates
                                </span>
                                completed
                            </div>
                        </div>
                    </div>

                    @if (!canEdit)
                    {
                        <div class="comp-readonly">
                            <i class="fa-solid fa-lock me-1"></i>
                            You can review your competencies only.
                            Admin or Supervisor can update them.
                        </div>
                    }

                    <div class="comp-details-filter-box">
                        <div class="comp-details-filters">
                            <div>
                                <label class="comp-label">
                                    Category
                                </label>

                                <select id="comp-category-filter"
                                        class="comp-select"
                                        onchange="applyCompetencyFilters()">

                                    <option value="all">
                                        All Categories
                                    </option>

                                    @foreach (var category in categories)
                                    {
                                        string categoryKey =
                                            category.Key.CategoryName
                                                .Replace(" ", "-")
                                                .ToLowerInvariant();

                                        <option value="@categoryKey">
                                            @category.Key.CategoryName
                                        </option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="comp-label">
                                    Completion Status
                                </label>

                                <select id="comp-status-filter"
                                        class="comp-select"
                                        onchange="applyCompetencyFilters()">

                                    <option value="all">
                                        All Statuses
                                    </option>

                                    <option value="completed">
                                        Completed
                                    </option>

                                    <option value="incomplete">
                                        Incomplete
                                    </option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div id="comp-categories">
                        @foreach (var category in categories)
                        {
                            string categoryKey =
                                category.Key.CategoryName
                                    .Replace(" ", "-")
                                    .ToLowerInvariant();

                            int categoryTotal =
                                category.Count();

                            int categoryCompleted =
                                category.Count(
                                    item =>
                                        recordsByTemplate
                                            .TryGetValue(
                                                item.CompetencyID,
                                                out Competency? saved
                                            )
                                        &&
                                        saved.IsCompleted
                                );

                            int categoryPercentage =
                                categoryTotal > 0
                                    ? (int)Math.Round(
                                        (double)categoryCompleted
                                        / categoryTotal
                                        * 100
                                    )
                                    : 0;

                            <div class="comp-category"
                                 data-category="@categoryKey">

                                <div class="comp-category-header"
                                     onclick="toggleCategory('@categoryKey')">

                                    <span class="comp-category-title">
                                        <i class="fa-solid fa-list-check"></i>
                                        @category.Key.CategoryName
                                    </span>

                                    <span id="comp-badge-@categoryKey"
                                          class="comp-category-stat">

                                        @categoryCompleted/@categoryTotal
                                        &nbsp;
                                        @categoryPercentage%
                                    </span>
                                </div>

                                <div id="comp-items-@categoryKey"
                                     class="comp-items">

                                    @foreach (
                                        var item in
                                        category.OrderBy(
                                            competency =>
                                                competency.ItemOrder
                                        )
                                    )
                                    {
                                        recordsByTemplate
                                            .TryGetValue(
                                                item.CompetencyID,
                                                out Competency? record
                                            );

                                        bool completed =
                                            record?.IsCompleted
                                            == true;

                                        string clickAction =
                                            canEdit
                                                ? $"toggleCompetency({selectedStudent.UserID}, {item.CompetencyID})"
                                                : string.Empty;

                                        <div class="comp-item"
                                             id="comp-row-@item.CompetencyID"
                                             data-category="@categoryKey"
                                             data-status="@(completed ? "completed" : "incomplete")">

                                            <div class="comp-item-left">
                                                <div id="comp-circle-@item.CompetencyID"
                                                     class="comp-circle @(completed ? "done" : "") @(canEdit ? "editable" : "")"
                                                     onclick="@clickAction"
                                                     title="@(canEdit ? "Click to update" : "View only")">
                                                </div>

                                                <span id="comp-name-@item.CompetencyID"
                                                      class="comp-item-name @(completed ? "done" : "")">

                                                    @item.ItemName
                                                </span>
                                            </div>

                                            <div id="comp-meta-@item.CompetencyID"
                                                 class="comp-item-meta">

                                                @if (completed)
                                                {
                                                    <div>
                                                        @record?.CompletedDate?
                                                        .ToString(
                                                        "yyyy-MM-dd"
                                                        )
                                                    </div>

                                                    @if (
                                                        !string.IsNullOrWhiteSpace(
                                                            record?.UpdatedBy
                                                        )
                                                    )
                                                    {
                                                        <div>
                                                            by @record?.UpdatedBy
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>
                                                        Not completed
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div id="comp-no-results"
                         class="comp-no-results">
                        No competencies match the selected filters.
                    </div>

                    @Html.AntiForgeryToken()
                </div>
            </div>
        </div>
    }
</div>

<script>
    function toggleCategory(categoryKey) {
        const items =
            document.getElementById(
                `comp-items-${categoryKey}`
            );

        if (!items) {
            return;
        }

        items.style.display =
            items.style.display === "none"
                ? "block"
                : "none";
    }

    function applyCompetencyFilters() {
        const categoryFilter =
            document.getElementById(
                "comp-category-filter"
            )?.value || "all";

        const statusFilter =
            document.getElementById(
                "comp-status-filter"
            )?.value || "all";

        let visibleCount =
            0;

        document
            .querySelectorAll(".comp-category")
            .forEach(function (categoryElement) {
                const categoryKey =
                    categoryElement.dataset.category;

                const categoryMatches =
                    categoryFilter === "all"
                    ||
                    categoryFilter === categoryKey;

                let visibleRowsInCategory =
                    0;

                categoryElement
                    .querySelectorAll(".comp-item")
                    .forEach(function (row) {
                        const statusMatches =
                            statusFilter === "all"
                            ||
                            row.dataset.status
                                === statusFilter;

                        const visible =
                            categoryMatches
                            &&
                            statusMatches;

                        row.style.display =
                            visible
                                ? "flex"
                                : "none";

                        if (visible) {
                            visibleCount++;
                            visibleRowsInCategory++;
                        }
                    });

                categoryElement.style.display =
                    visibleRowsInCategory > 0
                        ? "block"
                        : "none";
            });

        const noResults =
            document.getElementById(
                "comp-no-results"
            );

        if (noResults) {
            noResults.style.display =
                visibleCount === 0
                    ? "block"
                    : "none";
        }
    }

    async function toggleCompetency(
        studentUserId,
        competencyId
    ) {
        const token =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            )?.value;

        try {
            const response =
                await fetch(
                    '@Url.Action("Toggle", "Competencies")',
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded",

                            "RequestVerificationToken":
                                token || ""
                        },

                        body:
                            `studentUserId=${encodeURIComponent(studentUserId)}`
                            +
                            `&competencyId=${encodeURIComponent(competencyId)}`
                    }
                );

            const data =
                await response.json();

            if (
                !response.ok
                ||
                !data.success
            ) {
                alert(
                    data.message
                    ||
                    "The competency could not be updated."
                );

                return;
            }

            const row =
                document.getElementById(
                    `comp-row-${competencyId}`
                );

            const circle =
                document.getElementById(
                    `comp-circle-${competencyId}`
                );

            const name =
                document.getElementById(
                    `comp-name-${competencyId}`
                );

            const meta =
                document.getElementById(
                    `comp-meta-${competencyId}`
                );

            if (data.isCompleted) {
                circle?.classList.add("done");
                name?.classList.add("done");

                if (row) {
                    row.dataset.status =
                        "completed";
                }

                if (meta) {
                    meta.innerHTML =
                        `<div>${data.completedDate || ""}</div>`
                        +
                        (
                            data.updatedBy
                                ? `<div>by ${escapeCompetencyHtml(data.updatedBy)}</div>`
                                : ""
                        );
                }
            }
            else {
                circle?.classList.remove("done");
                name?.classList.remove("done");

                if (row) {
                    row.dataset.status =
                        "incomplete";
                }

                if (meta) {
                    meta.innerHTML =
                        "<span>Not completed</span>";
                }
            }

            const completed =
                document.getElementById(
                    "comp-total-completed"
                );

            const total =
                document.getElementById(
                    "comp-total-items"
                );

            const percentage =
                document.getElementById(
                    "comp-total-percentage"
                );

            const progress =
                document.getElementById(
                    "comp-total-progress"
                );

            if (completed) {
                completed.textContent =
                    data.totalCompleted;
            }

            if (total) {
                total.textContent =
                    data.totalItems;
            }

            if (percentage) {
                percentage.textContent =
                    data.percentage + "%";
            }

            if (progress) {
                progress.style.width =
                    data.percentage + "%";
            }

            updateCategoryBadge(
                row?.dataset.category
            );

            applyCompetencyFilters();
        }
        catch (error) {
            console.error(
                "Competency toggle error:",
                error
            );

            alert(
                "The competency could not be updated."
            );
        }
    }

    function updateCategoryBadge(categoryKey) {
        if (!categoryKey) {
            return;
        }

        const rows =
            document.querySelectorAll(
                `.comp-item[data-category="${categoryKey}"]`
            );

        let completed =
            0;

        rows.forEach(function (row) {
            if (
                row.dataset.status
                    === "completed"
            ) {
                completed++;
            }
        });

        const total =
            rows.length;

        const percentage =
            total > 0
                ? Math.round(
                    completed
                    / total
                    * 100
                )
                : 0;

        const badge =
            document.getElementById(
                `comp-badge-${categoryKey}`
            );

        if (badge) {
            badge.innerHTML =
                `${completed}/${total}`
                +
                ` &nbsp; ${percentage}%`;
        }
    }

    function escapeCompetencyHtml(value) {
        const div =
            document.createElement("div");

        div.textContent =
            value || "";

        return div.innerHTML;
    }
</script>
