<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Agents Preadmission System - Al-Ahliyya Amman University</title>
    <meta name="description" content="Al-Ahliyya Amman University (AAU) is the first private university in Jordan to be a pioneer of private education providing academic services since 1990. AAU has been accorded institutional and programmatic accreditation and is also a member of the International Association of Universities" />
    <meta name="keywords" content="Al-Ahliyya, Amman, University, Jordan, Education, Teaching, Study, Faculty, Students, eLearning, Admission, Academics, News, Events, Announcements" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="SHORTCUT ICON" type="image/png" href="https://www.ammanu.edu.jo/media/i5ipojym/icon.png" />
    <meta name="robots" content="index,follow">
    <link integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous" type="text/css" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link type="text/css" rel="stylesheet" href="../../css/Site.css" />
    <link type="text/css" rel="stylesheet" href="../../css/RTE.css" />
    <link type="text/css" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link type="text/css" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/3.3.0/animate.css" />
    <link type="text/css" rel="stylesheet" href="../../css/CookieConsent.css" />
    <link type="text/css" rel="stylesheet" href="../../source/jquery.fancybox.css" />
    <link rel="stylesheet" integrity="sha512-tS3S5qG0BlhnQROyJXvNjeEM4UpMXHrQfTGmbQ1gKmelCxlSEBUaxhRBj/EFTzpbP4RVSrpEikbmdJobCvhE3g==" crossorigin="anonymous" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" integrity="sha512-sMXtMNL1zRzolHYKEujM2AqCLUR9F2C4/05cdbxjjLSRvMQIciEPCQZo++nk7go3BtSuK9kfa/s+a4f4i5pLkw==" crossorigin="anonymous" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />
    <script integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous" type="text/javascript" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Owl Carousel -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <!-- SiteSettings -->
    <link rel="stylesheet" href="~/css/RTE.css" />



    <style>
            /* =====================================================
                    USER MANAGEMENT DROPDOWN
                    ===================================================== */

            #Second {
                overflow: visible !important;
                align-items: center;
            }

                #Second .nav-item {
                    position: relative;
                }

                #Second .nav-link,
                #Second .admin-menu-button {
                    white-space: nowrap;
                }

            .admin-menu-dropdown {
                position: relative;
            }

            .admin-menu-button {
                display: flex;
                align-items: center;
                gap: 7px;
                width: 100%;
                border: 0;
                background: transparent;
                color: #ffffff !important;
                padding: .5rem 1rem;
                font-family: inherit;
                font-size: inherit;
                font-weight: inherit;
                line-height: inherit;
                cursor: pointer;
                transition: color .2s ease, background-color .2s ease;
            }

                .admin-menu-button span,
                .admin-menu-button i,
                .admin-menu-button svg,
                .admin-menu-button .admin-menu-chevron {
                    color: #ffffff !important;
                    fill: currentColor;
                }

                .admin-menu-button:hover,
                .admin-menu-button:focus,
                .admin-menu-button.active {
                    color: #ffffff !important;
                    background: rgba(37, 36, 104, .28);
                    outline: none;
                }

                    .admin-menu-button:hover span,
                    .admin-menu-button:hover i,
                    .admin-menu-button:hover svg,
                    .admin-menu-button:hover .admin-menu-chevron,
                    .admin-menu-button:focus span,
                    .admin-menu-button:focus i,
                    .admin-menu-button:focus svg,
                    .admin-menu-button:focus .admin-menu-chevron,
                    .admin-menu-button.active span,
                    .admin-menu-button.active i,
                    .admin-menu-button.active svg,
                    .admin-menu-button.active .admin-menu-chevron {
                        color: #ffffff !important;
                    }

                .admin-menu-button .admin-menu-chevron {
                    font-size: .68rem;
                    transition: transform .2s ease;
                }

                .admin-menu-button.active .admin-menu-chevron {
                    transform: rotate(180deg);
                }

            .admin-menu-list {
                position: absolute;
                top: calc(100% + 7px);
                left: 0;
                z-index: 10050;
                display: none;
                min-width: 235px;
                margin: 0;
                padding: 7px 0;
                list-style: none;
                background: #ffffff;
                border-top: 4px solid #daa328;
                box-shadow: 0 10px 28px rgba(0, 0, 0, .24);
            }

                .admin-menu-list.show {
                    display: block;
                    animation: adminMenuOpen .16s ease-out;
                }

                .admin-menu-list::before {
                    content: "";
                    position: absolute;
                    top: -10px;
                    left: 25px;
                    width: 0;
                    height: 0;
                    border-left: 7px solid transparent;
                    border-right: 7px solid transparent;
                    border-bottom: 7px solid #daa328;
                }

                .admin-menu-list li {
                    width: 100%;
                }

                .admin-menu-list a {
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    width: 100%;
                    padding: 11px 16px;
                    color: #252468 !important;
                    font-size: .88rem;
                    font-weight: 700;
                    text-decoration: none;
                    transition: color .16s ease, background-color .16s ease, padding-left .16s ease;
                }

                    .admin-menu-list a:hover,
                    .admin-menu-list a:focus {
                        color: #ffffff !important;
                        background: rgb(38, 76, 159);
                        padding-left: 20px;
                        outline: none;
                    }

                    .admin-menu-list a i,
                    .admin-menu-list a svg {
                        width: 18px;
                        color: #daa328;
                        text-align: center;
                    }

                    .admin-menu-list a:hover i,
                    .admin-menu-list a:hover svg,
                    .admin-menu-list a:focus i,
                    .admin-menu-list a:focus svg {
                        color: #ffffff;
                    }

            .admin-menu-divider {
                height: 1px;
                margin: 5px 12px;
                background: #ececec;
            }

            @@keyframes adminMenuOpen {
                from {
                    opacity: 0;
                    transform: translateY(-6px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* يقلل ازدحام الهيدر قليلاً على الشاشات الكبيرة */
            @@media (min-width: 1200px) {
                #Second .nav-link,
                #Second .admin-menu-button {
                    padding-left: .72rem;
                    padding-right: .72rem;
                }
            }

            /* داخل قائمة الموبايل تصبح القائمة المنسدلة بعرض كامل */
            @@media (max-width: 1199.98px) {
                .admin-menu-dropdown {
                    width: 100%;
                }

                .admin-menu-button {
                    justify-content: flex-start;
                }

                .admin-menu-list {
                    position: static;
                    width: calc(100% - 20px);
                    min-width: 0;
                    margin: 4px 10px 9px;
                    border-top-width: 3px;
                    box-shadow: none;
                }

                    .admin-menu-list::before {
                        display: none;
                    }

                    .admin-menu-list a {
                        padding-left: 20px;
                    }
            }

    
            /* =====================================================
                       RESPONSIVE FIXES — KEEP ORIGINAL DESIGN
                       ===================================================== */

            html,
            body {
                width: 100%;
                max-width: 100%;
                overflow-x: hidden;
            }

            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            img,
            svg,
            video,
            iframe,
            canvas {
                max-width: 100%;
            }

            main.container {
                width: 100%;
                max-width: 1320px;
                min-width: 0;
            }

                main.container > * {
                    max-width: 100%;
                }

            main input:not([type="checkbox"]):not([type="radio"]),
            main select,
            main textarea {
                max-width: 100%;
            }

            #navbar {
                min-width: 0;
            }

            .layout-table-scroll {
                width: 100%;
                max-width: 100%;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

                .layout-table-scroll > table {
                    margin-bottom: 0;
                }

            #chartHost,
            .table-wrapper,
            .table-responsive-custom,
            .ie-photo-gallery {
                max-width: 100%;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            @@media (max-width: 1199.98px) {

                #opacity {
                    width: 100%;
                    flex-wrap: wrap;
                }

                #logo {
                    display: flex;
                    width: auto;
                    max-width: calc(100% - 78px);
                    height: 82px !important;
                    margin-right: 0;
                    padding: 8px 12px;
                    align-items: center;
                    gap: 8px;
                }

                    #logo img {
                        width: 50px;
                        max-width: 50px !important;
                        margin-top: 0 !important;
                        flex: 0 0 50px;
                    }

                    #logo h1 {
                        min-width: 0;
                        margin: 0;
                    }

                        #logo h1 p {
                            margin: 0;
                            line-height: 1.15;
                        }

                    #logo .heading15 {
                        font-size: .78rem;
                        white-space: nowrap;
                    }

                #langarea {
                    display: none !important;
                }

                .mobbar {
                    display: flex;
                    margin-left: auto;
                    margin-right: 12px;
                    align-items: center;
                }

                .navbar-toggler {
                    border-color: rgba(255, 255, 255, .75);
                    color: #fff;
                }

                    .navbar-toggler:focus {
                        box-shadow: 0 0 0 .2rem rgba(218, 163, 40, .35);
                    }

                #navbar {
                    width: 100%;
                    flex-basis: 100%;
                    max-height: calc(100vh - 82px);
                    overflow-y: auto;
                    overflow-x: hidden;
                }

                #First,
                #Second {
                    width: 100%;
                    align-items: stretch !important;
                }

                    #First .nav-item,
                    #Second .nav-item {
                        width: 100%;
                    }

                    #First .nav-link,
                    #Second .nav-link,
                    #Second .admin-menu-button {
                        display: flex;
                        width: 100%;
                        min-height: 44px;
                        padding: 10px 16px !important;
                        align-items: center;
                        justify-content: flex-start;
                        border-bottom: 1px solid rgba(255, 255, 255, .10);
                    }

                .profilelink {
                    position: static !important;
                    display: flex !important;
                    width: 100%;
                    min-height: 54px;
                    margin: 0 !important;
                    padding: 9px 16px !important;
                    align-items: center;
                    justify-content: flex-start;
                    flex-wrap: wrap;
                    background: #252468;
                    border-top: 1px solid rgba(255, 255, 255, .14);
                }

                .admin-menu-dropdown {
                    width: 100%;
                }

                .admin-menu-button {
                    justify-content: flex-start;
                }

                .admin-menu-list {
                    position: static;
                    width: calc(100% - 20px);
                    min-width: 0;
                    margin: 4px 10px 9px;
                    border-top-width: 3px;
                    box-shadow: none;
                }

                    .admin-menu-list::before {
                        display: none;
                    }

                    .admin-menu-list a {
                        padding-left: 20px;
                    }

                .patient-layout {
                    display: flex !important;
                    flex-direction: column !important;
                    gap: 18px !important;
                }

                    .patient-layout > * {
                        width: 100% !important;
                        max-width: 100% !important;
                        margin-left: 0 !important;
                        margin-right: 0 !important;
                    }

                .side-panel {
                    position: static !important;
                    width: 100% !important;
                }
            }

            @@media (max-width: 767.98px) {

                main.container {
                    margin-top: 14px !important;
                    padding-right: 10px;
                    padding-left: 10px;
                }

                .details-wrapper {
                    width: 100% !important;
                    padding: 10px 0 !important;
                }

                .details-card {
                    display: flex !important;
                    padding: 18px 14px !important;
                    flex-direction: column-reverse !important;
                    gap: 16px !important;
                }

                .details-icon {
                    margin: 0 auto;
                }

                .details-footer {
                    flex-direction: column !important;
                }

                .info-bar {
                    width: 100% !important;
                    padding: 12px !important;
                }

                .patient-alert-grid,
                .summary-grid,
                .toolbar-row {
                    grid-template-columns: 1fr !important;
                }

                .modal-box {
                    width: calc(100% - 20px) !important;
                    max-width: calc(100% - 20px) !important;
                    max-height: 88vh !important;
                    margin: 10px;
                }

                .ie-photo-row,
                .ie-photo-row-3,
                .ie-photo-row-2,
                .ie-photo-row-1 {
                    width: 100% !important;
                    grid-template-columns: 1fr !important;
                    margin-right: 0 !important;
                    margin-left: 0 !important;
                }

                .actions,
                .btnwrap {
                    flex-wrap: wrap !important;
                }

                #chartHost .chart-grid,
                .chart-grid {
                    min-width: 1050px;
                }

                .app {
                    width: 100% !important;
                    max-width: 100% !important;
                }
            }

            @@media (max-width: 575.98px) {

                #logo {
                    height: 72px !important;
                    max-width: calc(100% - 66px);
                    padding: 7px 8px;
                }

                    #logo img {
                        width: 43px;
                        max-width: 43px !important;
                        flex-basis: 43px;
                    }

                    #logo .heading15 {
                        font-size: .68rem;
                    }

                .mobbar {
                    margin-right: 8px;
                }

                .navbar-toggler {
                    padding: .28rem .52rem;
                }

                main.container {
                    padding-right: 7px;
                    padding-left: 7px;
                }

                main h1 {
                    font-size: clamp(1.35rem, 7vw, 1.9rem);
                }

                main h2 {
                    font-size: clamp(1.15rem, 6vw, 1.55rem);
                }
            }

    </style>

</head>
<body>


    <nav id="opacity" class="navbar navbar-expand-xl navbar-dark sticky-top  opacity conatiner-fluid custom
        " style="background: rgb(38, 76, 159); position: relative; opacity: 1; padding-top: 0px; padding-bottom: 0px;
        box-shadow: rgba(37, 36, 104, 0.9) 0px 8px 9px 0px;">

        <a id="logo" class="navbar-brand logo" href="https://www.ammanu.edu.jo/" style="height: 102.5px; background: rgb(218, 163, 40);">
            <img src="../../images/aau-logo.png" style="max-width: 60px; margin-top: 5px;">

            <h1>
                <p style="display:flex"><span class="heading15" style="color: #ffffff;"><strong>Al-Ahliyya Amman</strong></span></p>
                <p style="display:flex"><span class="heading15" style="color: #ffffff;"><strong> University</strong></span></p>
            </h1>

            <div id="vl" class="vl" style="display: none;"></div>
        </a>


        <div id="langarea" class="langarea" style="height: 102.5px; background: rgb(218 163 40);">
            <a style="color: rgb(252, 195, 11); margin-left: 20px; margin-right: 20px; top: 7px;
            " id="lang" class="lang heading17" href="#"></a>
        </div>
        <!-- One of the primary actions on mobile is to call a business - This displays a phone button on mobile only -->
        <div class="navbar-toggler-right mobbar">

            <button class="navbar-toggler " type="button" data-bs-toggle="collapse" data-bs-target="#navbar"
                    aria-controls="navbar" aria-expanded="false" aria-label="Toggle navigation">
                <svg style="font-size: 28px !important;font-weight: 800 !important;"
                     class="svg-inline--fa fa-bars" aria-hidden="true" focusable="false" data-prefix="fas"
                     data-icon="bars" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"
                     data-fa-i2svg="">
                    <path fill="currentColor" d="M0 96C0 78.3 14.3 64 32 64H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 128 0 113.7 0 96zM0 256c0-17.7 14.3-32 32-32H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3-32-32zM448 416c0 17.7-14.3 32-32 32H32c-17.7 0-32-14.3-32-32s14.3-32 32-32H416c17.7 0 32 14.3 32 32z"></path>
                </svg>
                <!-- <i style="font-size: 28px !important;font-weight:800 !important;" class="fa-solid fa-bars"></i> Font Awesome fontawesome.com -->

            </button>
        </div>
        <div class="collapse navbar-collapse flex-column" id="navbar">
            <ul id="First" class="navbar-nav  w-100 justify-content-start" style="background: #252468;">
                <li class="nav-item ">
                    <a asp-controller="Home" asp-action="Index" class="nav-link heading13" style="color: rgb(252, 195, 11); padding-top: 10px; padding-bottom: 0px;">Dental College System<span class="sr-only">(current)</span></a>
                </li>

            </ul>

            <ul id="Second"
                class="navbar-nav justify-content-start w-100"
                style="background: rgb(38, 76, 159);">

                @{
                    var role =
                        Context.Session.GetString("UserRole");
                }

                @* Patients *@
                @if (
                    role == "Admin"
                    ||
                    role == "Fulltime Supervisor"
                    ||
                    role == "Parttime Supervisor"
                    ||
                    role == "Receptionist"
                    ||
                    role == "Student"
                )
                {
                    <li class="nav-item">
                        <a class="nav-link heading15"
                           asp-controller="Home"
                           asp-action="Index">
                            Patients
                        </a>
                    </li>
                }

                @* Appointments *@
                @if (
                    role == "Admin"
                    ||
                    role == "Fulltime Supervisor"
                    ||
                    role == "Parttime Supervisor"
                    ||
                    role == "Receptionist"
                    ||
                    role == "Student"
                )
                {
                    <li class="nav-item">
                        <a class="nav-link heading15"
                           asp-controller="Appointments"
                           asp-action="Index">
                            Appointments
                        </a>
                    </li>
                }

                @* Allocated Students *@
                @if (
                    role == "Admin"
                    ||
                    role == "Fulltime Supervisor"
                    ||
                    role == "Parttime Supervisor"
                )
                {
                    <li class="nav-item">
                        <a class="nav-link heading15"
                           asp-controller="AllocatedStudent"
                           asp-action="Index">
                            AllocatedStudent
                        </a>
                    </li>
                }

                @*
        Competencies

        Admin / Fulltime Supervisor / Parttime Supervisor:
        يشاهدون جميع الطلاب ويستطيعون التعديل.

        Student:
        يشاهد Competencies الخاصة به فقط بدون تعديل.
    *@
                @if (
                    role == "Admin"
                    ||
                    role == "Fulltime Supervisor"
                    ||
                    role == "Parttime Supervisor"
                    ||
                    role == "Student"
                )
                {
                    <li class="nav-item">
                        <a class="nav-link heading15"
                           asp-controller="Competencies"
                           asp-action="Index">
                            Competencies
                        </a>
                    </li>
                }

                @* User Management Dropdown — Admin only *@
                @if (role == "Admin")
                {
                    <li class="nav-item admin-menu-dropdown"
                        id="adminUsersDropdown">

                        <button type="button"
                                class="admin-menu-button heading15"
                                id="adminUsersButton"
                                aria-haspopup="true"
                                aria-expanded="false"
                                onclick="toggleAdminUsersMenu(event)">

                            <i class="fa-solid fa-users-gear"></i>

                            <span>User Management</span>

                            <i class="fa-solid fa-chevron-down admin-menu-chevron"></i>
                        </button>

                        <ul class="admin-menu-list"
                            id="adminUsersMenu"
                            aria-labelledby="adminUsersButton">

                            <li>
                                <a asp-controller="AddNewUsers"
                                   asp-action="AddUser">

                                    <i class="fa-solid fa-user-plus"></i>
                                    <span>Add Users</span>
                                </a>
                            </li>

                            <li>
                                <a asp-controller="SearchNewUsers"
                                   asp-action="SearchUsers">

                                    <i class="fa-solid fa-users-viewfinder"></i>
                                    <span>Search Users</span>
                                </a>
                            </li>

                            <li>
                                <a asp-controller="UserNewTypes"
                                   asp-action="UserTypes">

                                    <i class="fa-solid fa-user-tag"></i>
                                    <span>User Types</span>
                                </a>
                            </li>

                            <li class="admin-menu-divider"
                                aria-hidden="true">
                            </li>

                            @* <li>
                                <a asp-controller="StudentTransfer"
                                   asp-action="Index">

                                    <i class="fa-solid fa-graduation-cap"></i>
                                    <span>Student Transfer</span>
                                </a>
                            </li>
 *@
                        </ul>
                    </li>
                }

                @*
                    Admin Status
                    يظهر لكل من:
                    Admin
                    Fulltime Supervisor
                    Parttime Supervisor
                *@
                @if (
                    role == "Admin"
                    ||
                    role == "Fulltime Supervisor"
                    ||
                    role == "Parttime Supervisor"
                )
                {
                    <li class="nav-item">
                        <a class="nav-link heading15"
                           asp-controller="AdminStatus"
                           asp-action="AdminStatus">
                            Admin Status
                        </a>
                    </li>
                }

                @* Approvals *@
                @if (
                    role == "Admin"
                    ||
                    role == "Fulltime Supervisor"
                    ||
                    role == "Parttime Supervisor"
                )
                {
                    <li class="nav-item">
                        <a class="nav-link heading15"
                           asp-controller="AdminApprovals"
                           asp-action="Index">

                            Approvals

                            @{
                                var pendingCount =
                                    Context.RequestServices
                                        .GetService<
                                            DentalCollegeManagementSystem_AAU.Data.AppDbContext
                                        >();

                                int cnt =
                                    (
                                        pendingCount?
                                            .Visits
                                            .Count(
                                                visit =>
                                                    visit.AdminApprovalStatus
                                                        == "Pending"
                                            )
                                        ?? 0
                                    )
                                    +
                                    (
                                        pendingCount?
                                            .TreatmentProcedures
                                            .Count(
                                                procedure =>
                                                    procedure.AdminApprovalStatus
                                                        == "Pending"
                                            )
                                        ?? 0
                                    )
                                    +
                                    (
                                        pendingCount?
                                            .Orders
                                            .Count(
                                                order =>
                                                    order.AdminApprovalStatus
                                                        == "Pending"
                                            )
                                        ?? 0
                                    );

                                if (cnt > 0)
                                {
                                    <span style="
                                        background:#e53935;
                                        color:#fff;
                                        border-radius:20px;
                                        padding:1px 8px;
                                        font-size:.7rem;
                                        font-weight:700;
                                        margin-left:4px;">
                                        @cnt
                                    </span>
                                }
                            }
                        </a>
                    </li>
                }
            </ul>
        </div>




        @if (Context.Session.GetString("UserRole") != null)
        {
            <div class="profilelink" style="display:flex; align-items:center; gap:10px;">

                @* ✅ أيقونة اليوزر *@
