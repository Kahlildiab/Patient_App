@model DentalCollegeManagementSystem_AAU.Models.Patient

@{
    var exam = ViewBag.IntraoralExam as DentalCollegeManagementSystem_AAU.Models.IntraoralExam;
    var oralHygiene = exam?.OralHygieneStatus.ToString() ?? "Excellent";
    var occlusionClass = exam?.OcclusionClassification?.ToString() ?? "";
    var examId = exam?.IntraoralExamID ?? 0;

    var savedPhotos = ViewBag.IntraoralPhotos as List<DentalCollegeManagementSystem_AAU.Models.IntraoralExamPhoto>
                      ?? new List<DentalCollegeManagementSystem_AAU.Models.IntraoralExamPhoto>();


    var photoSections = new (string Key, string Label, string Icon)[]
    {
        ("right_lateral", "Right in Occlusion", "▶"),
        ("anterior",      "Anterior Occlusion",  "😬"),
        ("left_lateral",  "Left Occlusion",      "◀"),
        ("upper_arch",    "Upper Occlusal",      "⬆️"),
        ("lower_arch",    "Lower Occlusal",      "⬇️"),
        ("other",         "Other",               "📷"),
    };

}


@{
    bool visitClosedForAccess =
        ViewBag.IsVisitClosed != null &&
        (bool)ViewBag.IsVisitClosed;

    string visitRoleForAccess =
        Context.Session.GetString("UserRole") ?? "";

    bool adminCanEditClosedVisit =
        string.Equals(
            visitRoleForAccess,
            "Admin",
            StringComparison.OrdinalIgnoreCase
        );

    bool pageReadOnly =
        visitClosedForAccess &&
        !adminCanEditClosedVisit;
}

<style>
    .ie-section {
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 18px 22px;
        margin-bottom: 14px;
        background: #fff;
    }

    .ie-section-title {
        font-weight: 700;
        font-size: 13px;
        color: #252468;
        margin-bottom: 12px;
    }

    .ie-label {
        font-size: 12px;
        font-weight: 600;
        color: #555;
        margin-bottom: 5px;
        display: block;
    }

    .ie-select, .ie-textarea {
        width: 100%;
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 9px 13px;
        font-size: 13px;
        box-sizing: border-box;
        color: #333;
        outline: none;
        transition: border-color .2s;
        background: #fff;
    }

        .ie-select:focus, .ie-textarea:focus {
            border-color: #252468;
        }

    .ie-textarea {
        resize: vertical;
        min-height: 90px;
    }

    .photo-drop-zone {
        border: 2px dashed #ccc;
        border-radius: 8px;
        padding: 30px 20px;
        text-align: center;
        cursor: pointer;
        transition: border-color .2s, background .2s;
        margin-top: 14px;
    }

        .photo-drop-zone:hover {
            border-color: #252468;
            background: #f8f8ff;
        }

        .photo-drop-zone.drag-over {
            border-color: #252468;
            background: #f0f0ff;
        }

        .photo-drop-zone svg {
            width: 40px;
            height: 40px;
            stroke: #aaa;
            margin-bottom: 8px;
        }

        .photo-drop-zone p {
            font-size: 13px;
            color: #888;
            margin: 0 0 10px;
        }

    .ie-photo-gallery {
        display: flex;
        flex-wrap: nowrap;
        gap: 12px;
        overflow-x: auto;
        padding: 10px 4px 14px;
        scrollbar-width: thin;
        scrollbar-color: #252468 #f0f0f0;
    }

        .ie-photo-gallery::-webkit-scrollbar {
            height: 6px;
        }

        .ie-photo-gallery::-webkit-scrollbar-track {
            background: #f0f0f0;
            border-radius: 3px;
        }

        .ie-photo-gallery::-webkit-scrollbar-thumb {
            background: #252468;
            border-radius: 3px;
        }

    .ie-photo-item {
        position: relative;
        flex-shrink: 0;
        width: 160px;
        height: 160px;
        border-radius: 8px;
        border: 1px solid #ddd;
        overflow: hidden;
        background: #fafafa;
    }

        .ie-photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .ie-photo-item .delete-btn {
            position: absolute;
            top: 4px;
            right: 4px;
            background: rgba(192,57,43,0.85);
            border: none;
            border-radius: 50%;
            width: 26px;
            height: 26px;
            color: white;
            font-size: 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

    .ie-photo-uploading {
        flex-shrink: 0;
        width: 160px;
        height: 160px;
        border-radius: 8px;
        border: 1px dashed #aaa;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        font-size: 13px;
        gap: 6px;
        background: #fafafa;
    }

    /* ── Pyramid rows ─────────────────────────────────────────────────── */
    .ie-photo-row {
        display: grid;
        gap: 16px;
        margin-bottom: 16px;
    }

    .ie-photo-row-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .ie-photo-row-2 {
        grid-template-columns: repeat(2, 1fr);
        width: 66.66%;
        margin-left: auto;
        margin-right: auto;
    }

    .ie-photo-row-1 {
        grid-template-columns: 1fr;
        width: 33.33%;
        margin-left: auto;
        margin-right: auto;
    }
    /* ─────────────────────────────────────────────────────────────────── */

    .ie-photo-section-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 14px;
        background: #fff;
    }

    .ie-photo-section-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
    }

    .ie-photo-section-icon {
        font-size: 16px;
    }

    .ie-photo-section-label {
        font-weight: 700;
        font-size: 13px;
        color: #252468;
        flex: 1;
    }

    .ie-photo-section-count {
        font-size: 11px;
        color: #888;
        background: #f0f0f0;
        padding: 2px 8px;
        border-radius: 10px;
    }

    .dz-btn {
        background: #252468;
        color: #fff;
        border: none;
        border-radius: 4px;
        padding: 6px 16px;
        font-size: 12px;
        cursor: pointer;
    }

        .dz-btn:hover {
            background: #1a1a5e;
        }
</style>
<style>
    #intraoralReadOnlyRoot.closed-visit-readonly input:disabled,
    #intraoralReadOnlyRoot.closed-visit-readonly textarea:disabled,
    #intraoralReadOnlyRoot.closed-visit-readonly select:disabled {
        opacity: 1 !important;
        color: #333 !important;
        background-color: #f7f7f7 !important;
        cursor: default !important;
    }

    #intraoralReadOnlyRoot.closed-visit-readonly input[type="checkbox"]:disabled,
    #intraoralReadOnlyRoot.closed-visit-readonly input[type="radio"]:disabled {
        opacity: 1 !important;
    }

    #intraoralReadOnlyRoot.closed-visit-readonly .readonly-disabled-action {
        opacity: .45 !important;
        cursor: not-allowed !important;
        pointer-events: none !important;
    }

    #intraoralReadOnlyRoot.closed-visit-readonly input[type="file"],
    #intraoralReadOnlyRoot.closed-visit-readonly .photo-drop-zone,
    #intraoralReadOnlyRoot.closed-visit-readonly .ph-upload-zone {
        pointer-events: none !important;
        opacity: .55 !important;
        cursor: not-allowed !important;
    }
</style>

<div id="intraoralReadOnlyRoot" class="@(pageReadOnly ? "closed-visit-readonly" : "")">


    @using (Html.BeginForm("SaveAjax", "IntraoralExams", FormMethod.Post, new { enctype = "multipart/form-data", id = "intraoralExamForm" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="PatientID" value="@Model.PatientID" />
        @if (exam != null)
        {
            <input type="hidden" name="IntraoralExamID" value="@exam.IntraoralExamID" />
        }

        <!-- ─── Intraoral Examination Findings ─── -->
        <div class="ie-section">
            <div class="ie-section-title">Intraoral Examination Findings</div>

            <div style="margin-bottom:16px;">
                <label class="ie-label">Oral Hygiene Status</label>
                <select name="OralHygieneStatus" class="ie-select">
                    <option value="Excellent" selected="@(oralHygiene == "Excellent" ? "selected" : null)">Excellent</option>
                    <option value="Good" selected="@(oralHygiene == "Good" ? "selected" : null)">Good</option>
                    <option value="Fair" selected="@(oralHygiene == "Fair" ? "selected" : null)">Fair</option>
                    <option value="Poor" selected="@(oralHygiene == "Poor" ? "selected" : null)">Poor</option>
                </select>
            </div>

            <div style="margin-bottom:16px;">
                <label class="ie-label">Oral Mucosa</label>
                <textarea name="OralMucosa" class="ie-textarea" placeholder="Describe oral mucosa findings...">@(exam?.OralMucosa ?? "")</textarea>
            </div>

            <div style="margin-bottom:16px;">
                <label class="ie-label">Tongue Examination</label>
                <textarea name="TongueExamination" class="ie-textarea" placeholder="Tongue size, coating, lesions...">@(exam?.TongueExamination ?? "")</textarea>
            </div>

            <div style="margin-bottom:16px;">
                <label class="ie-label">Palate</label>
                <textarea name="Palate" class="ie-textarea" placeholder="Hard and soft palate findings...">@(exam?.Palate ?? "")</textarea>
            </div>

            <div style="margin-bottom:16px;">
                <label class="ie-label">Floor of Mouth</label>
                <textarea name="FloorOfMouth" class="ie-textarea" placeholder="Floor of mouth findings...">@(exam?.FloorOfMouth ?? "")</textarea>
            </div>

            <div style="margin-bottom:16px;">
                <label class="ie-label">Classification of Occlusion</label>
                <select name="OcclusionClassification" class="ie-select">
                    <option value="">-- Select --</option>
                    <option value="ClassI" selected="@(occlusionClass == "ClassI" ? "selected" : null)">Class I</option>
                    <option value="ClassIIDivision1" selected="@(occlusionClass == "ClassIIDivision1" ? "selected" : null)">Class II Division 1</option>
                    <option value="ClassIIDivision2" selected="@(occlusionClass == "ClassIIDivision2" ? "selected" : null)">Class II Division 2</option>
                    <option value="ClassIII" selected="@(occlusionClass == "ClassIII" ? "selected" : null)">Class III</option>
                </select>
            </div>

            <div>
                <label class="ie-label">Other Findings</label>
                <textarea name="OtherFindings" class="ie-textarea" placeholder="Any other relevant intraoral findings...">@(exam?.OtherFindings ?? "")</textarea>
            </div>
        </div>

        <!-- ─── Photo Documentation ─── -->
        <div class="ie-section">
            <div class="ie-section-title">Photo Documentation</div>

            @{
                // Split into pyramid rows
                var row1Keys = new[] { "right_lateral", "anterior", "left_lateral" };
                var row2Keys = new[] { "upper_arch", "lower_arch" };
                var row3Keys = new[] { "other" };

                var rowDefs = new[] {
                (Keys: row1Keys, CssClass: "ie-photo-row-3"),
                (Keys: row2Keys, CssClass: "ie-photo-row-2"),
                (Keys: row3Keys, CssClass: "ie-photo-row-1"),
            };
            }

            @foreach (var rowDef in rowDefs)
            {
                <div class="ie-photo-row @rowDef.CssClass">

                    @foreach (var key in rowDef.Keys)
                    {
                        var photoSec = photoSections.First(s => s.Key == key);
                        var sectionPhotos = savedPhotos.Where(x => x.PhotoSection == photoSec.Key).ToList();

                        <div class="ie-photo-section-card" id="ieCard_@photoSec.Key">

                            <div class="ie-photo-section-header">
                                <span class="ie-photo-section-label">@photoSec.Label</span>
                                <span class="ie-photo-section-count" id="ieCount_@photoSec.Key">
                                    @sectionPhotos.Count photo@(sectionPhotos.Count != 1 ? "s" : "")
                                </span>
                            </div>

                            <div class="ie-photo-gallery" id="iePhotoGallery_@photoSec.Key">
                                @foreach (var p in sectionPhotos)
                                {
                                    <div class="ie-photo-item" id="ieExamPhoto_@p.IntraoralExamPhotoID">
                                        <img src="@p.PhotoPath" alt="@photoSec.Label" />
                                        <button type="button" class="delete-btn"
                                                onclick="deleteIEPhoto(@p.IntraoralExamPhotoID, '@photoSec.Key')"
                                                title="Delete">
                                            ✕
                                        </button>
                                    </div>
                                }
                            </div>

                            <div class="photo-drop-zone"
                                 id="ieDropZone_@photoSec.Key"
                                 onclick="document.getElementById('iePhotoInput_@photoSec.Key').click()">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    <polyline points="17 8 12 3 7 8"
                                              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    <line x1="12" y1="3" x2="12" y2="15"
                                          stroke-width="2" stroke-linecap="round" />
                                </svg>
                                <p>Upload @photoSec.Label</p>
                                <button type="button" class="dz-btn">Choose File</button>
                            </div>

                            <input type="file"
                                   id="iePhotoInput_@photoSec.Key"
                                   accept="image/*"
                                   multiple
                                   style="display:none;"
                                   data-section="@photoSec.Key"
                                   onchange="uploadIEPhotos(this, '@photoSec.Key')" />
                        </div>
                    }

                </div>
            }

        
        </div>

        <div class="btnwrap" style="padding-bottom:50px;display:flex;justify-content:center;">
            <button type="submit" class="mybtn heading13" style="background-color:#DAA328;border-radius:0px 10px 10px;width:200px;border:none;">
                Save
                <span class="line" style="border-right:6px solid #252468;border-bottom:6px solid #252468;right:-4px;bottom:-4px;border-top:none;border-left:none;"></span>
                <span class="areaborder" style="border:0px;"></span>
            </button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div id="ie-success-overlay" style="position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99999;display:flex;align-items:center;justify-content:center;">
            <div style="background:white;border-radius:12px;padding:36px 40px;text-align:center;box-shadow:0 8px 40px rgba(0,0,0,0.25);max-width:360px;width:90%;">
                <div style="font-size:52px;margin-bottom:12px;">✅</div>
                <div style="font-weight:700;font-size:18px;color:#252468;margin-bottom:8px;">Saved Successfully!</div>
                <div style="font-size:13px;color:#555;margin-bottom:24px;">The information has been saved successfully.</div>
                <button onclick="document.getElementById('ie-success-overlay').remove()"
                        style="background:#daa328;color:white;border:none;padding:10px 36px;font-size:14px;font-weight:700;border-radius:0px 10px 10px;cursor:pointer;position:relative;">
                    OK
                    <span style="position:absolute;border-right:4px solid #252468;border-bottom:4px solid #252468;right:-3px;bottom:-3px;width:8px;height:8px;"></span>
                </button>
            </div>
        </div>
        <script>
                setTimeout(() => {
                    const el = document.getElementById('ie-success-overlay');
                    if (el) { el.style.transition = 'opacity 0.4s'; el.style.opacity = '0'; setTimeout(() => el.remove(), 400); }
                }, 4000);
        </script>
    }

    
    <script>
            const IE_FORM_KEY =
                'intraoralExamForm_@Model.PatientID';

            const IE_URLS = {
                save:
                    '@Url.Action("SaveAjax", "IntraoralExams")',

                uploadPhoto:
                    '@Url.Action("UploadPhotoAjax", "IntraoralExams")',

                deletePhoto:
                    '@Url.Action("DeletePhoto", "IntraoralExams")'
            };

            function getIntraoralExamForm() {
                return document.getElementById(
                    'intraoralExamForm'
                );
            }

            function showIEMessage(
                message,
                type
            ) {
                if (
                    typeof window.showToast
                    === 'function'
                ) {
                    window.showToast(
                        message,
                        type
                    );

                    return;
                }

                window.alert(message);
            }

            async function readJsonResponse(
                response
            ) {
                const responseText =
                    await response.text();

                if (!response.ok) {
                    throw new Error(
                        responseText
                        ||
                        `HTTP ${response.status}`
                    );
                }

                if (!responseText) {
                    return {};
                }

                try {
                    return JSON.parse(
                        responseText
                    );
                }
                catch {
                    throw new Error(
                        'The server returned an invalid response.'
                    );
                }
            }

            // ─────────────────────────────────────────────
            // Session Storage
            // ─────────────────────────────────────────────

            function restoreIEFormData() {
                const saved =
                    sessionStorage.getItem(
                        IE_FORM_KEY
                    );

                if (!saved) {
                    return;
                }

                let items;

                try {
                    items = JSON.parse(saved);
                }
                catch {
                    sessionStorage.removeItem(
                        IE_FORM_KEY
                    );

                    return;
                }

                const form =
                    getIntraoralExamForm();

                if (!form) {
                    return;
                }

                items.forEach(
                    function (item) {
                        const elements =
                            form.querySelectorAll(
                                `[name="${CSS.escape(item.name)}"]`
                            );

                        elements.forEach(
                            function (element) {
                                if (
                                    item.type === 'file'
                                ) {
                                    return;
                                }

                                if (
                                    item.type === 'radio'
                                ) {
                                    element.checked =
                                        element.value
                                        === item.value;

                                    return;
                                }

                                if (
                                    item.type === 'checkbox'
                                ) {
                                    element.checked =
                                        item.checked === true;

                                    return;
                                }

                                element.value =
                                    item.value ?? '';
                            }
                        );
                    }
                );
            }

            function saveIEFormData() {
                const form =
                    getIntraoralExamForm();

                if (!form) {
                    return;
                }

                const ignoredNames = [
                    '__RequestVerificationToken',
                    'PatientID',
                    'IntraoralExamID'
                ];

                const data = [];

                form.querySelectorAll(
                    'input, select, textarea'
                )
                    .forEach(
                        function (element) {
                            if (
                                !element.name
                                ||
                                element.type === 'file'
                                ||
                                ignoredNames.includes(
                                    element.name
                                )
                            ) {
                                return;
                            }

                            data.push(
                                {
                                    name:
                                        element.name,

                                    value:
                                        element.value,

                                    type:
                                        element.type,

                                    checked:
                                        element.checked
                                }
                            );
                        }
                    );

                sessionStorage.setItem(
                    IE_FORM_KEY,
                    JSON.stringify(data)
                );
            }

            // ─────────────────────────────────────────────
            // Save Exam
            // ─────────────────────────────────────────────

            async function saveIntraoralExam(
                form
            ) {
                const saveButton =
                    form.querySelector(
                        'button[type="submit"]'
                    );

                const originalHtml =
                    saveButton
                        ? saveButton.innerHTML
                        : '';

                if (saveButton) {
                    saveButton.disabled = true;

                    saveButton.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
                }

                try {
                    const response =
                        await fetch(
                            IE_URLS.save,
                            {
                                method: 'POST',
                                body:
                                    new FormData(form),

                                headers: {
                                    'X-Requested-With':
                                        'XMLHttpRequest'
                                }
                            }
                        );

                    const result =
                        await readJsonResponse(
                            response
                        );

                    if (!result.success) {
                        throw new Error(
                            result.message
                            ||
                            'Error saving the intraoral examination.'
                        );
                    }

                    sessionStorage.removeItem(
                        IE_FORM_KEY
                    );

                    if (result.examId) {
                        setIntraoralExamId(
                            result.examId
                        );
                    }

                    showIEMessage(
                        'Intraoral Exam saved successfully.',
                        'success'
                    );
                }
                catch (error) {
                    console.error(
                        'SaveAjax failed:',
                        error
                    );

                    showIEMessage(
                        error.message
                        ||
                        'Server error while saving.',
                        'error'
                    );
                }
                finally {
                    if (saveButton) {
                        saveButton.disabled = false;

                        saveButton.innerHTML =
                            originalHtml;
                    }
                }
            }

            function setIntraoralExamId(
                examId
            ) {
                const form =
                    getIntraoralExamForm();

                if (!form || !examId) {
                    return;
                }

                let hiddenInput =
                    form.querySelector(
                        '[name="IntraoralExamID"]'
                    );

                if (!hiddenInput) {
                    hiddenInput =
                        document.createElement(
                            'input'
                        );

                    hiddenInput.type =
                        'hidden';

                    hiddenInput.name =
                        'IntraoralExamID';

                    form.appendChild(
                        hiddenInput
                    );
                }

                hiddenInput.value =
                    examId;
            }

            // ─────────────────────────────────────────────
            // Upload Photos
            // ─────────────────────────────────────────────

            async function uploadIEPhotos(
                input,
                sectionKey
            ) {
                if (
                    !input.files
                    ||
                    input.files.length === 0
                ) {
                    return;
                }

                const form =
                    getIntraoralExamForm();

                const token =
                    form
                        ?.querySelector(
                            '[name="__RequestVerificationToken"]'
                        )
                        ?.value
                    ?? '';

                const gallery =
                    document.getElementById(
                        `iePhotoGallery_${sectionKey}`
                    );

                if (!form || !gallery) {
                    return;
                }

                const files =
                    Array.from(
                        input.files
                    );

                input.value = '';

                for (const file of files) {
                    const spinnerId =
                        `ieSpinner_${Date.now()}_${Math.random()
                            .toString(36)
                            .slice(2)}`;

                    const spinner =
                        document.createElement(
                            'div'
                        );

                    spinner.className =
                        'ie-photo-uploading';

                    spinner.id =
                        spinnerId;

                    spinner.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin"></i>'
                        +
                        '<span>Uploading...</span>';

                    gallery.appendChild(
                        spinner
                    );

                    try {
                        const formData =
                            new FormData();

                        formData.append(
                            'patientId',
                            '@Model.PatientID'
                        );

                        const currentExamId =
                            form.querySelector(
                                '[name="IntraoralExamID"]'
                            )
                                ?.value;

                        if (currentExamId) {
                            formData.append(
                                'intraoralExamId',
                                currentExamId
                            );
                        }

                        formData.append(
                            'photo',
                            file
                        );

                        formData.append(
                            'photoSection',
                            sectionKey
                        );

                        formData.append(
                            '__RequestVerificationToken',
                            token
                        );

                        const response =
                            await fetch(
                                IE_URLS.uploadPhoto,
                                {
                                    method: 'POST',
                                    body: formData,
                                    headers: {
                                        'X-Requested-With':
                                            'XMLHttpRequest'
                                    }
                                }
                            );

                        const result =
                            await readJsonResponse(
                                response
                            );

                        if (!result.success) {
                            throw new Error(
                                result.message
                                ||
                                `Failed to upload ${file.name}.`
                            );
                        }

                        if (result.examId) {
                            setIntraoralExamId(
                                result.examId
                            );
                        }

                        addUploadedIEPhoto(
                            gallery,
                            sectionKey,
                            result
                        );

                        updateIESectionCount(
                            sectionKey
                        );

                        if (
                            result.photoPath
                            &&
                            result.photoId
                        ) {
                            syncPhotoToPhotosTab(
                                'ie',
                                sectionKey,
                                result.photoPath,
                                result.photoId
                            );
                        }

                        showIEMessage(
                            'Photo uploaded.',
                            'success'
                        );
                    }
                    catch (error) {
                        console.error(
                            'UploadPhotoAjax failed:',
                            error
                        );

                        showIEMessage(
                            error.message
                            ||
                            `Server error uploading ${file.name}.`,
                            'error'
                        );
                    }
                    finally {
                        document.getElementById(
                            spinnerId
                        )
                            ?.remove();
                    }
                }
            }

            function addUploadedIEPhoto(
                gallery,
                sectionKey,
                result
            ) {
                if (
                    !result.photoId
                    ||
                    !result.photoPath
                ) {
                    return;
                }

                document.getElementById(
                    `ieExamPhoto_${result.photoId}`
                )
                    ?.remove();

                const item =
                    document.createElement(
                        'div'
                    );

                item.className =
                    'ie-photo-item';

                item.id =
                    `ieExamPhoto_${result.photoId}`;

                const image =
                    document.createElement(
                        'img'
                    );

                image.src =
                    result.photoPath;

                image.alt =
                    sectionKey;

                const deleteButton =
                    document.createElement(
                        'button'
                    );

                deleteButton.type =
                    'button';

                deleteButton.className =
                    'delete-btn';

                deleteButton.title =
                    'Delete';

                deleteButton.textContent =
                    '✕';

                deleteButton.addEventListener(
                    'click',
                    function () {
                        deleteIEPhoto(
                            result.photoId,
                            sectionKey
                        );
                    }
                );

                item.appendChild(image);
                item.appendChild(deleteButton);

                gallery.appendChild(item);

                item.scrollIntoView(
                    {
                        behavior: 'smooth',
                        inline: 'end',
                        block: 'nearest'
                    }
                );
            }

            // ─────────────────────────────────────────────
            // Delete Photo
            // ─────────────────────────────────────────────

            async function deleteIEPhoto(
                photoId,
                sectionKey
            ) {
                if (
                    !window.confirm(
                        'Delete this photo?'
                    )
                ) {
                    return;
                }

                const form =
                    getIntraoralExamForm();

                const token =
                    form
                        ?.querySelector(
                            '[name="__RequestVerificationToken"]'
                        )
                        ?.value
                    ?? '';

                try {
                    const body =
                        new URLSearchParams();

                    body.append(
                        'photoId',
                        photoId
                    );

                    body.append(
                        '__RequestVerificationToken',
                        token
                    );

                    const response =
                        await fetch(
                            IE_URLS.deletePhoto,
                            {
                                method: 'POST',
                                headers: {
                                    'Content-Type':
                                        'application/x-www-form-urlencoded;charset=UTF-8',

                                    'X-Requested-With':
                                        'XMLHttpRequest'
                                },
                                body:
                                    body.toString()
                            }
                        );

                    const result =
                        await readJsonResponse(
                            response
                        );

                    if (!result.success) {
                        throw new Error(
                            result.message
                            ||
                            'Error deleting the photo.'
                        );
                    }

                    document.getElementById(
                        `ieExamPhoto_${photoId}`
                    )
                        ?.remove();

                    updateIESectionCount(
                        sectionKey
                    );

                    removePhotoFromPhotosTab(
                        'ie',
                        photoId
                    );

                    showIEMessage(
                        'Photo deleted.',
                        'success'
                    );
                }
                catch (error) {
                    console.error(
                        'DeletePhoto failed:',
                        error
                    );

                    showIEMessage(
                        error.message
                        ||
                        'Server error while deleting.',
                        'error'
                    );
                }
            }

            function updateIESectionCount(
                sectionKey
            ) {
                const gallery =
                    document.getElementById(
                        `iePhotoGallery_${sectionKey}`
                    );

                const countBadge =
                    document.getElementById(
                        `ieCount_${sectionKey}`
                    );

                if (!gallery || !countBadge) {
                    return;
                }

                const count =
                    gallery.querySelectorAll(
                        '.ie-photo-item'
                    )
                        .length;

                countBadge.textContent =
                    `${count} photo${count !== 1 ? 's' : ''}`;
            }

            // ─────────────────────────────────────────────
            // Drag and Drop + Form Events
            // ─────────────────────────────────────────────

            document.addEventListener(
                'DOMContentLoaded',
                function () {
                    const form =
                        getIntraoralExamForm();

                    if (!form) {
                        return;
                    }

                    restoreIEFormData();

                    form.addEventListener(
                        'change',
                        saveIEFormData
                    );

                    form.addEventListener(
                        'input',
                        saveIEFormData
                    );

                    form.addEventListener(
                        'submit',
                        function (event) {
                            event.preventDefault();
                            event.stopPropagation();

                            saveIntraoralExam(
                                form
                            );
                        }
                    );

                    document.querySelectorAll(
                        '[id^="ieDropZone_"]'
                    )
                        .forEach(
                            function (zone) {
                                const sectionKey =
                                    zone.id.replace(
                                        'ieDropZone_',
                                        ''
                                    );

                                zone.addEventListener(
                                    'dragover',
                                    function (event) {
                                        event.preventDefault();

                                        zone.classList.add(
                                            'drag-over'
                                        );
                                    }
                                );

                                zone.addEventListener(
                                    'dragleave',
                                    function () {
                                        zone.classList.remove(
                                            'drag-over'
                                        );
                                    }
                                );

                                zone.addEventListener(
                                    'drop',
                                    function (event) {
                                        event.preventDefault();

                                        zone.classList.remove(
                                            'drag-over'
                                        );

                                        const files =
                                            event.dataTransfer
                                                ?.files;

                                        if (
                                            !files
                                            ||
                                            files.length === 0
                                        ) {
                                            return;
                                        }

                                        const input =
                                            document.getElementById(
                                                `iePhotoInput_${sectionKey}`
                                            );

                                        if (!input) {
                                            return;
                                        }

                                        const transfer =
                                            new DataTransfer();

                                        Array.from(files)
                                            .forEach(
                                                function (file) {
                                                    transfer.items.add(
                                                        file
                                                    );
                                                }
                                            );

                                        input.files =
                                            transfer.files;

                                        uploadIEPhotos(
                                            input,
                                            sectionKey
                                        );
                                    }
                                );
                            }
                        );
                }
            );

            // ─────────────────────────────────────────────
            // Photos Tab Synchronization
            // ─────────────────────────────────────────────

            function syncPhotoToPhotosTab(
                prefix,
                sectionKey,
                photoPath,
                photoId
            ) {
                const map = {
                    galleryId: {
                        ee:
                            'ph_extraoralGallery',

                        ie:
                            'ph_intraoralGallery'
                    },

                    emptyId: {
                        ee:
                            'ph_extraoralEmpty',

                        ie:
                            'ph_intraoralEmpty'
                    },

                    wrapperId: {
                        ee:
                            'ph_extraoralWrapper',

                        ie:
                            'ph_intraoralWrapper'
                    },

                    sourceLabel: {
                        ee:
                            'Extraoral Exam',

                        ie:
                            'Intraoral Exam'
                    }
                };

                const wrapper =
                    document.getElementById(
                        map.wrapperId[prefix]
                    );

                if (!wrapper) {
                    return;
                }

                document.getElementById(
                    map.emptyId[prefix]
                )
                    ?.remove();

                let gallery =
                    document.getElementById(
                        map.galleryId[prefix]
                    );

                if (!gallery) {
                    gallery =
                        document.createElement(
                            'div'
                        );

                    gallery.className =
                        'ph-flat-gallery';

                    gallery.id =
                        map.galleryId[prefix];

                    wrapper.appendChild(
                        gallery
                    );
                }

                const today =
                    new Date()
                        .toLocaleDateString(
                            'en-GB'
                        );

                const labelText =
                    sectionKey
                        .replace(/_/g, ' ')
                        .replace(
                            /\b\w/g,
                            function (letter) {
                                return letter.toUpperCase();
                            }
                        );

                const card =
                    document.createElement(
                        'div'
                    );

                card.className =
                    'ph-photo-card';

                card.id =
                    `ph_${prefix}Photo_${photoId}`;

                card.innerHTML = `
                            <div class="ph-img-wrap">
                                <img src="${escapeIEHtml(photoPath)}"
                                     alt="${escapeIEHtml(labelText)}" />

                                <div class="ph-type-pill">
                                    ${escapeIEHtml(labelText)}
                                </div>

                                <div class="ph-lock-icon">
                                    🔒
                                </div>
                            </div>

                            <div class="ph-photo-info">

                                <div class="ph-info-row">
                                    <span class="ph-info-section-name">
                                        ${escapeIEHtml(labelText)}
                                    </span>
                                </div>

                                <div class="ph-info-divider"></div>

                                <div class="ph-info-row">
                                    <span class="ph-info-date">
                                        ${escapeIEHtml(today)}
                                    </span>
                                </div>

                                <div class="ph-source-tag">
                                    ${escapeIEHtml(map.sourceLabel[prefix])}
                                </div>

                            </div>`;

                gallery.appendChild(
                    card
                );

                refreshIEPhotosLightbox(
                    gallery
                );
            }

            function removePhotoFromPhotosTab(
                prefix,
                photoId
            ) {
                const map = {
                    galleryId: {
                        ee:
                            'ph_extraoralGallery',

                        ie:
                            'ph_intraoralGallery'
                    },

                    emptyId: {
                        ee:
                            'ph_extraoralEmpty',

                        ie:
                            'ph_intraoralEmpty'
                    },

                    wrapperId: {
                        ee:
                            'ph_extraoralWrapper',

                        ie:
                            'ph_intraoralWrapper'
                    }
                };

                document.getElementById(
                    `ph_${prefix}Photo_${photoId}`
                )
                    ?.remove();

                const gallery =
                    document.getElementById(
                        map.galleryId[prefix]
                    );

                if (!gallery) {
                    return;
                }

                const remaining =
                    gallery.querySelectorAll(
                        '.ph-photo-card'
                    )
                        .length;

                if (remaining === 0) {
                    gallery.remove();

                    const wrapper =
                        document.getElementById(
                            map.wrapperId[prefix]
                        );

                    if (
                        wrapper
                        &&
                        !document.getElementById(
                            map.emptyId[prefix]
                        )
                    ) {
                        const emptyMessage =
                            document.createElement(
                                'p'
                            );

                        emptyMessage.className =
                            'ph-empty';

                        emptyMessage.id =
                            map.emptyId[prefix];

                        emptyMessage.textContent =
                            'No intraoral photos yet.';

                        wrapper.appendChild(
                            emptyMessage
                        );
                    }

                    return;
                }

                refreshIEPhotosLightbox(
                    gallery
                );
            }

            function refreshIEPhotosLightbox(
                gallery
            ) {
                if (
                    typeof window.openLightbox
                    !== 'function'
                ) {
                    return;
                }

                const paths =
                    Array.from(
                        gallery.querySelectorAll(
                            '.ph-photo-card img'
                        )
                    )
                        .map(
                            function (image) {
                                return image.getAttribute(
                                    'src'
                                );
                            }
                        )
                        .filter(Boolean);

                gallery.querySelectorAll(
                    '.ph-photo-card'
                )
                    .forEach(
                        function (card) {
                            const imagePath =
                                card.querySelector(
                                    'img'
                                )
                                    ?.getAttribute(
                                        'src'
                                    );

                            const caption =
                                card.querySelector(
                                    '.ph-info-section-name'
                                )
                                    ?.textContent
                                    ?.trim()
                                ?? '';

                            const date =
                                card.querySelector(
                                    '.ph-info-date'
                                )
                                    ?.textContent
                                    ?.trim()
                                ?? '';

                            if (!imagePath) {
                                return;
                            }

                            card.onclick =
                                function () {
                                    window.openLightbox(
                                        imagePath,
                                        paths,
                                        `${caption} · ${date}`
                                    );
                                };
                        }
                    );
            }

            function escapeIEHtml(
                value
            ) {
                const element =
                    document.createElement(
                        'div'
                    );

                element.textContent =
                    value ?? '';

                return element.innerHTML;
            }
    </script>


    <script>
            (function () {
                document.addEventListener("DOMContentLoaded", function () {

                    const pageReadOnly =
                                    @pageReadOnly.ToString().ToLower();

                    const root =
                        document.getElementById("intraoralReadOnlyRoot");

                    if (!pageReadOnly || !root) {
                        return;
                    }

                    root.classList.add("closed-visit-readonly");

                    root.querySelectorAll(
                        "input:not([type='hidden']), textarea, select"
                    ).forEach(function (element) {
                        element.disabled = true;
                    });

                    root.querySelectorAll(
                        "[contenteditable='true']"
                    ).forEach(function (element) {
                        element.setAttribute("contenteditable", "false");
                    });

                    function isViewOnlyButton(button) {
                        const text =
                            (button.textContent || "")
                                .replace(/\s+/g, " ")
                                .trim()
                                .toLowerCase();

                        return button.matches(
                            ".btn-close, [data-bs-dismiss='modal'], [data-readonly-allow='true']"
                        )
                            || text === "details"
                            || text === "view"
                            || text.startsWith("view ")
                            || text.includes("preview")
                            || text === "close"
                            || text === "×"
                            || text === "✕";
                    }

                    root.querySelectorAll(
                        "button, input[type='button'], input[type='submit']"
                    ).forEach(function (button) {

                        if (isViewOnlyButton(button)) {
                            return;
                        }

                        button.disabled = true;
                        button.setAttribute("aria-disabled", "true");
                        button.classList.add("readonly-disabled-action");
                    });

                    root.querySelectorAll(
                        ".photo-drop-zone, .ph-upload-zone, input[type='file']"
                    ).forEach(function (element) {
                        element.classList.add("readonly-disabled-action");
                    });

                    root.querySelectorAll("form").forEach(function (form) {
                        form.addEventListener(
                            "submit",
                            function (event) {
                                event.preventDefault();
                                event.stopImmediatePropagation();
                            },
                            true
                        );
                    });

                    root.addEventListener(
                        "click",
                        function (event) {

                            const blocked =
                                event.target.closest(
                                    ".readonly-disabled-action"
                                );

                            if (!blocked) {
                                return;
                            }

                            event.preventDefault();
                            event.stopImmediatePropagation();
                        },
                        true
                    );

                    ["dragover", "drop"].forEach(function (eventName) {
                        root.addEventListener(
                            eventName,
                            function (event) {
                                if (
                                    event.target.closest(
                                        ".photo-drop-zone, .ph-upload-zone"
                                    )
                                ) {
                                    event.preventDefault();
                                    event.stopImmediatePropagation();
                                }
                            },
                            true
                        );
                    });
                });
            })();
    </script>

</div>
