@model DentalCollegeManagementSystem_AAU.Models.Patient
@using DentalCollegeManagementSystem_AAU.Models

@{
    var visits =
        ViewBag.Visits as List<Visit>
        ?? new List<Visit>();

    string userRole =
        Context.Session.GetString("UserRole")
        ?? string.Empty;

    bool isStudent =
        string.Equals(
            userRole,
            "Student",
            StringComparison.OrdinalIgnoreCase
        );

    bool canApproveVisit =
        string.Equals(
            userRole,
            "Admin",
            StringComparison.OrdinalIgnoreCase
        )
        ||
        string.Equals(
            userRole,
            "Fulltime Supervisor",
            StringComparison.OrdinalIgnoreCase
        )
        ||
        string.Equals(
            userRole,
            "Parttime Supervisor",
            StringComparison.OrdinalIgnoreCase
        );

    bool visitClosedForAccess =
        ViewBag.IsVisitClosed != null
        &&
        (bool)ViewBag.IsVisitClosed;

    bool adminCanEditClosedVisit =
        string.Equals(
            userRole,
            "Admin",
            StringComparison.OrdinalIgnoreCase
        );

    bool pageReadOnly =
        visitClosedForAccess
        &&
        !adminCanEditClosedVisit;
}

@if (TempData["VisitError"] != null)
{
    <div class="alert alert-warning">
        @TempData["VisitError"]
    </div>
}

@if (TempData["VisitSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["VisitSuccess"]
    </div>
}

<style>
    :root {
        --vt-navy: #1a237e;
        --vt-navy-mid: #283593;
        --vt-blue: #1565c0;
        --vt-border: #d0d7e3;
        --vt-label: #78909c;
        --vt-success: #2e7d32;
        --vt-success-bg: #e8f5e9;
        --vt-warning: #e65100;
        --vt-warning-bg: #fff8e1;
    }

    .vt-add-btn {
        background: var(--vt-navy);
        color: #fff;
        border: none;
        border-radius: 0;
        padding: 10px 28px;
        font-size: .95rem;
        font-weight: 700;
        letter-spacing: .3px;
        cursor: pointer;
        transition: background .15s;
    }

        .vt-add-btn:hover {
            background: var(--vt-navy-mid);
        }

    .vt-section {
        background: #fff;
        border: 1.5px solid var(--vt-border);
        border-radius: 10px;
        padding: 22px 24px 18px;
        margin-bottom: 20px;
    }

    .vt-label {
        display: block;
        margin-bottom: 5px;
        color: var(--vt-label);
        font-size: .82rem;
        font-weight: 500;
    }

    .vt-input {
        width: 100%;
        border: 1px solid var(--vt-border);
        border-radius: 6px;
        padding: 9px 13px;
        box-sizing: border-box;
        background: #fff;
        color: #333;
        font-size: .88rem;
        outline: none;
        transition: border-color .2s;
    }

        .vt-input:focus {
            border-color: var(--vt-navy);
        }

    .vt-input-readonly {
        width: 100%;
        border: 1px solid var(--vt-border);
        border-radius: 6px;
        padding: 9px 13px;
        box-sizing: border-box;
        background: #f5f5f5;
        color: #888;
        cursor: not-allowed;
        font-size: .88rem;
    }

    .vt-textarea {
        width: 100%;
        min-height: 80px;
        border: 1px solid var(--vt-border);
        border-radius: 6px;
        padding: 9px 13px;
        box-sizing: border-box;
        resize: vertical;
        background: #fff;
        color: #333;
        font-size: .88rem;
        outline: none;
        transition: border-color .2s;
    }

        .vt-textarea:focus {
            border-color: var(--vt-navy);
        }

    .vt-past-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }

    .vt-past-date {
        color: var(--vt-navy);
        font-size: .88rem;
        font-weight: 700;
    }

    .vt-period-badge {
        display: inline-block;
        margin-left: 8px;
        border-radius: 4px;
        padding: 1px 8px;
        background: #e8eaf6;
        color: #3949ab;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .vt-approved-badge,
    .vt-pending-badge {
        display: inline-block;
        border-radius: 20px;
        padding: 3px 13px;
        font-size: .75rem;
        font-weight: 700;
    }

    .vt-approved-badge {
        border: 1px solid #a5d6a7;
        background: var(--vt-success-bg);
        color: var(--vt-success);
    }

    .vt-pending-badge {
        border: 1px solid #ffe082;
        background: var(--vt-warning-bg);
        color: var(--vt-warning);
    }

    .vt-approval-banner {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        border: 1px solid #a5d6a7;
        border-radius: 8px;
        padding: 12px 16px;
        background: var(--vt-success-bg);
        color: var(--vt-success);
        font-size: .85rem;
        font-weight: 600;
    }

    .vt-approval-pending {
        border-color: #ffe082;
        background: var(--vt-warning-bg);
        color: var(--vt-warning);
    }

    .vt-approval-form {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .vt-approval-comments {
        flex: 1;
        min-width: 230px;
    }

    .vt-past-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
        margin-bottom: 5px;
    }

    .vt-past-col {
        flex: 1 1 50%;
        min-width: 200px;
    }

    .vt-plabel {
        color: var(--vt-label);
        font-size: .78rem;
    }

    .vt-pval {
        color: var(--vt-navy-mid);
        font-size: .85rem;
        font-weight: 600;
    }

    .vt-action-bar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 16px;
        padding-top: 12px;
        border-top: 1px solid var(--vt-border);
    }

    .vt-edit-btn,
    .vt-del-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 0;
        border-radius: 6px;
        padding: 5px 14px;
        background: #fff;
        font-size: .78rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s, color .15s;
    }

    .vt-edit-btn {
        color: var(--vt-navy);
    }

        .vt-edit-btn:hover {
            background: #e8eaf6;
        }

    .vt-del-btn {
        color: #e53935;
    }

        .vt-del-btn:hover {
            background: #ffebee;
            color: #c62828;
        }

    .vt-del-icon {
        width: 14px;
        height: 14px;
    }

    .vt-approve-btn {
        border: none;
        border-radius: 5px;
        padding: 8px 18px;
        background: var(--vt-success);
        color: #fff;
        font-size: .8rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s;
    }

        .vt-approve-btn:hover {
            background: #1b5e20;
        }

    .vt-attend-btn {
        border: none;
        border-radius: 20px;
        padding: 3px 14px;
        font-size: .75rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s, color .15s;
    }

        .vt-attend-btn.not-attended {
            border: 1px solid #d0d7e3;
            background: #f3f4f6;
            color: #555;
        }

            .vt-attend-btn.not-attended:hover {
                border-color: #a5d6a7;
                background: var(--vt-success-bg);
                color: var(--vt-success);
            }

        .vt-attend-btn.attended {
            border: 1px solid #a5d6a7;
            background: var(--vt-success-bg);
            color: var(--vt-success);
        }

    .vt-details-btn {
        position: relative;
        display: inline-block;
        border: none;
        border-radius: 0 0 7px 0;
        padding: 4px 16px;
        background: var(--vt-navy);
        color: #fff !important;
        font-size: .78rem;
        font-weight: 700;
        text-decoration: none !important;
        cursor: pointer;
        transition: background .15s;
    }

        .vt-details-btn:hover {
            background: var(--vt-navy-mid);
        }

        .vt-details-btn::after {
            content: "";
            position: absolute;
            right: -3px;
            bottom: -3px;
            width: 7px;
            height: 7px;
            border-right: 3px solid #daa328;
            border-bottom: 3px solid #daa328;
        }

    .vt-section-title {
        margin-bottom: 14px;
        color: var(--vt-navy);
        font-size: .95rem;
        font-weight: 700;
    }

    .vt-cancel-btn {
        border: 1px solid var(--vt-border);
        border-radius: 6px;
        padding: 9px 20px;
        background: #fff;
        color: #555;
        font-size: .88rem;
        font-weight: 500;
        cursor: pointer;
    }

    .vt-modal-save-btn {
        position: relative;
        border: none;
        border-radius: 0 8px 8px;
        padding: 9px 28px;
        background: #daa328;
        color: #fff;
        font-size: .88rem;
        font-weight: 700;
        cursor: pointer;
    }

        .vt-modal-save-btn::after {
            content: "";
            position: absolute;
            right: -3px;
            bottom: -3px;
            width: 8px;
            height: 8px;
            border-right: 4px solid #252468;
            border-bottom: 4px solid #252468;
        }

    .vt-locked {
        opacity: .68;
    }

        .vt-locked .vt-action-bar,
        .vt-locked .vt-attend-btn,
        .vt-locked .vt-details-btn {
            pointer-events: none;
        }

    #visitsReadOnlyRoot.closed-visit-readonly input:disabled,
    #visitsReadOnlyRoot.closed-visit-readonly textarea:disabled,
    #visitsReadOnlyRoot.closed-visit-readonly select:disabled {
        opacity: 1 !important;
        background-color: #f7f7f7 !important;
        color: #333 !important;
        cursor: default !important;
    }

    #visitsReadOnlyRoot.closed-visit-readonly
    input[type="checkbox"]:disabled,
    #visitsReadOnlyRoot.closed-visit-readonly
    input[type="radio"]:disabled {
        opacity: 1 !important;
    }

    #visitsReadOnlyRoot.closed-visit-readonly
    .readonly-disabled-action {
        opacity: .45 !important;
        pointer-events: none !important;
        cursor: not-allowed !important;
    }
</style>

<div id="visitsReadOnlyRoot"
     class="@(pageReadOnly ? "closed-visit-readonly" : "")">

    <div class="vt-container">

        @if (!pageReadOnly)
        {
            <div class="d-flex justify-content-end mb-3">
                <button type="button"
                        class="vt-add-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#addVisitModal">
                    + Add Visit
                </button>
            </div>
        }

        @if (!visits.Any())
        {
            <div class="vt-section">
                <p style="color:var(--vt-label);font-size:.85rem;margin:0;">
                    No visits recorded yet.
                </p>
            </div>
        }
        else
        {
            foreach (
                var v in
                visits.OrderByDescending(
                    item => item.VisitDate
                )
            )
            {
                bool isVisitApproved =
                    v.IsApproved;

                bool isPendingApproval =
                    !isVisitApproved;

                bool lockStudentCard =
                    isStudent
                    &&
                    isPendingApproval;

                <div class="vt-section @(lockStudentCard ? "vt-locked" : "")">

                    <div class="vt-past-header">
                        <span class="vt-past-date">
                            📅 @v.VisitDate.ToString("dd / MM / yyyy")

                            @if (
                                !string.IsNullOrWhiteSpace(
                                    v.AppointmentPeriod
                                )
                            )
                            {
                                <span class="vt-period-badge">
                                    @v.AppointmentPeriod
                                </span>
                            }
                        </span>

                        <div class="d-flex align-items-center gap-2 flex-wrap">

                            @if (isVisitApproved)
                            {
                                <span class="vt-approved-badge">
                                    ✓ Visit Approved
                                </span>
                            }
                            else
                            {
                                <span class="vt-pending-badge">
                                    ⏳ Approval Pending
                                </span>
                            }

                            @if (isVisitApproved)
                            {
                                @if (!v.Attended)
                                {
                                    <button type="button"
                                            class="vt-attend-btn not-attended"
                                            data-bs-toggle="modal"
                                            data-bs-target="#addDetailsModal-@v.VisitID">
                                        Mark Attended
                                    </button>
                                }
                                else
                                {
                                    <span class="vt-attend-btn attended"
                                          style="cursor:default;">
                                        ✓ Attended
                                    </span>

                                    <button type="button"
                                            class="vt-details-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#addDetailsModal-@v.VisitID">
                                        Add Details
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    @if (isPendingApproval)
                    {
                        <div class="vt-approval-banner vt-approval-pending"
                             style="justify-content:space-between; flex-wrap:wrap;">
                            <span>
                                ⚠️ This visit must be approved from the
                                Pending Approvals page by the responsible authority.
                            </span>

                            @if (canApproveVisit)
                            {
                                <a asp-controller="AdminApprovals"
                                   asp-action="Index"
                                   class="vt-approve-btn"
                                   style="text-decoration:none;">
                                    Open Pending Approvals
                                </a>
                            }
                        </div>
                    }

                    @if (!isStudent || isVisitApproved)
                    {
                        @if (
                            !string.IsNullOrWhiteSpace(
                                v.ChiefComplaint
                            )
                        )
                        {
                            <div class="mb-2">
                                <span class="vt-plabel">
                                    Chief Complaint:
                                </span>

                                <span class="vt-pval">
                                    @v.ChiefComplaint
                                </span>
                            </div>
                        }

                        <div class="vt-past-row">
                            @if (
                                !string.IsNullOrWhiteSpace(
                                    v.ProceduresPerformed
                                )
                            )
                            {
                                <div class="vt-past-col mb-2">
                                    <span class="vt-plabel">
                                        Procedures Performed:
                                    </span>

                                    <span class="vt-pval">
                                        @v.ProceduresPerformed
                                    </span>
                                </div>
                            }

                            @if (
                                !string.IsNullOrWhiteSpace(
                                    v.MaterialsUsed
                                )
                            )
                            {
                                <div class="vt-past-col mb-2">
                                    <span class="vt-plabel">
                                        Materials Used:
                                    </span>

                                    <span class="vt-pval">
                                        @v.MaterialsUsed
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="vt-past-row">
                            @if (
                                !string.IsNullOrWhiteSpace(
                                    v.Complications
                                )
                            )
                            {
                                <div class="vt-past-col mb-2">
                                    <span class="vt-plabel">
                                        Complications / Issues:
                                    </span>

                                    <span class="vt-pval">
                                        @v.Complications
                                    </span>
                                </div>
                            }

                            @if (
                                !string.IsNullOrWhiteSpace(
                                    v.StudentNotes
                                )
                            )
                            {
                                <div class="vt-past-col mb-2">
                                    <span class="vt-plabel">
                                        Student Notes:
                                    </span>

                                    <span class="vt-pval">
                                        @v.StudentNotes
                                    </span>
                                </div>
                            }
                        </div>

                        @if (isVisitApproved)
                        {
                            <div class="vt-approval-banner mt-2">
                                ✅ Approved by
                                <strong>
                                    @(string.IsNullOrWhiteSpace(v.ApprovedBy)
                                        ? "Responsible Authority"
                                        : v.ApprovedBy)
                                </strong>

                                @if (v.ApprovedDate.HasValue)
                                {
                                    <span>
                                        on
                                        @v.ApprovedDate.Value
                                        .ToString("dd-MM-yyyy")
                                    </span>
                                }

                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        v.SupervisorComments
                                    )
                                )
                                {
                                    <span>
                                        — "@v.SupervisorComments"
                                    </span>
                                }
                            </div>
                        }

                        @if (!pageReadOnly)
                        {
                            <div class="vt-action-bar">

                                <button type="button"
                                        class="vt-edit-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editVisitModal-@v.VisitID">

                                    <svg width="13"
                                         height="13"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2.5"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                    </svg>

                                    Edit
                                </button>

                                <form asp-controller="Visits"
                                      asp-action="Delete"
                                      method="post"
                                      class="m-0 p-0 d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="visitId"
                                           value="@v.VisitID" />

                                    <input type="hidden"
                                           name="patientId"
                                           value="@Model.PatientID" />

                                    <button type="submit"
                                            class="vt-del-btn"
                                            onclick="return confirm('Delete this visit?')">

                                        <svg class="vt-del-icon"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14H6L5 6" />
                                            <path d="M10 11v6M14 11v6" />
                                            <path d="M9 6V4h6v2" />
                                        </svg>

                                        Delete
                                    </button>
                                </form>
                            </div>
                        }
                    }
                </div>

                @if (
                    !pageReadOnly
                    &&
                    (
                        isVisitApproved
                        ||
                        canApproveVisit
                    )
                )
                {
                    <!-- ===== ADD DETAILS MODAL ===== -->
                    <div class="modal fade"
                         id="addDetailsModal-@v.VisitID"
                         tabindex="-1">

                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">

                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold"
                                        style="color:#1a237e;">
                                        Add Visit Details
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal">
                                    </button>
                                </div>

                                <form asp-controller="Visits"
                                      asp-action="SaveDetails"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="VisitID"
                                           value="@v.VisitID" />

                                    <input type="hidden"
                                           name="PatientID"
                                           value="@Model.PatientID" />

                                    <input type="hidden"
                                           name="VisitDate"
                                           value="@v.VisitDate.ToString("yyyy-MM-dd")" />

                                    <div class="modal-body">

                                        <div class="vt-section mb-3">
                                            <div style="
                                                display:flex;
                                                align-items:center;
                                                gap:12px;
                                                border:1px solid #c5cae9;
                                                border-radius:8px;
                                                padding:12px 16px;
                                                background:#f0f4ff;">

                                                <input type="checkbox"
                                                       name="Attended"
                                                       value="true"
                                                       id="attendedCheck-@v.VisitID"
                                                @(v.Attended ? "checked" : "")
                                                       style="
                                                width:18px;
                                                height:18px;
                                                accent-color:#1a237e;
                                                cursor:pointer;"
                                                       onclick="handleAttendedCheck(this)" />

                                                <label for="attendedCheck-@v.VisitID"
                                                       style="
                                                    margin:0;
                                                    color:#1a237e;
                                                    font-size:.9rem;
                                                    font-weight:700;
                                                    cursor:pointer;">
                                                    ✓ Patient Attended this visit
                                                </label>
                                            </div>
                                        </div>

                                        <div class="vt-section mb-3">
                                            <p class="vt-section-title">
                                                Visit Details
                                            </p>

                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <label class="vt-label">
                                                        Chief Complaint
                                                    </label>

                                                    <textarea name="ChiefComplaint"
                                                              class="vt-textarea"
                                                              placeholder="Patient's main concern...">@v.ChiefComplaint</textarea>
                                                </div>

                                                <div class="col-12">
                                                    <label class="vt-label">
                                                        Procedures Performed
                                                    </label>

                                                    <textarea name="ProceduresPerformed"
                                                              class="vt-textarea"
                                                              placeholder="List all procedures...">@v.ProceduresPerformed</textarea>
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="vt-label">
                                                        Materials Used
                                                    </label>

                                                    <textarea name="MaterialsUsed"
                                                              class="vt-textarea"
                                                              placeholder="Materials and equipment...">@v.MaterialsUsed</textarea>
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="vt-label">
                                                        Complications / Issues
                                                    </label>

                                                    <textarea name="Complications"
                                                              class="vt-textarea"
                                                              placeholder="Any complications...">@v.Complications</textarea>
                                                </div>

                                                <div class="col-12">
                                                    <label class="vt-label">
                                                        Student Notes
                                                    </label>

                                                    <textarea name="StudentNotes"
                                                              class="vt-textarea"
                                                              placeholder="Additional notes...">@v.StudentNotes</textarea>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="vt-section">
                                            <p class="vt-section-title">
                                                Visit Approval
                                            </p>

                                            @if (isVisitApproved)
                                            {
                                                <div class="vt-approval-banner">
                                                    ✅ Approved by
                                                    <strong>
                                                        @(string.IsNullOrWhiteSpace(v.ApprovedBy)
                                                            ? "Responsible Authority"
                                                            : v.ApprovedBy)
                                                    </strong>

                                                    @if (v.ApprovedDate.HasValue)
                                                    {
                                                        <span>
                                                            on
                                                            @v.ApprovedDate.Value
                                                            .ToString("dd-MM-yyyy")
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="vt-approval-banner vt-approval-pending">
                                                    ⚠️ This visit must be approved by the responsible authority.
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="modal-footer">
                                        <button type="button"
                                                class="vt-cancel-btn"
                                                data-bs-dismiss="modal">
                                            Cancel
                                        </button>

                                        <button type="submit"
                                                class="vt-modal-save-btn">
                                            Save Details
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- ===== EDIT VISIT MODAL ===== -->
                    <div class="modal fade"
                         id="editVisitModal-@v.VisitID"
                         tabindex="-1">

                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">

                                <div class="modal-header"
                                     style="background:#1a237e;">

                                    <h5 class="modal-title fw-bold text-white">
                                        ✏️ Edit Visit —
                                        @v.VisitDate.ToString("dd / MM / yyyy")

                                        @if (
                                            !string.IsNullOrWhiteSpace(
                                                v.AppointmentPeriod
                                            )
                                        )
                                        {
                                            <span style="
                                                margin-left:8px;
                                                border-radius:4px;
                                                padding:1px 8px;
                                                background:#e8eaf6;
                                                color:#3949ab;
                                                font-size:.72rem;
                                                font-weight:700;">
                                                @v.AppointmentPeriod
                                            </span>
                                        }
                                    </h5>

                                    <button type="button"
                                            class="btn-close btn-close-white"
                                            data-bs-dismiss="modal">
                                    </button>
                                </div>

                                <form asp-controller="Visits"
                                      asp-action="SaveDetails"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="VisitID"
                                           value="@v.VisitID" />

                                    <input type="hidden"
                                           name="PatientID"
                                           value="@Model.PatientID" />

                                    <input type="hidden"
                                           name="VisitDate"
                                           value="@v.VisitDate.ToString("yyyy-MM-dd")" />

                                    <input type="hidden"
                                           name="Attended"
                                           value="@(v.Attended ? "true" : "false")" />

                                    <div class="modal-body">

                                        <div class="vt-section mb-3">
                                            <p class="vt-section-title">
                                                Visit Info
                                            </p>

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="vt-label">
                                                        Date
                                                    </label>

                                                    <div class="vt-input-readonly">
                                                        📅 @v.VisitDate.ToString("dd / MM / yyyy")
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="vt-label">
                                                        Period
                                                    </label>

                                                    <div class="vt-input-readonly">
                                                        @(string.IsNullOrWhiteSpace(v.AppointmentPeriod)
                                                            ? "—"
                                                            : v.AppointmentPeriod)
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="vt-section mb-3">
                                            <p class="vt-section-title">
                                                Visit Details
                                            </p>

                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <label class="vt-label">
                                                        Chief Complaint
                                                    </label>

                                                    <textarea name="ChiefComplaint"
                                                              class="vt-textarea">@v.ChiefComplaint</textarea>
                                                </div>

                                                <div class="col-12">
                                                    <label class="vt-label">
                                                        Procedures Performed
                                                    </label>

                                                    <textarea name="ProceduresPerformed"
                                                              class="vt-textarea">@v.ProceduresPerformed</textarea>
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="vt-label">
                                                        Materials Used
                                                    </label>

                                                    <textarea name="MaterialsUsed"
                                                              class="vt-textarea">@v.MaterialsUsed</textarea>
                                                </div>

                                                <div class="col-md-6">
                                                    <label class="vt-label">
                                                        Complications / Issues
                                                    </label>

                                                    <textarea name="Complications"
                                                              class="vt-textarea">@v.Complications</textarea>
                                                </div>

                                                <div class="col-12">
                                                    <label class="vt-label">
                                                        Student Notes
                                                    </label>

                                                    <textarea name="StudentNotes"
                                                              class="vt-textarea">@v.StudentNotes</textarea>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="vt-section">
                                            <p class="vt-section-title">
                                                Visit Approval
                                            </p>

                                            @if (isVisitApproved)
                                            {
                                                <div class="vt-approval-banner">
                                                    ✅ Approved by
                                                    <strong>
                                                        @(string.IsNullOrWhiteSpace(v.ApprovedBy)
                                                            ? "Responsible Authority"
                                                            : v.ApprovedBy)
                                                    </strong>

                                                    @if (v.ApprovedDate.HasValue)
                                                    {
                                                        <span>
                                                            on
                                                            @v.ApprovedDate.Value
                                                            .ToString("dd-MM-yyyy")
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="vt-approval-banner vt-approval-pending">
                                                    ⚠️ This visit must be approved by the responsible authority.
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="modal-footer">
                                        <button type="button"
                                                class="vt-cancel-btn"
                                                data-bs-dismiss="modal">
                                            Cancel
                                        </button>

                                        <button type="submit"
                                                class="vt-modal-save-btn">
                                            Save Changes
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>

    @if (!pageReadOnly)
    {
        <!-- ===== ADD VISIT MODAL ===== -->
        <div class="modal fade"
             id="addVisitModal"
             tabindex="-1">

            <div class="modal-dialog modal-sm">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title fw-bold"
                            style="color:#1a237e;">
                            Add New Visit
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                    </div>

                    <form asp-controller="Visits"
                          asp-action="Save"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="PatientID"
                               value="@Model.PatientID" />

                        <div class="modal-body">

                            <div class="mb-4">
                                <label class="vt-label"
                                       style="
                                    color:#555;
                                    font-size:.88rem;
                                    font-weight:600;">
                                    Date
                                </label>

                                <input type="date"
                                       name="VisitDate"
                                       class="vt-input"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       required />
                            </div>

                            <div class="mb-2">
                                <label class="vt-label"
                                       style="
                                    color:#555;
                                    font-size:.88rem;
                                    font-weight:600;">
                                    AM / PM
                                </label>

                                <div style="
                                    display:flex;
                                    align-items:center;
                                    gap:32px;
                                    padding:8px 4px;">

                                    <label style="
                                        display:flex;
                                        align-items:center;
                                        gap:8px;
                                        color:#333;
                                        font-size:.92rem;
                                        font-weight:500;
                                        cursor:pointer;">

                                        <input type="radio"
                                               name="AppointmentPeriod"
                                               value="AM"
                                               checked
                                               style="
                                        width:16px;
                                        height:16px;
                                        accent-color:#1a237e;" />

                                        AM
                                    </label>

                                    <label style="
                                        display:flex;
                                        align-items:center;
                                        gap:8px;
                                        color:#333;
                                        font-size:.92rem;
                                        font-weight:500;
                                        cursor:pointer;">

                                        <input type="radio"
                                               name="AppointmentPeriod"
                                               value="PM"
                                               style="
                                        width:16px;
                                        height:16px;
                                        accent-color:#1a237e;" />

                                        PM
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="vt-cancel-btn"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="vt-modal-save-btn">
                                Save Visit
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <script>
            function handleAttendedCheck(checkbox) {
                if (!checkbox.checked) {
                    checkbox.checked = true;

                    const existingMessage =
                        document.getElementById(
                            "attended-warning-" + checkbox.id
                        );

                    if (!existingMessage) {
                        const message =
                            document.createElement("div");

                        message.id =
                            "attended-warning-" + checkbox.id;

                        message.style.cssText = `
                            margin-top:6px;
                            padding:8px 12px;
                            background:#fff3e0;
                            border:1px solid #ffb74d;
                            border-radius:6px;
                            color:#e65100;
                            font-size:.82rem;
                            font-weight:600;
                        `;

                        message.innerHTML =
                            "⚠️ Cannot unmark attendance. "
                            + "Use the delete button to remove this visit.";

                        checkbox
                            .closest(".vt-section")
                            .appendChild(message);

                        setTimeout(
                            function () {
                                message.remove();
                            },
                            3000
                        );
                    }
                }
            }
    </script>

    <script>
            (function () {
                document.addEventListener(
                    "DOMContentLoaded",
                    function () {
                        const pageReadOnly =
                            @pageReadOnly.ToString().ToLower();

                        const root =
                            document.getElementById(
                                "visitsReadOnlyRoot"
                            );

                        if (!pageReadOnly || !root) {
                            return;
                        }

                        root.classList.add(
                            "closed-visit-readonly"
                        );

                        root.querySelectorAll(
                            "input:not([type='hidden']), textarea, select"
                        ).forEach(function (element) {
                            element.disabled = true;
                        });

                        root.querySelectorAll(
                            "[contenteditable='true']"
                        ).forEach(function (element) {
                            element.setAttribute(
                                "contenteditable",
                                "false"
                            );
                        });

                        function isViewOnlyButton(button) {
                            const text =
                                (button.textContent || "")
                                    .replace(/\s+/g, " ")
                                    .trim()
                                    .toLowerCase();

                            return button.matches(
                                ".btn-close, "
                                + "[data-bs-dismiss='modal'], "
                                + "[data-readonly-allow='true']"
                            )
                            || text === "details"
                            || text === "view"
                            || text.startsWith("view ")
                            || text.includes("preview")
                            || text === "close"
                            || text === "×"
                            || text === "✕";
                        }

                        root.querySelectorAll(
                            "button, "
                            + "input[type='button'], "
                            + "input[type='submit']"
                        ).forEach(function (button) {
                            if (isViewOnlyButton(button)) {
                                return;
                            }

                            button.disabled = true;

                            button.setAttribute(
                                "aria-disabled",
                                "true"
                            );

                            button.classList.add(
                                "readonly-disabled-action"
                            );
                        });

                        root.querySelectorAll("form")
                            .forEach(function (form) {
                                form.addEventListener(
                                    "submit",
                                    function (event) {
                                        event.preventDefault();
                                        event.stopImmediatePropagation();
                                    },
                                    true
                                );
                            });

                        root.addEventListener(
                            "click",
                            function (event) {
                                const blocked =
                                    event.target.closest(
                                        ".readonly-disabled-action"
                                    );

                                if (!blocked) {
                                    return;
                                }

                                event.preventDefault();
                                event.stopImmediatePropagation();
                            },
                            true
                        );
                    }
                );
            })();
    </script>
</div>
