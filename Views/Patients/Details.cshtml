        color: #c0392b;
        font-size: 11px;
        font-weight: 700;
    }

    .automatic-condition-hint {
        display: none;
        margin-top: 5px;
        color: #c0392b;
        font-size: 11px;
        font-weight: 700;
    }


    /* ===== PATIENT CLINICAL SNAPSHOT ===== */
    .patient-summary-panel {
        max-width: 1200px;
        margin: 0 auto 22px;
        padding: 20px;
        background: linear-gradient( 145deg, #ffffff 0%, #f8f9fc 100% );
        border: 1px solid #dfe3ea;
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(37, 36, 104, .08);
    }

    .patient-summary-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 16px;
        padding-bottom: 14px;
        border-bottom: 1px solid #eceef3;
    }

    .patient-summary-eyebrow {
        display: block;
        margin-bottom: 3px;
        color: #daa328;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .9px;
        text-transform: uppercase;
    }

    .patient-summary-title {
        margin: 0;
        color: #252468;
        font-size: 18px;
        font-weight: 800;
    }

    .patient-summary-status {
