        color: #8a2727;
    }

    .patient-alert-card.is-clear
    .patient-alert-label {
        color: #22683d;
    }

    .patient-alert-value {
        overflow: hidden;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.45;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .patient-alert-card.is-alert
    .patient-alert-value {
        color: #541919;
    }

    .patient-alert-card.is-clear
    .patient-alert-value {
        color: #175b34;
    }

    /* ===== CONDITION AUTOCOMPLETE ===== */
    .condition-search-wrapper {
        position: relative;
    }

    .condition-search-icon {
        position: absolute;
        top: 50%;
        right: 12px;
        z-index: 2;
        color: #8d92a0;
        font-size: 12px;
        pointer-events: none;
        transform: translateY(-50%);
    }

    .condition-suggestions {
        display: none;
        position: absolute;
        top: calc(100% + 4px);
        right: 0;
        left: 0;
        z-index: 10060;
        max-height: 250px;
        overflow-y: auto;
        background: #ffffff;
        border: 1px solid #cfd3dc;
        border-radius: 7px;
        box-shadow: 0 10px 28px rgba(37, 36, 104, .18);
    }

    .condition-suggestion-item {
        width: 100%;
        padding: 9px 11px;
        background: #ffffff;
