    .patient-alert-card.is-alert
    .patient-alert-icon {
        color: #a32d2d;
        background: #fde3e1;
    }

    .patient-alert-card.is-clear
    .patient-alert-icon {
        color: #1e8449;
        background: #dff3e7;
    }

    .patient-alert-status-dot {
        position: absolute;
