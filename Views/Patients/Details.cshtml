    }

    .patient-alert-card.is-alert
    .patient-alert-status-dot {
        background: #b63535;
    }

    .patient-alert-card.is-clear
    .patient-alert-status-dot {
        background: #239b56;
    }

    .patient-alert-content {
        min-width: 0;
        flex: 1;
    }

    .patient-alert-label {
        margin-bottom: 4px;
        font-size: 11px;
        font-weight: 700;
    }

    .patient-alert-card.is-alert
