    <!-- Content -->
    <div class="info-bar" style="flex:1;">
        <section id="title-wrapper" style="justify-content:center; margin-bottom:20px;">
            <div class="lineleft"></div>
            <h1 class="sectiontitle heading6" style="margin:0 8px;">
                <p style="text-align:center;"><span style="color:#252468;" id="content-section-title">MEDICAL HISTORY</span></p>
            </h1>
            <div class="lineright" style="display:block; background-color:#daa328; height:2px; flex:1;"></div>
        </section>
        <br />

        <div id="patientVisitContent"
             class="@(isReadOnly ? "visit-readonly" : "")">

            <div id="medical-history" class="content-section @(activeTab == "medical-history" ? "active" : "")">
                @using (Html.BeginForm("Create", "MedicalHistories", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PatientID" value="@Model.PatientID" />
                    @if (mh != null)
                    {
                        <input type="hidden" name="MedicalHistoryID" value="@mh.MedicalHistoryID" />
                    }

                    <!-- Alert -->
                    @* يظهر فقط إذا في medical history مسبقة (زيارة ثانية فأكثر) *@
                    @if (mh != null)
                    {
                        <div id="medical-history-alert" style="border:1.5px solid #daa328; border-radius:6px; padding:16px 20px; margin-bottom:16px; display:flex; gap:16px; align-items:flex-start;">
                            <div style="font-size:28px; color:#daa328; flex-shrink:0;">⚠️</div>
                            <div>
                                <div style="font-weight:700; font-size:14px; color:#252468; margin-bottom:4px;">Medical History Verification Required</div>
                                <label style="font-size:12px; color:#333; display:flex; align-items:center; gap:8px; cursor:pointer;">
                                    <input type="checkbox" id="medicalHistoryCheckbox" name="MedicalHistoryVerified" value="true" @(mh?.MedicalHistoryVerified == true ? "checked" : "") />
                                    I confirm that I have reviewed the medical history with the patient.
                                </label>
                                <div style="font-size:11px; color:#888; margin-top:2px;">Check this box to unlock the patient file and continue with today's visit.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* أول مرة — نحط الـ checkbox مخفي وmحدد تلقائياً عشان ما يبلوك الـ tabs *@
                        <input type="hidden" name="MedicalHistoryVerified" value="true" />
                    }

                    @*
                        Visit Review يظهر ابتداءً من الزيارة الثانية فقط.
                        الزيارة الأولى: attendedVisitCount = 1، لذلك لا يظهر.
                    *@
                    @if (showVisitReview)
                    {
                        <!-- Visit Review -->
                        <div id="visitReviewSection"
                             style="border:1.5px solid #252468;
                            border-radius:6px;
                            padding:16px 20px;
                            margin-bottom:16px;">

                            <div style="font-weight:700;
                                font-size:14px;
                                color:#252468;
                                margin-bottom:10px;">
                                📊 Visit Review
                            </div>

                            <div style="font-size:12px;
                                font-weight:600;
                                color:#333;
                                margin-bottom:6px;">
                                Changes Status:
                            </div>

                            <div style="display:flex;
                                gap:24px;
                                margin-bottom:10px;">

                                <label style="display:flex;
                                    align-items:center;
                                    gap:6px;
                                    font-size:13px;
                                    cursor:pointer;">

                                    <input type="radio"
                                           id="noChangesRadio"
                                           name="ChangesStatus"
                                           value="NoChanges"
                                    @(mh?.ChangesStatus ==
                                                             DentalCollegeManagementSystem_AAU.Models.ChangesStatusType.NoChanges
                                                             ? "checked"
                                                             : "") />

                                    No changes in medical history
                                </label>

                                <label style="display:flex;
                                    align-items:center;
                                    gap:6px;
                                    font-size:13px;
                                    cursor:pointer;">

                                    <input type="radio"
                                           id="changesReportedRadio"
                                           name="ChangesStatus"
                                           value="ChangesReported"
                                    @(mh?.ChangesStatus ==
                                                             DentalCollegeManagementSystem_AAU.Models.ChangesStatusType.ChangesReported
                                                             ? "checked"
                                                             : "") />

                                    Changes reported
                                </label>
                            </div>

                            <div style="font-size:12px;
                                font-weight:600;
                                color:#333;
                                margin-bottom:6px;">
                                Review Date:
                            </div>

                            <input type="date"
                                   id="reviewDateInput"
                                   name="ReviewDate"
                                   value="@(
                                   mh?.ReviewDate.HasValue == true
                                       ? mh.ReviewDate.Value.ToString("yyyy-MM-dd")
                                       : DateTime.Today.ToString("yyyy-MM-dd")
                                                                                                                                                        )"
                                   readonly
                                   title="The date is entered automatically when Changes reported is selected."
                                   style="border:1px solid #ccc;
                            padding:6px 10px;
                            font-size:13px;
                            border-radius:4px;
                            background:#f5f5f5;
                            color:#333;
                            cursor:not-allowed;" />

                            <div style="font-size:11px;
                                color:#888;
                                margin-top:5px;">
                                The review date is updated automatically when changes are reported.
                            </div>
                        </div>
                    }
                    else
                    {
                        @*
                            في الزيارة الأولى لا نعرض Visit Review.
                            نرسل فقط القيمة الافتراضية حتى لا يحدث
                            Model Binding Error إذا كان ChangesStatus مطلوبًا.
                        *@
                        <input type="hidden"
                               name="ChangesStatus"
                               value="NoChanges" />
                    }

                    <!-- 1. Allergies -->
                    <div style="border:1px solid #ddd; border-radius:4px; padding:16px 20px; margin-bottom:12px;">
                        <div style="font-weight:700; font-size:13px; color:#252468; margin-bottom:10px;">1. Allergies</div>
                        <div style="display:flex; gap:40px;">
                            <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
                                <input type="radio" name="Allergies" value="false"
                                @(mh?.Allergies == false || mh == null ? "checked" : "")
                                       onchange="toggleAllergyNotes(false)" /> NO
                            </label>
                            <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
                                <input type="radio" name="Allergies" value="true"
                                @(mh?.Allergies == true ? "checked" : "")
                                       onchange="toggleAllergyNotes(true)" /> Yes
                            </label>
                        </div>
                        <div id="allergyNotesBox" style="margin-top:12px; @(mh?.Allergies == true ? "" : "display:none;")">
                            <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">
                                Allergy Details <span style="color:#c0392b;">*</span>
                            </label>
                            <textarea id="allergyNotesText" name="AllergyNotes" rows="3"
                                      style="width:100%; border:1px solid #ddd; border-radius:4px; padding:8px 12px; font-size:13px; resize:vertical;"
                                      placeholder="Describe the allergy (e.g. Penicillin, Latex...)">@mh?.AllergyNotes</textarea>

                            <div id="allergyNotesError" style="display:none; color:#c0392b; font-size:12px; margin-top:4px;">
                                ⚠️ Please describe the allergy.
                            </div>
                        </div>
                    </div>

                    <!-- 2. Ongoing Medical Treatment -->
                    <div style="border:1px solid #ddd; border-radius:4px; padding:16px 20px; margin-bottom:12px;">
                        <div style="font-weight:700; font-size:13px; color:#252468; margin-bottom:10px;">2. Ongoing Medical Treatment</div>
                        <textarea class="form-control" name="OngoingTreatment" rows="3"
                                  placeholder="Describe any ongoing medical treatments..."
                                  style="border-radius:4px; font-size:13px; resize:vertical;">@mh?.OngoingTreatment</textarea>
                    </div>

                    <!-- 3. Recent Hospitalization -->
                    <div style="border:1px solid #ddd; border-radius:4px; padding:16px 20px; margin-bottom:12px;">
                        <div style="font-weight:700; font-size:13px; color:#252468; margin-bottom:10px;">3. Recent Hospitalization (Past 12 Months)</div>
                        <div style="display:flex; gap:40px;">
                            <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
                                <input type="radio" name="RecentHospitalization" value="false"
                                @(mh?.RecentHospitalization == false || mh == null ? "checked" : "")
                                       onchange="toggleHospitalizationNotes(false)" /> NO
                            </label>
                            <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
                                <input type="radio" name="RecentHospitalization" value="true"
                                @(mh?.RecentHospitalization == true ? "checked" : "")
                                       onchange="toggleHospitalizationNotes(true)" /> Yes
                            </label>
                        </div>
                        <div id="hospitalizationNotesBox" style="margin-top:12px; @(mh?.RecentHospitalization == true ? "" : "display:none;")">
                            <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">
                                Hospitalization Details <span style="color:#c0392b;">*</span>
                            </label>
                            <textarea id="hospitalizationNotesText" name="HospitalizationNotes" rows="3"
                                      style="width:100%; border:1px solid #ddd; border-radius:4px; padding:8px 12px; font-size:13px; resize:vertical;"
                                      placeholder="Describe the hospitalization reason...">@mh?.HospitalizationNotes</textarea>
                            <div id="hospitalizationNotesError" style="display:none; color:#c0392b; font-size:12px; margin-top:4px;">
                                ⚠️ Please describe the hospitalization.
                            </div>
                        </div>
                    </div>

                    <!-- 4. Pregnancy -->
                    @if (Model.Gender?.ToLower() != "male")
                    {
                        <div style="border:1px solid #ddd; border-radius:4px; padding:16px 20px; margin-bottom:12px;">
                            <div style="font-weight:700; font-size:13px; color:#252468; margin-bottom:10px;">4. Current Pregnancy or Breastfeeding (If Applicable)</div>
                            <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer; margin-bottom:6px;">
                                <input type="checkbox" name="IsPregnant" value="true" @(mh?.IsPregnant == true ? "checked" : "") /> Currently Pregnant
                            </label>
                            <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
                                <input type="checkbox" name="IsBreastfeeding" value="true" @(mh?.IsBreastfeeding == true ? "checked" : "") /> Currently Breastfeeding
                            </label>
                        </div>
                    }

                    <!-- 5. Conditions -->
                    <div style="border:1px solid #ddd; border-radius:4px; padding:16px 20px; margin-bottom:12px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
                            <div style="font-weight:700; font-size:13px; color:#252468;">
                                5. Diagnosed Medical Conditions
                            </div>

                            <button type="button"
                                    onclick="openConditionModal()"
                                    style="background:#252468; color:white; border:none; padding:5px 14px; font-size:12px; font-weight:600; cursor:pointer; border-radius:4px;">
                                + Add Condition
                            </button>
                        </div>

                        <div style="font-size:11px; color:#777; margin-bottom:10px; line-height:1.7;">
                            Start typing a condition name to search and select it.
                            Bleeding Disorders, Infectious Diseases, and Cancer
                            are marked as 🚩 Red Flag automatically.
                        </div>

                        <div id="conditions-display">
                            @if (conditions != null && conditions.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped"
                                           style="font-size:12px;"
                                           id="conditions-table">
                                        <thead>
                                            <tr>
                                                <th>Condition</th>
                                                <th>Year</th>
                                                <th>Notes</th>
                                                <th>Case</th>
                                                <th>Red Flag</th>
                                                <th style="text-align:center;">Action</th>
                                            </tr>
                                        </thead>

                                        <tbody id="conditions-tbody">
                                            @foreach (var c in conditions)
                                            {
                                                bool conditionIsFlagged =
                                                    c.IsFlagged
                                                    ||
                                                    IsAutomaticConditionRedFlag(
                                                        c.ConditionName
                                                    );

                                                <tr>
                                                    <td class="condition-name-cell"
                                                        style="font-weight:600; color:#252468;">
                                                        @c.ConditionName
                                                    </td>

                                                    <td>
                                                        @(c.YearOfDiagnosis.HasValue
                                                            ? c.YearOfDiagnosis.ToString()
                                                            : "---")
                                                    </td>

                                                    <td>
                                                        @(string.IsNullOrEmpty(c.Notes)
                                                            ? "---"
                                                            : c.Notes)
                                                    </td>

                                                    <td>
                                                        @if (c.IsCurrentlyActive)
                                                        {
                                                            <span style="color:#27ae60; font-weight:600;">
                                                                Active
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span style="color:#aaa;">
                                                                Inactive
                                                            </span>
                                                        }
                                                    </td>

                                                    <td class="condition-flag-cell">
                                                        @if (conditionIsFlagged)
                                                        {
                                                            <span style="color:#c0392b; font-weight:700; font-size:13px;">
                                                                🚩 Yes
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span style="color:#aaa; font-size:11px;">
                                                                No
                                                            </span>
                                                        }
                                                    </td>

                                                    <td style="text-align:center; white-space:nowrap;">
                                                        <button type="button"
                                                                class="edit-condition-btn"
                                                                data-id="@c.ConditionID"
                                                                data-name="@c.ConditionName"
                                                                data-year="@(c.YearOfDiagnosis.HasValue ? c.YearOfDiagnosis.ToString() : "")"
                                                                data-active="@(c.IsCurrentlyActive ? "true" : "false")"
                                                                data-flagged="@(conditionIsFlagged ? "true" : "false")"
                                                                data-notes="@(c.Notes ?? "")"
                                                                style="background:none; border:none; color:#252468; cursor:pointer; margin-right:8px;"
                                                                title="Edit">
                                                            <i class="fa-solid fa-pen-to-square"></i>
                                                        </button>

                                                        <button type="button"
                                                                onclick="deleteCondition(this, @c.ConditionID)"
                                                                style="background:none; border:none; color:#c0392b; cursor:pointer;"
                                                                title="Delete">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div id="no-conditions-msg"
                                     style="font-size:12px; color:#888;">
                                    No conditions recorded yet.
                                </div>

                                <div class="table-responsive"
                                     id="conditions-table"
                                     style="display:none;">
                                    <table class="table table-bordered table-striped"
                                           style="font-size:12px;">
                                        <thead>
                                            <tr>
                                                <th>Condition</th>
                                                <th>Year</th>
                                                <th>Notes</th>
                                                <th>Case</th>
                                                <th>Red Flag</th>
                                                <th style="text-align:center;">Action</th>
                                            </tr>
                                        </thead>

                                        <tbody id="conditions-tbody"></tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 6. Medications -->
                    <div style="border:1px solid #ddd; border-radius:4px; padding:16px 20px; margin-bottom:24px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                            <div style="font-weight:700; font-size:13px; color:#252468;">
                                6. Medications
                            </div>

                            <button type="button"
                                    onclick="openMedicationModal()"
                                    style="background:#252468; color:white; border:none; padding:5px 14px; font-size:12px; font-weight:600; cursor:pointer; border-radius:4px;">
                                + Add Medication
                            </button>
                        </div>

                        <div style="font-size:11px; color:#777; margin-bottom:10px;">
                            Start typing a generic or brand name and select it
                            from the search results. Listed medicines are marked
                            as 🚩 Red Flag automatically.
                        </div>

                        <div id="medications-display">
                            @if (meds != null && meds.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped"
                                           style="font-size:12px;"
                                           id="medications-table">
                                        <thead>
                                            <tr>
                                                <th>Drug Name</th>
                                                <th>Dose</th>
                                                <th>Frequency</th>
                                                <th>Duration</th>
                                                <th>Red Flag</th>
                                                <th style="text-align:center;">Action</th>
                                            </tr>
                                        </thead>

                                        <tbody id="medications-tbody">
                                            @foreach (var med in meds)
                                            {
                                                bool medicationIsFlagged =
                                                    !string.IsNullOrWhiteSpace(
                                                        med.FlagType
                                                    )
                                                    ||
                                                    IsAutomaticMedicationRedFlag(
                                                        med.DrugName
                                                    );

                                                <tr>
                                                    <td class="medication-name-cell">
                                                        @med.DrugName
                                                    </td>

                                                    <td>
                                                        @(string.IsNullOrEmpty(med.Dose)
                                                            ? "---"
                                                            : med.Dose)
                                                    </td>

                                                    <td>
                                                        @(string.IsNullOrEmpty(med.Frequency)
                                                            ? "---"
                                                            : med.Frequency)
                                                    </td>

                                                    <td>
                                                        @(string.IsNullOrEmpty(med.Duration)
                                                            ? "---"
                                                            : med.Duration)
                                                    </td>

                                                    <td class="medication-flag-cell">
                                                        @if (medicationIsFlagged)
                                                        {
                                                            <span style="color:#c0392b; font-weight:700; font-size:13px;">
                                                                🚩 Yes
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span style="color:#aaa; font-size:11px;">
                                                                No
                                                            </span>
                                                        }
                                                    </td>

                                                    <td style="text-align:center; white-space:nowrap;">
                                                        <button type="button"
                                                                class="edit-med-btn"
                                                                data-id="@med.MedicationID"
                                                                data-drug="@med.DrugName"
                                                                data-dose="@(med.Dose ?? "")"
                                                                data-frequency="@(med.Frequency ?? "")"
                                                                data-duration="@(med.Duration ?? "")"
                                                                data-flag="@(med.FlagType ?? "")"
                                                                style="background:none; border:none; color:#252468; cursor:pointer; margin-right:8px;"
                                                                title="Edit">
                                                            <i class="fa-solid fa-pen-to-square"></i>
                                                        </button>

                                                        <button type="button"
                                                                onclick="deleteMedication(this, @med.MedicationID)"
                                                                style="background:none; border:none; color:#c0392b; cursor:pointer;"
                                                                title="Delete">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div id="no-medications-msg"
                                     style="font-size:12px; color:#888;">
                                    No medications recorded yet.
                                </div>

                                <div class="table-responsive"
                                     id="medications-table"
                                     style="display:none;">
                                    <table class="table table-bordered table-striped"
                                           style="font-size:12px;">
                                        <thead>
                                            <tr>
                                                <th>Drug Name</th>
                                                <th>Dose</th>
                                                <th>Frequency</th>
                                                <th>Duration</th>
                                                <th>Red Flag</th>
                                                <th style="text-align:center;">Action</th>
                                            </tr>
                                        </thead>

                                        <tbody id="medications-tbody"></tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Save Button -->
                    <div class="btnwrap" style="padding-top:0px; padding-bottom:50px; display:flex; justify-content:center;">
                        <button type="submit" id="saveBtn" class="mybtn heading13"
                                style="background-color:#DAA328; border-radius:0px 10px 10px; width:200px; border:none;">
                            Save
                            <span class="line" style="border-right:6px solid #252468; border-bottom:6px solid #252468; right:-4px; bottom:-4px; border-top:none; border-left:none;"></span>
                            <span class="areaborder" style="border:0px;"></span>
                        </button>
                    </div>
                }
            </div>

            <div id="dental-history" class="content-section @(activeTab == "dental-history" ? "active" : "")">@await Html.PartialAsync("DentalHistory", Model)</div>
            <div id="social-history" class="content-section @(activeTab == "social-history" ? "active" : "")">@await Html.PartialAsync("SocialHistory", Model)</div>
            <div id="extraoral-exam" class="content-section @(activeTab == "extraoral-exam" ? "active" : "")">@await Html.PartialAsync("Extraoralexam", Model)</div>
            <div id="intraoral-exam" class="content-section @(activeTab == "intraoral-exam" ? "active" : "")">@await Html.PartialAsync("Intraoralexam", Model)</div>
            <div id="treatment-plan" class="content-section @(activeTab == "treatment-plan" ? "active" : "")">@await Html.PartialAsync("Treatment-plan", Model)</div>
            <div id="notes" class="content-section @(activeTab == "notes" ? "active" : "")">@await Html.PartialAsync("Notes", Model)</div>
            <div id="radiographs" class="content-section @(activeTab == "radiographs" ? "active" : "")">@await Html.PartialAsync("Radiographs", Model)</div>
            <div id="photos" class="content-section @(activeTab == "photos" ? "active" : "")">@await Html.PartialAsync("Photos", Model)</div>
            <div id="competencies" class="content-section @(activeTab == "competencies" ? "active" : "")">@await Html.PartialAsync("Competencies", Model)</div>
            <div id="orders" class="content-section @(activeTab == "orders" ? "active" : "")">@await Html.PartialAsync("Orders", ViewBag.Orders as List<Order>)</div>
            <div id="todays-visit" class="content-section @(activeTab == "todays-visit" ? "active" : "")">@await Html.PartialAsync("Visits", Model)</div>

        </div>

    </div>
</div>

<!-- ===== Condition ADD Modal ===== -->
<div id="conditionModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:10px; padding:28px; width:860px; max-width:95vw; max-height:90vh; overflow-y:auto;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h2 style="font-size:18px; font-weight:700; color:#252468; margin:0;">Diagnosed Medical Conditions</h2>
            <button onclick="closeConditionModal()" type="button" style="background:none; border:none; font-size:20px; cursor:pointer; color:#888;">✕</button>
        </div>
        <form id="conditionForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PatientID" value="@Model.PatientID" />
            <div id="conditions-modal-list"></div>
            <button type="button" onclick="addModalRow()"
                    style="background:none; border:1px dashed #252468; color:#252468; padding:8px 18px; font-size:13px; font-weight:600; border-radius:5px; cursor:pointer; margin-top:12px; width:100%;">
                + Add Another Condition
            </button>
            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
                <button type="button" onclick="closeConditionModal()" style="background:white; color:#555; border:1px solid #ddd; padding:10px 24px; font-size:14px; border-radius:5px; cursor:pointer;">Cancel</button>
                <button type="button" onclick="saveConditions()" style="background:#252468; color:white; border:none; padding:10px 28px; font-size:14px; font-weight:600; border-radius:5px; cursor:pointer;">Save Conditions</button>
            </div>
        </form>
    </div>
</div>

<!-- ===== Condition EDIT Modal ===== -->
<div id="editConditionModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:10px; padding:28px; width:500px; max-width:95vw;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h2 style="font-size:16px; font-weight:700; color:#252468; margin:0;">Edit Condition</h2>
            <button onclick="closeEditConditionModal()" type="button" style="background:none; border:none; font-size:20px; cursor:pointer; color:#888;">✕</button>
        </div>
        <form id="editConditionForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editConditionID" name="ConditionID" />
            <div style="margin-bottom:12px;">

                <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">
                    Condition Name
                </label>

                <div class="condition-search-wrapper">

                    <input type="text"
                           id="editConditionName"
                           name="ConditionName"
                           class="condition-name-input"
                           data-suggestions-id="editConditionSuggestions"
                           autocomplete="off"
                           style="width:100%; border:1px solid #ddd; border-radius:5px; padding:8px 38px 8px 12px; font-size:13px; box-sizing:border-box;"
                           placeholder="Start typing a condition name..." />

                    <span class="condition-search-icon"
                          aria-hidden="true">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>

                    <div id="editConditionSuggestions"
                         class="condition-suggestions"
                         role="listbox"
                         aria-label="Condition suggestions">
                    </div>

                </div>

                <div id="editConditionAutomaticHint"
                     class="automatic-condition-hint">
                    🚩 This condition is an automatic Red Flag.
                </div>

            </div>
            <div style="margin-bottom:12px;">
                <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">Year of Diagnosis</label>
                <input type="number" id="editConditionYear" name="YearOfDiagnosis" min="1900" max="2100"
                       maxlength="4" oninput="if(this.value.length > 4) this.value = this.value.slice(0, 4);"
                       style="width:100%; border:1px solid #ddd; border-radius:5px; padding:8px 12px; font-size:13px; box-sizing:border-box;" />
            </div>
            <div style="margin-bottom:12px; display:flex; gap:20px; font-size:13px;">
                <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                    <input type="checkbox" id="editConditionActive" name="IsCurrentlyActive" value="true" style="accent-color:#252468;" /> Currently Active
                </label>
                <label style="display:flex; align-items:center; gap:6px; cursor:pointer; color:#c0392b; font-weight:600;">
                    <input type="checkbox"
                           id="editConditionFlagged"
                           name="IsFlagged"
                           value="true"
                           onclick="enforceEditConditionAutoFlag()"
                           style="accent-color:#c0392b;" />
                    🚩 Red Flag
                </label>
            </div>
            <div style="margin-bottom:20px;">
                <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">Notes</label>
                <textarea id="editConditionNotes" name="Notes" rows="3"
                          style="width:100%; border:1px solid #ddd; border-radius:5px; padding:8px 12px; font-size:13px; box-sizing:border-box; resize:vertical;"></textarea>
            </div>
            <div style="display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" onclick="closeEditConditionModal()" style="background:white; color:#555; border:1px solid #ddd; padding:10px 24px; font-size:13px; border-radius:5px; cursor:pointer;">Cancel</button>
                <button type="button" onclick="submitEditCondition()" id="editConditionSaveBtn" style="background:#252468; color:white; border:none; padding:10px 28px; font-size:13px; font-weight:600; border-radius:5px; cursor:pointer;">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- ===== Medication ADD Modal ===== -->
<div id="medicationModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:10px; padding:28px; width:860px; max-width:95vw; max-height:90vh; overflow-y:auto;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h2 style="font-size:18px; font-weight:700; color:#252468; margin:0;">Medications</h2>
            <button onclick="closeMedicationModal()" type="button" style="background:none; border:none; font-size:20px; cursor:pointer; color:#888;">✕</button>
        </div>
        <form id="medicationForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PatientID" value="@Model.PatientID" />
            <div id="medications-modal-list"></div>
            <button type="button" onclick="addMedicationRow()"
                    style="background:none; border:1px dashed #252468; color:#252468; padding:8px 18px; font-size:13px; font-weight:600; border-radius:5px; cursor:pointer; margin-top:12px; width:100%;">
                + Add Another Medication
            </button>
            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
                <button type="button" onclick="closeMedicationModal()" style="background:white; color:#555; border:1px solid #ddd; padding:10px 24px; font-size:14px; border-radius:5px; cursor:pointer;">Cancel</button>
                <button type="button" onclick="saveMedications()" style="background:#252468; color:white; border:none; padding:10px 28px; font-size:14px; font-weight:600; border-radius:5px; cursor:pointer;">Save Medications</button>
            </div>
        </form>
    </div>
</div>

<!-- ===== Medication EDIT Modal ===== -->
<div id="editMedicationModal"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">

    <div style="background:white; border-radius:10px; padding:28px; width:560px; max-width:95vw; max-height:90vh; overflow-y:auto;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h2 style="font-size:16px; font-weight:700; color:#252468; margin:0;">
                Edit Medication
            </h2>

            <button onclick="closeEditMedicationModal()"
                    type="button"
                    style="background:none; border:none; font-size:20px; cursor:pointer; color:#888;">
                ✕
            </button>
        </div>

        <form id="editMedicationForm">
            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="editMedID"
                   name="MedicationID" />

            @*
                FlagType لم يعد اختياراً يدوياً.
                يتم تحديده تلقائياً من اسم الدواء.
            *@
            <input type="hidden"
                   id="editMedFlagType"
                   name="FlagType" />

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:12px;">
                <div>
                    <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">
                        Drug Name
                    </label>

                    <div class="medication-search-wrapper">
                        <input type="text"
                               id="editMedDrugName"
                               name="DrugName"
                               class="medication-drug-input"
                               data-suggestions-id="editMedicationSuggestions"
                               data-flag-target="editMedFlagType"
                               autocomplete="off"
                               placeholder="Search generic or brand name..."
                               style="width:100%; border:1px solid #ddd; border-radius:5px; padding:8px 12px; font-size:13px; box-sizing:border-box;" />

                        <div id="editMedicationSuggestions"
                             class="medication-suggestions">
                        </div>
                    </div>

                    <div id="editMedicationAutomaticFlagHint"
                         class="automatic-red-flag-hint">
                        🚩 Red Flag will be assigned automatically.
                    </div>
                </div>

                <div>
                    <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">
                        Dose
                    </label>

                    <input type="text"
                           id="editMedDose"
                           name="Dose"
                           style="width:100%; border:1px solid #ddd; border-radius:5px; padding:8px 12px; font-size:13px; box-sizing:border-box;" />
                </div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:20px;">
                <div>
                    <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">
                        Frequency
                    </label>

                    <input type="text"
                           id="editMedFrequency"
                           name="Frequency"
                           style="width:100%; border:1px solid #ddd; border-radius:5px; padding:8px 12px; font-size:13px; box-sizing:border-box;" />
                </div>

                <div>
                    <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">
                        Duration
                    </label>

                    <input type="text"
                           id="editMedDuration"
                           name="Duration"
                           style="width:100%; border:1px solid #ddd; border-radius:5px; padding:8px 12px; font-size:13px; box-sizing:border-box;" />
                </div>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px;">
                <button type="button"
                        onclick="closeEditMedicationModal()"
                        style="background:white; color:#555; border:1px solid #ddd; padding:10px 24px; font-size:13px; border-radius:5px; cursor:pointer;">
                    Cancel
                </button>

                <button type="button"
                        onclick="submitEditMedication()"
                        id="editMedSaveBtn"
                        style="background:#252468; color:white; border:none; padding:10px 28px; font-size:13px; font-weight:600; border-radius:5px; cursor:pointer;">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {

    @* asp-append-version prevents the browser from using an old cached JavaScript file. *@
    <script src="~/Patientjs/Patient-details.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // =====================================================
            // CLOSED VISIT: all tabs remain visible, but data is view only
            // =====================================================

            const isReadOnly =
                @isReadOnly.ToString().ToLower();

            // =====================================================
            // VISIT REVIEW
            // عند اختيار Changes reported يتم وضع تاريخ اليوم تلقائياً.
            // حقل التاريخ readonly لذلك لا يمكن تغييره يدوياً.
            // =====================================================

            const changesReportedRadio =
                document.getElementById(
                    "changesReportedRadio"
                );

            const reviewDateInput =
                document.getElementById(
                    "reviewDateInput"
                );

            function getLocalTodayDate() {

                const todayDate =
                    new Date();

                const year =
                    todayDate.getFullYear();

                const month =
                    String(
                        todayDate.getMonth() + 1
                    ).padStart(
                        2,
                        "0"
                    );

                const day =
                    String(
                        todayDate.getDate()
                    ).padStart(
                        2,
                        "0"
                    );

                return (
                    year
                    +
                    "-"
                    +
                    month
                    +
                    "-"
                    +
                    day
                );
            }

            if (
                changesReportedRadio
                &&
                reviewDateInput
            ) {

                changesReportedRadio.addEventListener(
                    "change",
                    function () {

                        if (
                            this.checked
                            &&
                            !isReadOnly
                        ) {
                            reviewDateInput.value =
                                getLocalTodayDate();
                        }
                    }
                );
            }

            if (isReadOnly) {

                const readOnlyRoots = [
                    document.getElementById("patientVisitContent"),
                    document.getElementById("conditionModal"),
                    document.getElementById("editConditionModal"),
                    document.getElementById("medicationModal"),
                    document.getElementById("editMedicationModal")
                ].filter(Boolean);

                function isViewOnlyButton(button) {

                    const text =
                        (button.textContent || "")
                            .replace(/\s+/g, " ")
                            .trim()
                            .toLowerCase();

                    return button.matches(
                        ".btn-close, [data-bs-dismiss='modal'], [data-readonly-allow='true']"
                    )
                        || text === "details"
                        || text === "view"
                        || text.startsWith("view ")
                        || text.includes("preview")
                        || text === "close"
                        || text === "×"
                        || text === "✕";
                }

                readOnlyRoots.forEach(function (root) {

                    root.querySelectorAll(
                        "input:not([type='hidden']), textarea, select"
                    )
                        .forEach(function (element) {
                            element.disabled = true;
                        });

                    root.querySelectorAll(
                        "button, input[type='button'], input[type='submit']"
                    )
                        .forEach(function (button) {

                            if (isViewOnlyButton(button)) {
                                return;
                            }

                            button.disabled = true;
                            button.setAttribute("aria-disabled", "true");
                            button.classList.add("readonly-disabled-action");
                        });

                    root.querySelectorAll("form")
                        .forEach(function (form) {

                            form.addEventListener(
                                "submit",
                                function (event) {
                                    event.preventDefault();
                                    event.stopImmediatePropagation();
                                },
                                true
                            );
                        });
                });
            }


            // =====================================================
            // 1. رابط Dental Charting
            // يمنع أي JavaScript قديم من اعتباره Tab داخلي
            // =====================================================

            const dentalChartLink =
                document.getElementById("dentalChartLink");

            if (dentalChartLink) {

                dentalChartLink.addEventListener(
                    "click",
                    function (event) {

                        event.preventDefault();

                        // منع أي Event قديم موجود داخل Patient-details.js
                        event.stopPropagation();
                        event.stopImmediatePropagation();

                        const chartUrl =
                            dentalChartLink.getAttribute("href");

                        if (
                            chartUrl &&
                            chartUrl !== "#" &&
                            chartUrl !== "javascript:void(0)"
                        ) {
                            window.open(
                                chartUrl,
                                "_blank",
                                "noopener,noreferrer"
                            );
                        }
                    },
                    true
                );
            }

            // =====================================================
            // 2. روابط التبويبات الداخلية فقط
            // Dental Charting لا يحتوي data-target
            // لذلك لن يدخل هنا
            // =====================================================

            const sidebarLinks =
                document.querySelectorAll(
                    "#sidebar .sidebar-link[data-target]"
                );

            const contentSections =
                document.querySelectorAll(".content-section");

            const sectionTitle =
                document.getElementById(
                    "content-section-title"
                );

            const sectionTitles = {
                "medical-history": "MEDICAL HISTORY",
                "dental-history": "DENTAL HISTORY",
                "social-history": "SOCIAL HISTORY",
                "extraoral-exam": "EXTRAORAL EXAM",
                "intraoral-exam": "INTRAORAL EXAM",
                "treatment-plan": "TREATMENT PLAN",
                "todays-visit": "VISITS",
                "notes": "NOTES",
                "radiographs": "RADIOGRAPHS",
                "photos": "PHOTOS",
                "competencies": "COMPETENCIES",
                "orders": "ORDERS"
            };

            // =====================================================
            // 3. فتح Tab داخلي
            // =====================================================

            function openPatientTab(targetName, updateUrl) {

                // منع undefined أو tab غير موجود
                if (
                    !targetName ||
                    targetName === "undefined" ||
                    targetName === "null"
                ) {
                    targetName = "medical-history";
                }

                const targetSection =
                    document.getElementById(targetName);

                if (!targetSection) {
                    console.error(
                        "The requested content section was not found:",
                        targetName
                    );

                    targetName = "medical-history";
                }

                const validTargetSection =
                    document.getElementById(targetName);

                if (!validTargetSection) {
                    return;
                }

                // إخفاء جميع الأقسام
                contentSections.forEach(function (section) {
                    section.classList.remove("active");
                });

                // إزالة حالة Active من جميع الروابط الداخلية
                sidebarLinks.forEach(function (link) {
                    link.classList.remove("tab-active");
                });

                // إظهار القسم المطلوب
                validTargetSection.classList.add("active");

                // تحديد الرابط المختار
                const selectedLink =
                    Array.from(sidebarLinks).find(
                        function (link) {
                            return link.getAttribute(
                                "data-target"
                            ) === targetName;
                        }
                    );

                if (selectedLink) {
                    selectedLink.classList.add(
                        "tab-active"
                    );
                }

                // تغيير عنوان القسم
                if (sectionTitle) {
                    sectionTitle.textContent =
                        sectionTitles[targetName] ||
                        targetName
                            .replaceAll("-", " ")
                            .toUpperCase();
                }

                // تحديث URL بدون Reload
                if (updateUrl === true) {

                    const currentUrl =
                        new URL(window.location.href);

                    currentUrl.searchParams.set(
                        "tab",
                        targetName
                    );

                    window.history.replaceState(
                        {},
                        "",
                        currentUrl.toString()
                    );
                }
            }

            // =====================================================
            // 4. معالجة الضغط على التبويبات الداخلية
            // =====================================================

            sidebarLinks.forEach(function (link) {

                link.addEventListener(
                    "click",
                    function (event) {

                        const targetName =
                            link.getAttribute(
                                "data-target"
                            );

                        // هذا الشرط يمنع tab=undefined
                        if (
                            !targetName ||
                            targetName === "undefined"
                        ) {
                            return;
                        }

                        // منع فتح التبويب إذا كان مقفلًا
                        if (
                            link.classList.contains(
                                "disabled-link"
                            )
                        ) {
                            event.preventDefault();
                            return;
                        }

                        event.preventDefault();

                        openPatientTab(
                            targetName,
                            true
                        );
                    }
                );
            });

            // =====================================================
            // 5. فتح التبويب الموجود في URL عند تحميل الصفحة
            // =====================================================

            const queryParameters =
                new URLSearchParams(
                    window.location.search
                );

            let initialTab =
                queryParameters.get("tab");

            // تنظيف tab=undefined أو قيمة غير صحيحة
            if (
                !initialTab ||
                initialTab === "undefined" ||
                initialTab === "null" ||
                !document.getElementById(initialTab)
            ) {
                initialTab = "medical-history";

                const cleanUrl =
                    new URL(window.location.href);

                cleanUrl.searchParams.set(
                    "tab",
                    initialTab
                );

                window.history.replaceState(
                    {},
                    "",
                    cleanUrl.toString()
                );
            }

            openPatientTab(
                initialTab,
                false
            );
        });
    </script>
}
