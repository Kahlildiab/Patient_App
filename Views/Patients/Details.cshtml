            color: #252468;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

            .edit-link a:hover {
                color: #daa328;
            }

    .details-card {
        border: 1.5px solid #252468;
        background: #fff;
        padding: 30px 36px;
        display: flex;
        gap: 30px;
        align-items: flex-start;
    }

    .details-body {
        flex: 1;
    }

    .patient-name-en {
        font-size: 16px;
        font-weight: 700;
        color: #252468;
        margin-bottom: 18px;
    }

    .details-info {
        font-size: 13px;
        color: #333;
        line-height: 2.2;
    }

        .details-info span.lbl {
            font-weight: 600;
            color: #252468;
        }

    .details-icon {
        width: 130px;
        height: 130px;
        background: #e9e9e9;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .details-icon svg {
            width: 80px;
            height: 80px;
            fill: none;
            stroke: #252468;
            stroke-width: 5;
        }

    .details-footer {
        display: flex;
        gap: 0;
        margin-top: 12px;
    }

    .footer-left {
        flex: 1;
        background: #252468;
        color: white;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
    }

    .footer-right {
        flex: 1;
        background: #daa328;
        color: white;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
    }

    .patient-layout {
        display: flex;
        gap: 0;
        margin-top: 20px;
        max-width: 1200px;
        margin-left: auto;
        margin-right: auto;
    }

    #sidebar {
        position: relative;
        border-left: 4px solid #daa328;
        padding-left: 8px;
    }

        #sidebar ul {
            border-left: none !important;
            margin: 0;
            padding: 0;
        }

        #sidebar > .line {
            display: none !important;
        }

        /* لا تنشئ خطاً عمودياً إضافياً */
        #sidebar .sidebar-link::before,
        #sidebar .sidebar-link:hover::before,
        #sidebar .sidebar-link.tab-active::before {
            content: none !important;
            display: none !important;
        }

    .sidebar-link:hover {
        background-color: #2f4f8f;
        color: white !important;
    }

        .sidebar-link:hover span {
            color: white !important;
            position: relative;
        }

            /* فقط خط تحت النص */
            .sidebar-link:hover span::after {
                content: '';
                position: absolute;
                bottom: -3px;
                left: 0;
                width: 100%;
                height: 3px;
                background-color: #e8a020;
            }

    .flag-badge {
        display: inline-block;
        font-size: 11px;
        padding: 2px 7px;
        border-radius: 20px;
        margin-bottom: 3px;
        font-weight: 600;
        white-space: nowrap;
    }

    .flag-anticoagulant {
        background: #ffe0e0;
        color: #c0392b;
    }

    .flag-bisphosphonates {
        background: #fff3cd;
        color: #856404;
    }

    .flag-steroids {
        background: #ffe8cc;
        color: #d35400;
    }

    .flag-immunosuppressants {
        background: #e8d5f5;
        color: #6c3483;
    }

    .content-section {
        display: none;
    }

        .content-section.active {
            display: block;
        }

    /* ===== CLOSED VISIT / VIEW-ONLY MODE ===== */
    #patientVisitContent {
        width: 100%;
        min-width: 0;
    }

    .visit-closed-alert {
        display: flex;
        align-items: center;
        gap: 14px;
        max-width: 1200px;
        margin: 0 auto 20px;
        padding: 14px 18px;
        background: #ffebee;
        border: 1.5px solid #c62828;
        border-radius: 8px;
    }

    .visit-closed-icon {
        flex-shrink: 0;
