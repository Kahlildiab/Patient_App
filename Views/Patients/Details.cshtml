        padding: 9px 11px;
        text-align: left;
        cursor: pointer;
    }

        .medication-suggestion-item:last-child {
            border-bottom: 0;
        }

        .medication-suggestion-item:hover,
        .medication-suggestion-item.active {
            background: #eef0f8;
        }

    .medication-suggestion-generic {
