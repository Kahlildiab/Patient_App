        font-size: 14px;
        font-weight: 800;
    }

    .visit-closed-text {
        color: #555;
        font-size: 12px;
    }

    .visit-readonly input:disabled,
    .visit-readonly textarea:disabled,
    .visit-readonly select:disabled {
        opacity: 1 !important;
        color: #333 !important;
        background-color: #f7f7f7 !important;
        cursor: default !important;
    }

    .visit-readonly input[type="checkbox"]:disabled,
    .visit-readonly input[type="radio"]:disabled {
        opacity: 1 !important;
    }

    .visit-readonly .readonly-disabled-action {
        opacity: .45 !important;
        cursor: not-allowed !important;
        pointer-events: none !important;
    }

    .visit-readonly input[type="file"],
    .visit-readonly .photo-drop-zone,
    .visit-readonly .ph-upload-zone {
        pointer-events: none !important;
        opacity: .55 !important;
        cursor: not-allowed !important;
    }

    .visit-readonly form {
        margin-bottom: 0;
    }

    /* ===== MEDICATION AUTOCOMPLETE ===== */
    .medication-search-wrapper {
        position: relative;
    }

    .medication-suggestions {
        display: none;
        position: absolute;
        top: calc(100% + 3px);
        left: 0;
        right: 0;
        z-index: 10050;
        max-height: 240px;
        overflow-y: auto;
        background: #ffffff;
        border: 1px solid #cfd3dc;
        border-radius: 5px;
        box-shadow: 0 8px 24px rgba(37, 36, 104, .18);
