<!-- ===== CLINICAL SNAPSHOT ===== -->
<section class="patient-summary-panel">

    <div class="patient-summary-heading">

        <div>
            <span class="patient-summary-eyebrow">
                Patient overview
            </span>

            <h2 class="patient-summary-title">
                Clinical Snapshot
            </h2>
        </div>

        <div class="patient-summary-status">
            Current patient information
        </div>

    </div>

    <div class="patient-summary-primary-grid">

        <!-- Case Complexity -->
        <article class="patient-summary-tile">

           

            <div class="patient-summary-content">

                <div class="patient-summary-label">
                    Case Complexity
                </div>

                @if (canEditCaseComplexity)
                {
                    <form asp-controller="CaseComplexity"
                          asp-action="Update"
                          method="post"
                          class="case-complexity-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="patientId"
                               value="@Model.PatientID" />

                        <input type="hidden"
                               name="returnTab"
                               value="@activeTab" />

                        <select name="caseComplexity"
                                required
                                aria-label="Case Complexity"
                                class="case-complexity-select">

                            <option value=""
                                    disabled
                                    selected="@(complexity == "---" ? "selected" : null)">
                                -- Select --
                            </option>

                            <option value="Mild"
                                    selected="@(string.Equals(
                                                                        complexity,
                                                                        "Mild",
                                                                        StringComparison.OrdinalIgnoreCase
                                                                    ) ? "selected" : null)">
                                Mild
                            </option>

                            <option value="Moderate"
                                    selected="@(string.Equals(
                                                                        complexity,
                                                                        "Moderate",
                                                                        StringComparison.OrdinalIgnoreCase
                                                                    ) ? "selected" : null)">
                                Moderate
                            </option>

                            <option value="Advance"
                                    selected="@(string.Equals(
                                                                        complexity,
                                                                        "Advance",
                                                                        StringComparison.OrdinalIgnoreCase
                                                                    ) ? "selected" : null)">
                                Advance
                            </option>

                        </select>

                        <button type="submit"
                                class="case-complexity-save"
                                title="Save Case Complexity">
                            Save
                        </button>

                    </form>
                }
                else
                {
                    <div class="patient-summary-value @(complexity == "---" ? "is-empty" : "")"
                         title="@complexity">
                        @complexity
                    </div>
                }

            </div>

        </article>

        <!-- Next Appointment -->
        <article class="patient-summary-tile">

            

            <div class="patient-summary-content">

                <div class="patient-summary-label">
                    Next Appointment
                </div>

                <div class="patient-summary-value @(nextAppt == null ? "is-empty" : "")"
                     title="@nextAppointmentText">
                    @nextAppointmentText
                </div>

            </div>

        </article>

        <!-- Assigned Student -->
        <article class="patient-summary-tile">

            

            <div class="patient-summary-content">

                <div class="patient-summary-label">
                    Assigned Student
                </div>

                <div class="patient-summary-value @(assignedStudentText == "No student assigned" ? "is-empty" : "")"
                     title="@assignedStudentText">
                    @assignedStudentText
                </div>

            </div>

        </article>

    </div>

    <div class="patient-alert-grid">

        <!-- Allergies -->
        <article class="patient-alert-card @(hasAllergies ? "is-alert" : "is-clear")">

            

            <div class="patient-alert-content">

                <div class="patient-alert-label">
                    Allergies
                </div>

                <div class="patient-alert-value"
                     title="@(hasAllergies ? mh?.AllergyNotes : "No allergies")">
                    @(hasAllergies
                        ? mh?.AllergyNotes
                        : "No allergies")
                </div>

            </div>

        </article>

        <!-- Condition Red Flags -->
        <article id="info-bar-condition-red-flags-wrapper"
                 class="patient-alert-card @(hasConditionRedFlags ? "is-alert" : "is-clear")">

            

            <div class="patient-alert-content">

                <div id="info-bar-condition-red-flags-label"
                     class="patient-alert-label">
                    Condition Red Flags
                </div>

                <div id="info-bar-condition-red-flags"
                     class="patient-alert-value"
                     title="@conditionRedFlagText">
                    @conditionRedFlagText
                </div>

            </div>

        </article>

        <!-- Medication Red Flags -->
        <article id="info-bar-medication-red-flags-wrapper"
                 class="patient-alert-card @(hasMedicationRedFlags ? "is-alert" : "is-clear")">

           

            <div class="patient-alert-content">

                <div id="info-bar-medication-red-flags-label"
                     class="patient-alert-label">
                    Medication Red Flags
                </div>

                <div id="info-bar-medication-red-flags"
                     class="patient-alert-value"
                     title="@medicationRedFlagText">
                    @medicationRedFlagText
                </div>

            </div>

        </article>

    </div>

</section>

