@model DentalCollegeManagementSystem_AAU.Models.Patient

@{
    ViewData["Title"] = "Patient Details";

    int age = 0;

    if (Model.DateOfBirth.HasValue)
    {
        age = DateTime.Today.Year - Model.DateOfBirth.Value.Year;

        if (Model.DateOfBirth.Value.Date > DateTime.Today.AddYears(-age))
        {
            age--;
        }
    }

    var mh = ViewBag.MedicalHistory
        as DentalCollegeManagementSystem_AAU.Models.MedicalHistory;

    var conditions = ViewBag.Conditions
        as List<DentalCollegeManagementSystem_AAU.Models.Condition>;

    var meds = ViewBag.Medications
        as List<DentalCollegeManagementSystem_AAU.Models.Medication>;

    bool hasAllergies =
        mh?.Allergies == true &&
        !string.IsNullOrWhiteSpace(mh.AllergyNotes);

    /*
     * Red Flags التلقائية للحالات المرضية.
     */
    var automaticRedFlagConditions =
        new HashSet<string>(
            StringComparer.OrdinalIgnoreCase
        )
        {
            "Bleeding Disorders",
            "Infectious Diseases",
            "Cancer"
        };

    /*
     * الاسم العلمي والأسماء التجارية للأدوية
     * التي يجب اعتبارها Red Flag تلقائياً.
     */
    var automaticRedFlagMedicationNames =
        new HashSet<string>(
            StringComparer.OrdinalIgnoreCase
        )
        {
            "Warfarin", "Marevan", "Coumadin",
            "Rivaroxaban", "Xarelto",
            "Apixaban", "Eliquis",
            "Dabigatran", "Pradaxa",
            "Edoxaban", "Lixiana",
            "Enoxaparin", "Clexane",
            "Aspirin", "Aspocid", "Cardioprin",
            "Clopidogrel", "Plavix", "Clopivas",

            "Alendronate", "Fosamax", "Osteomax",
            "Risedronate", "Actonel",
            "Ibandronate", "Bonviva",
            "Zoledronic acid", "Aclasta", "Zometa",
            "Pamidronate", "Aredia",
            "Denosumab", "Prolia", "Xgeva",

            "Prednisolone", "Deltacortril",
            "Prednisolone Kabi",
            "Methylprednisolone", "Medrol",
            "Solu-Medrol",
            "Dexamethasone",
            "Betamethasone", "Betnesol", "Celestone",
            "Hydrocortisone", "Solu-Cortef", "Cortef",

            "Cyclosporine", "Sandimmune", "Neoral",
            "Tacrolimus", "Prograf", "Advagraf",
            "Methotrexate",
            "Azathioprine", "Imuran",
            "Mycophenolate mofetil", "CellCept",
            "Myfortic",
            "Adalimumab", "Humira",
            "Etanercept", "Enbrel",
            "Rituximab", "Mabthera",
            "Sirolimus", "Rapamune"
        };

    bool IsAutomaticConditionRedFlag(
        string? conditionName)
    {
        return
            !string.IsNullOrWhiteSpace(
                conditionName
            )
            &&
            automaticRedFlagConditions.Contains(
                conditionName.Trim()
            );
    }

    bool IsAutomaticMedicationRedFlag(
        string? drugName)
    {
        return
            !string.IsNullOrWhiteSpace(
                drugName
            )
            &&
            automaticRedFlagMedicationNames.Contains(
                drugName.Trim()
            );
    }

    var conditionRedFlagNames =
        conditions?
            .Where(
                condition =>
                    condition.IsFlagged
                    ||
                    IsAutomaticConditionRedFlag(
                        condition.ConditionName
                    )
            )
            .Select(
                condition =>
                    condition.ConditionName
            )
            .Where(
                name =>
                    !string.IsNullOrWhiteSpace(
                        name
                    )
            )
            .Distinct(
                StringComparer.OrdinalIgnoreCase
            )
            .ToList()
        ??
        new List<string>();

    var medicationRedFlagNames =
        meds?
            .Where(
                medication =>
                    !string.IsNullOrWhiteSpace(
                        medication.FlagType
                    )
                    ||
                    IsAutomaticMedicationRedFlag(
                        medication.DrugName
                    )
            )
            .Select(
                medication =>
                    medication.DrugName
            )
            .Where(
                name =>
                    !string.IsNullOrWhiteSpace(
                        name
                    )
            )
            .Distinct(
                StringComparer.OrdinalIgnoreCase
            )
            .ToList()
        ??
        new List<string>();

    bool hasConditionRedFlags =
        conditionRedFlagNames.Any();

    bool hasMedicationRedFlags =
        medicationRedFlagNames.Any();

    string conditionRedFlagText =
        hasConditionRedFlags
            ? string.Join(
                ", ",
                conditionRedFlagNames
            )
            : "No condition red flags";

    string medicationRedFlagText =
        hasMedicationRedFlags
            ? string.Join(
                ", ",
                medicationRedFlagNames
            )
            : "No medication red flags";

    bool isVisitClosed =
        ViewBag.IsVisitClosed != null &&
        (bool)ViewBag.IsVisitClosed;

    string currentVisitAccessRole =
        Context.Session.GetString("UserRole") ?? "";

    bool isAdmin =
        string.Equals(
            currentVisitAccessRole,
            "Admin",
            StringComparison.OrdinalIgnoreCase
        );

    bool isFulltimeSupervisor =
        string.Equals(
            currentVisitAccessRole,
            "Fulltime Supervisor",
            StringComparison.OrdinalIgnoreCase
        );

    bool isParttimeSupervisor =
        string.Equals(
            currentVisitAccessRole,
            "Parttime Supervisor",
            StringComparison.OrdinalIgnoreCase
        );

    bool canEditCaseComplexity =
        isAdmin
        ||
        isFulltimeSupervisor
        ||
        isParttimeSupervisor;

    bool isReadOnly =
        isVisitClosed &&
        !isAdmin;

    string activeTab = Context.Request.Query["tab"].ToString();

    if (string.IsNullOrWhiteSpace(activeTab))
    {
        activeTab = "medical-history";
    }

    string complexity =
        ViewBag.CaseComplexity != null
            ? ViewBag.CaseComplexity.ToString()
            : "---";

    int treatmentProgressPercentage =
        ViewBag.TreatmentProgressPercentage != null
            ? Convert.ToInt32(
                ViewBag.TreatmentProgressPercentage
            )
            : 0;

    int completedCompetencies =
        ViewBag.CompletedCompetencies != null
            ? Convert.ToInt32(
                ViewBag.CompletedCompetencies
            )
            : 0;

    int totalCompetencies =
        ViewBag.TotalCompetencies != null
            ? Convert.ToInt32(
                ViewBag.TotalCompetencies
            )
            : 0;

    var nextAppt =
        ViewBag.NextAppointment
        as DentalCollegeManagementSystem_AAU.Models.Appointment;

    string nextAppointmentText =
        "No upcoming appointment";

    if (nextAppt != null)
    {
        string nextAppointmentTime =
            nextAppt.TimeFrom != default
                ? DateTime.Today
                    .Add(nextAppt.TimeFrom)
                    .ToString("hh:mm tt")
                : string.Empty;

        nextAppointmentText =
            nextAppt.AppointmentDate
                .ToString("dd/MM/yyyy");

        if (
            !string.IsNullOrWhiteSpace(
                nextAppointmentTime
            )
        )
        {
            nextAppointmentText +=
                " - " + nextAppointmentTime;
        }
    }

    string assignedStudentText =
        ViewBag.AssignedStudentText != null
            ? ViewBag.AssignedStudentText.ToString()
                ?? "No student assigned"
            : "No student assigned";

    var allAppts = ViewBag.AllAppointments
        as List<DentalCollegeManagementSystem_AAU.Models.Appointment>
        ?? new List<DentalCollegeManagementSystem_AAU.Models.Appointment>();

    int apptCount = allAppts.Count;

    /*
     * عدد الزيارات التي حضرها المريض حتى تاريخ اليوم.
     *
     * عند الدخول لأول مرة تكون النتيجة 1، لذلك لا يظهر Visit Review.
     * ابتداءً من الزيارة الثانية تصبح النتيجة 2 أو أكثر ويظهر القسم.
     */
    int attendedVisitCount =
        allAppts.Count(
            a =>
                a.AppointmentDate.Date <= DateTime.Today
                &&
                string.Equals(
                    a.AppointmentStatus,
                    "Attended",
                    StringComparison.OrdinalIgnoreCase
                )
        );

    bool showVisitReview =
        attendedVisitCount >= 2;

    string[] suffixes =
    {
        "th", "st", "nd", "rd", "th",
        "th", "th", "th", "th", "th"
    };

    string Ordinal(int n)
    {
        if (n % 100 >= 11 && n % 100 <= 13)
        {
            return n + "th";
        }

        return n + suffixes[n % 10];
    }

    string apptLabel =
        apptCount == 0
            ? "No appointments yet"
            : Ordinal(apptCount) + " Appointment";

    // حالة التبويب النشط
    string GetTabClass(string tab)
    {
        return activeTab == tab ? "tab-active" : "";
    }

    // إنشاء رابط التبويب
    string currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "Details";

    string currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "Patients";

    string TabUrl(string tab)
    {
        return Url.Action(
            currentAction,
            currentController,
            new
            {
                id = Model.PatientID,
                tab = tab
            }) ?? "#";
    }

    // فتح وإغلاق التبويبات
    bool tabsUnlocked =
        mh == null ||
        mh.MedicalHistoryVerified == true;

    string dentalDisabled =
        tabsUnlocked ? "" : "disabled-link";

    string dentalStyle =
        tabsUnlocked
            ? ""
            : "pointer-events:none; opacity:0.4; cursor:not-allowed;";
}

<link rel="stylesheet" href="~/css/Site.css" />
<link rel="stylesheet" href="~/css/all.min.css" />
<link rel="stylesheet" href="~/css/RTE.css" />

<style>

    .details-wrapper {
        padding: 30px 20px;
        max-width: 900px;
        margin: 0 auto;
    }

    .edit-link {
        text-align: right;
        margin-bottom: 8px;
    }

