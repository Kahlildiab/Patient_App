@model DentalCollegeManagementSystem_AAU.Models.Patient
@using DentalCollegeManagementSystem_AAU.Models

@{
    var radiographs =
        ViewBag.Radiographs as List<Radiograph>
        ?? new List<Radiograph>();

    bool visitClosedForAccess =
        ViewBag.IsVisitClosed != null
        &&
        (bool)ViewBag.IsVisitClosed;

    string visitRoleForAccess =
        Context.Session.GetString("UserRole")
        ?? "";

    bool adminCanEditClosedVisit =
        string.Equals(
            visitRoleForAccess,
            "Admin",
            StringComparison.OrdinalIgnoreCase
        );

    bool pageReadOnly =
        visitClosedForAccess
        &&
        !adminCanEditClosedVisit;

    var periapicalUpperSlots = new[]
    {
        new { Code = "UR_MOLAR_PA", Label = "UR Molar" },
        new { Code = "UR_PREMOLAR_PA", Label = "UR Premolar" },
        new { Code = "UR_ANTERIOR_PA", Label = "UR Anterior" },
        new { Code = "UPPER_CENTRAL_PA", Label = "Upper Central" },
        new { Code = "UL_ANTERIOR_PA", Label = "UL Anterior" },
        new { Code = "UL_PREMOLAR_PA", Label = "UL Premolar" },
        new { Code = "UL_MOLAR_PA", Label = "UL Molar" }
    };

    var periapicalLowerSlots = new[]
    {
        new { Code = "LR_MOLAR_PA", Label = "LR Molar" },
        new { Code = "LR_PREMOLAR_PA", Label = "LR Premolar" },
        new { Code = "LR_ANTERIOR_PA", Label = "LR Anterior" },
        new { Code = "LOWER_CENTRAL_PA", Label = "Lower Central" },
        new { Code = "LL_ANTERIOR_PA", Label = "LL Anterior" },
        new { Code = "LL_PREMOLAR_PA", Label = "LL Premolar" },
        new { Code = "LL_MOLAR_PA", Label = "LL Molar" }
    };

    var bitewingSlots = new[]
    {
        new { Code = "RIGHT_MOLAR_BW", Label = "Right Molar" },
        new { Code = "RIGHT_PREMOLAR_BW", Label = "Right Premolar" },
        new { Code = "LEFT_PREMOLAR_BW", Label = "Left Premolar" },
        new { Code = "LEFT_MOLAR_BW", Label = "Left Molar" }
    };

    var radiographByStoredType =
        radiographs
            .Where(r =>
                !string.IsNullOrWhiteSpace(
                    r.RadiographType
                )
            )
            .GroupBy(
                r => r.RadiographType.Trim(),
                StringComparer.OrdinalIgnoreCase
            )
            .ToDictionary(
                group => group.Key,
                group => group
                    .OrderByDescending(r => r.UploadedDate)
                    .First(),
                StringComparer.OrdinalIgnoreCase
            );
}

@functions {
    string DisplayRadiographType(string? storedType)
    {
        if (string.IsNullOrWhiteSpace(storedType))
        {
            return "General";
        }

        string[] parts = storedType.Split('|');

        if (parts.Length != 2)
        {
            return parts[0];
        }

        string slotName =
            parts[1]
                .Replace("_PA", "")
                .Replace("_BW", "")
                .Replace("_", " ");

        return $"{parts[0]} — {slotName}";
    }
}

<style>
    :root {
        --rad-navy: #1a237e;
        --rad-navy-2: #283593;
        --rad-border: #d6dce8;
        --rad-soft: #f8f9ff;
        --rad-gold: #daa328;
    }

    .rad-section {
        background: #fff;
        border: 1.5px solid var(--rad-border);
        border-radius: 12px;
        padding: 20px 22px;
        margin-bottom: 22px;
    }

    .rad-section-title {
        color: var(--rad-navy);
        font-size: 1rem;
        font-weight: 800;
        margin-bottom: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .rad-count {
        min-width: 30px;
        padding: 3px 10px;
        border-radius: 20px;
        background: #e8eaf6;
        color: var(--rad-navy);
        text-align: center;
        font-size: .72rem;
        font-weight: 800;
    }

    .rad-series-note {
        margin-bottom: 16px;
        padding: 10px 13px;
        border-left: 4px solid var(--rad-gold);
        background: #fffaf0;
        color: #66501b;
        font-size: .8rem;
        line-height: 1.55;
    }

    .rad-type-row {
        display: grid;
        grid-template-columns: minmax(250px, 360px) 1fr;
        gap: 16px;
        align-items: end;
        margin-bottom: 18px;
    }

    .rad-label {
        display: block;
        margin-bottom: 6px;
        color: #30364f;
        font-size: .8rem;
        font-weight: 800;
    }

    .rad-select {
        width: 100%;
        height: 42px;
        padding: 0 12px;
        border: 1.5px solid #b9c2df;
        border-radius: 7px;
        background: #fff;
        color: var(--rad-navy);
        font-size: .84rem;
        font-weight: 700;
    }

        .rad-select:focus {
            outline: none;
            border-color: var(--rad-navy);
            box-shadow: 0 0 0 3px rgba(26,35,126,.10);
        }

    .rad-help {
        min-height: 42px;
        padding: 9px 13px;
        border: 1px solid #e2e6f0;
        border-radius: 7px;
        background: #fafbff;
        color: #687083;
        font-size: .79rem;
        display: flex;
        align-items: center;
    }

    .rad-template,
    .rad-normal-upload {
        display: none;
    }

        .rad-template.active,
        .rad-normal-upload.active {
            display: block;
        }

    .rad-template-title {
        margin-bottom: 10px;
        color: var(--rad-navy);
        font-size: .88rem;
        font-weight: 800;
    }

    .rad-arch-title {
        margin: 13px 0 7px;
        color: #777e8f;
        font-size: .7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .rad-slot-grid {
        display: grid;
        gap: 10px;
    }

        .rad-slot-grid.periapical {
            grid-template-columns: repeat(7, minmax(110px, 1fr));
        }

        .rad-slot-grid.bitewing {
            grid-template-columns: repeat(4, minmax(150px, 1fr));
            max-width: 860px;
            margin: 0 auto;
        }

    .rad-slot {
        position: relative;
        min-width: 0;
        border: 1px solid #d9dde7;
        border-radius: 9px;
        background: #fff;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(26,35,126,.04);
    }

    .rad-slot-header {
        min-height: 40px;
        padding: 7px 8px;
        border-bottom: 1px solid #eceef4;
        color: var(--rad-navy);
        font-size: .68rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
    }

    .rad-slot-number {
        min-width: 21px;
        height: 21px;
        padding: 0 5px;
        border-radius: 20px;
        background: #edf0ff;
        color: var(--rad-navy);
        font-size: .62rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .rad-slot-body {
        position: relative;
        height: 140px;
        background: #fbfbfd;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .rad-slot-body img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            cursor: pointer;
        }

    .rad-slot-empty {
        width: calc(100% - 16px);
        height: calc(100% - 16px);
        border: 1.5px dashed #bcc2ce;
        border-radius: 7px;
        color: #999fad;
        padding: 8px;
        text-align: center;
        font-size: .64rem;
        line-height: 1.35;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .rad-slot-empty svg {
            margin-bottom: 5px;
        }

    .rad-slot-footer {
        padding: 8px;
        border-top: 1px solid #eceef4;
    }

    .rad-slot-upload {
        width: 100%;
        min-height: 31px;
        border-radius: 5px;
        background: var(--rad-navy);
        color: #fff;
        font-size: .67rem;
        font-weight: 800;
        cursor: pointer;
        padding: 6px 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

        .rad-slot-upload:hover {
            background: var(--rad-navy-2);
        }

    .rad-slot-delete,
    .rad-gallery-delete {
        position: absolute;
        width: 25px;
        height: 25px;
        border: 0;
        border-radius: 50%;
        background: rgba(192,57,43,.9);
        color: #fff;
        cursor: pointer;
        z-index: 4;
    }

    .rad-slot-delete {
        top: 47px;
        right: 6px;
    }

    .rad-normal-upload {
        border: 2px dashed #c5cad5;
        border-radius: 9px;
        padding: 32px 20px;
        text-align: center;
        cursor: pointer;
    }

        .rad-normal-upload:hover {
            border-color: var(--rad-navy);
            background: #f8f8ff;
        }

        .rad-normal-upload p {
            margin: 7px 0 12px;
            color: #888f9e;
            font-size: .82rem;
        }

    .rad-normal-button {
        border: 0;
        border-radius: 5px;
        background: var(--rad-navy);
        color: #fff;
        padding: 8px 20px;
        font-size: .8rem;
        font-weight: 700;
    }

    .rad-status {
        min-height: 20px;
        margin-top: 10px;
        font-size: .8rem;
    }

    .rad-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
        gap: 14px;
    }

    .rad-gallery-card {
        position: relative;
        border: 1px solid #dfe2ea;
        border-radius: 8px;
        background: #fff;
        overflow: hidden;
    }

    .rad-gallery-image {
        height: 135px;
        background: #f5f5f7;
        overflow: hidden;
    }

        .rad-gallery-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            cursor: pointer;
            transition: transform .18s;
        }

    .rad-gallery-card:hover img {
        transform: scale(1.04);
    }

    .rad-gallery-delete {
        top: 5px;
        right: 5px;
    }

    .rad-gallery-info {
        padding: 8px 9px;
    }

    .rad-gallery-type,
    .rad-gallery-file,
    .rad-gallery-date {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .rad-gallery-type {
        color: #1565c0;
        font-size: .67rem;
        font-weight: 800;
    }

    .rad-gallery-file,
    .rad-gallery-date {
        margin-top: 3px;
        color: #7d8493;
        font-size: .62rem;
    }

    .rad-empty {
        color: #a2a7b2;
        font-size: .82rem;
        font-style: italic;
    }

    #radLightbox {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: rgba(0,0,0,.88);
        align-items: center;
        justify-content: center;
    }

        #radLightbox.open {
            display: flex;
        }

        #radLightbox img {
            max-width: 92vw;
            max-height: 90vh;
            border-radius: 8px;
        }

    .rad-lightbox-close {
        position: absolute;
        top: 18px;
        right: 23px;
        border: 0;
        background: transparent;
        color: #fff;
        font-size: 32px;
        cursor: pointer;
    }

    #radiographsReadOnlyRoot.closed-visit-readonly input:disabled,
    #radiographsReadOnlyRoot.closed-visit-readonly select:disabled {
        opacity: 1 !important;
        color: #333 !important;
        background: #f7f7f7 !important;
    }

    #radiographsReadOnlyRoot.closed-visit-readonly .readonly-disabled-action {
        opacity: .45 !important;
        pointer-events: none !important;
        cursor: not-allowed !important;
    }

    @@media (max-width: 1200px) {
        .rad-slot-grid.periapical {
            grid-template-columns: repeat(4, minmax(120px, 1fr));
        }
    }

    @@media (max-width: 800px) {
        .rad-type-row {
            grid-template-columns: 1fr;
        }

        .rad-slot-grid.periapical,
        .rad-slot-grid.bitewing {
            grid-template-columns: repeat(2, minmax(130px, 1fr));
        }
    }

    @@media (max-width: 480px) {
        .rad-section {
            padding: 16px 12px;
        }

        .rad-slot-grid.periapical,
        .rad-slot-grid.bitewing {
            grid-template-columns: 1fr;
        }
    }
</style>

<div id="radiographsReadOnlyRoot"
     class="@(pageReadOnly ? "closed-visit-readonly" : "")">

    <div class="rad-section">
        <div class="rad-section-title">
            <span>Upload Radiograph</span>
        </div>

        <div class="rad-series-note">
            Full Mouth Series contains
            <strong>18 images</strong>:
            <strong>14 Periapical</strong> and
            <strong>4 Bitewing</strong>.
            The first two Radiograph Types now open dedicated templates.
        </div>

        <div class="rad-type-row">
            <div>
                <label class="rad-label"
                       for="radType">
                    Radiograph Type
                </label>

                <select id="radType"
                        class="rad-select"
                        onchange="changeRadiographMode()">

                    <option value="Periapical">
                        Periapical Template — 14 Images
                    </option>

                    <option value="Bitewing">
                        Bitewing Template — 4 Images
                    </option>

                    <option value="Panoramic">
                        Panoramic
                    </option>

                    <option value="Occlusal">
                        Occlusal
                    </option>

                    <option value="Cephalometric">
                        Cephalometric
                    </option>
                    <option value="CBCT">
                        CBCT
                    </option>
                </select>
            </div>

            <div id="radHelp"
                 class="rad-help">
                Upload every Periapical image in its correct anatomical position.
            </div>
        </div>

        <!-- PERIAPICAL TEMPLATE: 14 IMAGES -->
        <div id="periapicalTemplate"
             class="rad-template active">

            <div class="rad-template-title">
                Periapical Template — 14 Positions
            </div>

            <div class="rad-arch-title">
                Maxillary / Upper Arch
            </div>

            <div class="rad-slot-grid periapical">
                @{
                    int positionNumber = 0;
                }

                @foreach (var slot in periapicalUpperSlots)
                {
                    positionNumber++;

                    string storedType =
                        $"Periapical|{slot.Code}";

                    radiographByStoredType.TryGetValue(
                        storedType,
                        out Radiograph? existing
                    );

                    <div class="rad-slot"
                         id="slot_@slot.Code">

                        <div class="rad-slot-header">
                            <span>@slot.Label</span>
                            <span class="rad-slot-number">
                                @positionNumber
                            </span>
                        </div>

                        <div class="rad-slot-body">
                            @if (existing != null)
                            {
                                <img src="@existing.PhotoPath"
                                     alt="@slot.Label"
                                     onclick="openRadLightbox('@existing.PhotoPath')" />

                                <button type="button"
                                        class="rad-slot-delete"
                                        onclick="deleteRadiograph(@existing.RadiographID, event)"
                                        title="Delete">
                                    ✕
                                </button>
                            }
                            else
                            {
                                <div class="rad-slot-empty">
                                    <svg width="29"
                                         height="29"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                        <polyline points="17 8 12 3 7 8" />
                                        <line x1="12" y1="3" x2="12" y2="15" />
                                    </svg>

                                    <span>
                                        Upload @slot.Label Periapical
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="rad-slot-footer">
                            <label class="rad-slot-upload"
                                   for="file_@slot.Code">
                                @(existing == null
                                    ? "Choose File"
                                    : "Replace Image")
                            </label>

                            <input type="file"
                                   id="file_@slot.Code"
                                   accept="image/jpeg,image/png,image/jpg"
                                   data-radiograph-type="Periapical"
                                   data-template-slot="@slot.Code"
                                   data-slot-label="@slot.Label Periapical"
                                   onchange="uploadTemplateRadiograph(this)"
                                   style="display:none;" />
                        </div>
                    </div>
                }
            </div>

            <div class="rad-arch-title">
                Mandibular / Lower Arch
            </div>

            <div class="rad-slot-grid periapical">
                @foreach (var slot in periapicalLowerSlots)
                {
                    positionNumber++;

                    string storedType =
                        $"Periapical|{slot.Code}";

                    radiographByStoredType.TryGetValue(
                        storedType,
                        out Radiograph? existing
                    );

                    <div class="rad-slot"
                         id="slot_@slot.Code">

                        <div class="rad-slot-header">
                            <span>@slot.Label</span>
                            <span class="rad-slot-number">
                                @positionNumber
                            </span>
                        </div>

                        <div class="rad-slot-body">
                            @if (existing != null)
                            {
                                <img src="@existing.PhotoPath"
                                     alt="@slot.Label"
                                     onclick="openRadLightbox('@existing.PhotoPath')" />

                                <button type="button"
                                        class="rad-slot-delete"
                                        onclick="deleteRadiograph(@existing.RadiographID, event)"
                                        title="Delete">
                                    ✕
                                </button>
                            }
                            else
                            {
                                <div class="rad-slot-empty">
                                    <svg width="29"
                                         height="29"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                        <polyline points="17 8 12 3 7 8" />
                                        <line x1="12" y1="3" x2="12" y2="15" />
                                    </svg>

                                    <span>
                                        Upload @slot.Label Periapical
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="rad-slot-footer">
                            <label class="rad-slot-upload"
                                   for="file_@slot.Code">
                                @(existing == null
                                    ? "Choose File"
                                    : "Replace Image")
                            </label>

                            <input type="file"
                                   id="file_@slot.Code"
                                   accept="image/jpeg,image/png,image/jpg"
                                   data-radiograph-type="Periapical"
                                   data-template-slot="@slot.Code"
                                   data-slot-label="@slot.Label Periapical"
                                   onchange="uploadTemplateRadiograph(this)"
                                   style="display:none;" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- BITEWING TEMPLATE: 4 IMAGES -->
        <div id="bitewingTemplate"
             class="rad-template">

            <div class="rad-template-title">
                Bitewing Template — 4 Positions
            </div>

            <div class="rad-slot-grid bitewing">
                @{
                    int bitewingNumber = 0;
                }

                @foreach (var slot in bitewingSlots)
                {
                    bitewingNumber++;

                    string storedType =
                        $"Bitewing|{slot.Code}";

                    radiographByStoredType.TryGetValue(
                        storedType,
                        out Radiograph? existing
                    );

                    <div class="rad-slot"
                         id="slot_@slot.Code">

                        <div class="rad-slot-header">
                            <span>@slot.Label</span>
                            <span class="rad-slot-number">
                                @bitewingNumber
                            </span>
                        </div>

                        <div class="rad-slot-body">
                            @if (existing != null)
                            {
                                <img src="@existing.PhotoPath"
                                     alt="@slot.Label"
                                     onclick="openRadLightbox('@existing.PhotoPath')" />

                                <button type="button"
                                        class="rad-slot-delete"
                                        onclick="deleteRadiograph(@existing.RadiographID, event)"
                                        title="Delete">
                                    ✕
                                </button>
                            }
                            else
                            {
                                <div class="rad-slot-empty">
                                    <svg width="29"
                                         height="29"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                        <polyline points="17 8 12 3 7 8" />
                                        <line x1="12" y1="3" x2="12" y2="15" />
                                    </svg>

                                    <span>
                                        Upload @slot.Label Bitewing
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="rad-slot-footer">
                            <label class="rad-slot-upload"
                                   for="file_@slot.Code">
                                @(existing == null
                                    ? "Choose File"
                                    : "Replace Image")
                            </label>

                            <input type="file"
                                   id="file_@slot.Code"
                                   accept="image/jpeg,image/png,image/jpg"
                                   data-radiograph-type="Bitewing"
                                   data-template-slot="@slot.Code"
                                   data-slot-label="@slot.Label Bitewing"
                                   onchange="uploadTemplateRadiograph(this)"
                                   style="display:none;" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- NORMAL UPLOAD FOR THE OTHER THREE TYPES -->
        <div id="normalUploadZone"
             class="rad-normal-upload"
             onclick="document.getElementById('normalRadFile').click()">

            <svg width="40"
                 height="40"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="#aaa"
                 stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="17 8 12 3 7 8" />
                <line x1="12" y1="3" x2="12" y2="15" />
            </svg>

            <p>
                Click or drag and drop to upload radiograph
            </p>

            <button type="button"
                    class="rad-normal-button">
                Choose File
            </button>

            <input type="file"
                   id="normalRadFile"
                   accept="image/jpeg,image/png,image/jpg"
                   multiple
                   onchange="uploadNormalRadiographs(this)"
                   style="display:none;" />
        </div>

        <div id="radUploadStatus"
             class="rad-status"></div>
    </div>

    <!-- GALLERY -->
    <div class="rad-section">
        <div class="rad-section-title">
            <span>All Radiographs</span>

            <span id="radCount"
                  class="rad-count">
                @radiographs.Count
            </span>
        </div>

        @if (!radiographs.Any())
        {
            <p id="radEmpty"
               class="rad-empty">
                No radiographs uploaded yet.
            </p>
        }

        <div id="radGallery"
             class="rad-gallery">

            @foreach (
                var radiograph
                in radiographs.OrderByDescending(
                    r => r.UploadedDate
                )
            )
            {
                <div id="rad_@radiograph.RadiographID"
                     class="rad-gallery-card">

                    <div class="rad-gallery-image">
                        <img src="@radiograph.PhotoPath"
                             alt="@DisplayRadiographType(radiograph.RadiographType)"
                             onclick="openRadLightbox('@radiograph.PhotoPath')" />
                    </div>

                    <button type="button"
                            class="rad-gallery-delete"
                            onclick="deleteRadiograph(@radiograph.RadiographID, event)"
                            title="Delete">
                        ✕
                    </button>

                    <div class="rad-gallery-info">
                        <span class="rad-gallery-type">
                            @DisplayRadiographType(
                                radiograph.RadiographType
                            )
                        </span>

                        <span class="rad-gallery-file">
                            @radiograph.FileName
                        </span>

                        <span class="rad-gallery-date">
                            @radiograph.UploadedDate.ToString(
                                "dd/MM/yyyy HH:mm"
                            )
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- LIGHTBOX -->
    <div id="radLightbox"
         onclick="closeRadLightbox()">

        <button type="button"
                class="rad-lightbox-close"
                onclick="closeRadLightbox()">
            ✕
        </button>

        <img id="radLightboxImage"
             src=""
             alt="Radiograph Preview" />
    </div>

    @Html.AntiForgeryToken()
</div>

<script>
    const RAD_PATIENT_ID =
        @Model.PatientID;

    const RAD_TOKEN =
        document.querySelector(
            'input[name="__RequestVerificationToken"]'
        )?.value ?? '';

    function changeRadiographMode() {
        const type =
            document.getElementById(
                'radType'
            ).value;

        const periapical =
            document.getElementById(
                'periapicalTemplate'
            );

        const bitewing =
            document.getElementById(
                'bitewingTemplate'
            );

        const normal =
            document.getElementById(
                'normalUploadZone'
            );

        const help =
            document.getElementById(
                'radHelp'
            );

        periapical.classList.remove('active');
        bitewing.classList.remove('active');
        normal.classList.remove('active');

        if (type === 'Periapical') {
            periapical.classList.add('active');

            help.textContent =
                'Upload every Periapical image in its correct anatomical position.';
        }
        else if (type === 'Bitewing') {
            bitewing.classList.add('active');

            help.textContent =
                'Upload the four Bitewing images in their correct right and left positions.';
        }
        else {
            normal.classList.add('active');

            help.textContent =
                `Upload one or more ${type} radiograph images.`;
        }
    }

    function openRadLightbox(path) {
        document.getElementById(
            'radLightboxImage'
        ).src = path;

        document.getElementById(
            'radLightbox'
        ).classList.add('open');
    }

    function closeRadLightbox() {
        document.getElementById(
            'radLightbox'
        ).classList.remove('open');
    }

    function validateRadFile(file) {
        if (!file) {
            return 'No file selected.';
        }

        const allowed =
            [
                'image/jpeg',
                'image/png',
                'image/jpg'
            ];

        if (!allowed.includes(file.type)) {
            return 'Only JPG or PNG files are supported.';
        }

        if (file.size > 10 * 1024 * 1024) {
            return 'Maximum file size is 10MB.';
        }

        return '';
    }

    function uploadTemplateRadiograph(input) {
        if (!input.files || input.files.length === 0) {
            return;
        }

        const file =
            input.files[0];

        const error =
            validateRadFile(file);

        if (error) {
            setRadStatus(error, false);
            input.value = '';
            return;
        }

        uploadOneRadiograph(
            file,
            input.dataset.radiographType,
            input.dataset.templateSlot,
            input.dataset.slotLabel,
            input
        );
    }

    function uploadNormalRadiographs(input) {
        if (!input.files || input.files.length === 0) {
            return;
        }

        const type =
            document.getElementById(
                'radType'
            ).value;

        Array.from(input.files).forEach(
            file => {
                const error =
                    validateRadFile(file);

                if (error) {
                    setRadStatus(
                        `${file.name}: ${error}`,
                        false
                    );

                    return;
                }

                uploadOneRadiograph(
                    file,
                    type,
                    '',
                    type,
                    null
                );
            }
        );

        input.value = '';
    }

    function uploadOneRadiograph(
        file,
        radiographType,
        templateSlot,
        displayType,
        sourceInput
    ) {
        setRadStatus(
            `Uploading ${file.name}...`,
            true
        );

        const data =
            new FormData();

        data.append(
            'patientId',
            RAD_PATIENT_ID
        );

        data.append(
            'photo',
            file
        );

        data.append(
            'radiographType',
            radiographType
        );

        data.append(
            'templateSlot',
            templateSlot || ''
        );

        data.append(
            '__RequestVerificationToken',
            RAD_TOKEN
        );

        fetch(
            '/Radiographs/Upload',
            {
                method: 'POST',
                body: data
            }
        )
        .then(response => response.json())
        .then(result => {
            if (!result.success) {
                setRadStatus(
                    result.message || 'Upload failed.',
                    false
                );

                return;
            }

            if (result.replacedPhotoId) {
                document.getElementById(
                    `rad_${result.replacedPhotoId}`
                )?.remove();

                document.getElementById(
                    `ph_rad_${result.replacedPhotoId}`
                )?.remove();
            }

            if (templateSlot) {
                updateTemplateSlot(
                    result,
                    templateSlot,
                    displayType
                );
            }

            addGalleryCard(result);
            refreshRadCount();

            setRadStatus(
                `${file.name} uploaded successfully.`,
                true
            );

            if (typeof showToast === 'function') {
                showToast(
                    'Radiograph uploaded.',
                    'success'
                );
            }
        })
        .catch(() => {
            setRadStatus(
                'Upload failed. Please try again.',
                false
            );
        })
        .finally(() => {
            if (sourceInput) {
                sourceInput.value = '';
            }
        });
    }

    function updateTemplateSlot(
        result,
        templateSlot,
        displayType
    ) {
        const slot =
            document.getElementById(
                `slot_${templateSlot}`
            );

        if (!slot) {
            return;
        }

        const body =
            slot.querySelector(
                '.rad-slot-body'
            );

        body.innerHTML = `
            <img src="${escapeAttribute(result.photoPath)}"
                 alt="${escapeAttribute(displayType)}"
                 onclick="openRadLightbox('${escapeJs(result.photoPath)}')" />

            <button type="button"
                    class="rad-slot-delete"
                    onclick="deleteRadiograph(${result.photoId}, event)"
                    title="Delete">
                ✕
            </button>
        `;

        slot.querySelector(
            '.rad-slot-upload'
        ).textContent =
            'Replace Image';
    }

    function addGalleryCard(result) {
        document.getElementById(
            'radEmpty'
        )?.remove();

        const gallery =
            document.getElementById(
                'radGallery'
            );

        document.getElementById(
            `rad_${result.photoId}`
        )?.remove();

        const card =
            document.createElement('div');

        card.id =
            `rad_${result.photoId}`;

        card.className =
            'rad-gallery-card';

        card.innerHTML = `
            <div class="rad-gallery-image">
                <img src="${escapeAttribute(result.photoPath)}"
                     alt="${escapeAttribute(result.displayType)}"
                     onclick="openRadLightbox('${escapeJs(result.photoPath)}')" />
            </div>

            <button type="button"
                    class="rad-gallery-delete"
                    onclick="deleteRadiograph(${result.photoId}, event)"
                    title="Delete">
                ✕
            </button>

            <div class="rad-gallery-info">
                <span class="rad-gallery-type">
                    ${escapeHtml(result.displayType)}
                </span>

                <span class="rad-gallery-file">
                    ${escapeHtml(result.fileName)}
                </span>

                <span class="rad-gallery-date">
                    ${escapeHtml(result.uploadedDate)}
                </span>
            </div>
        `;

        gallery.prepend(card);
    }

    function deleteRadiograph(
        photoId,
        event
    ) {
        if (event) {
            event.stopPropagation();
        }

        if (!confirm('Delete this radiograph?')) {
            return;
        }

        const data =
            new FormData();

        data.append(
            'photoId',
            photoId
        );

        data.append(
            'patientId',
            RAD_PATIENT_ID
        );

        data.append(
            '__RequestVerificationToken',
            RAD_TOKEN
        );

        fetch(
            '/Radiographs/Delete',
            {
                method: 'POST',
                body: data
            }
        )
        .then(response => response.json())
        .then(result => {
            if (!result.success) {
                setRadStatus(
                    result.message || 'Delete failed.',
                    false
                );

                return;
            }

            document.getElementById(
                `rad_${photoId}`
            )?.remove();

            document.getElementById(
                `ph_rad_${photoId}`
            )?.remove();

            if (result.templateSlot) {
                clearTemplateSlot(
                    result.templateSlot
                );
            }

            refreshRadCount();
            setRadStatus(
                'Radiograph deleted.',
                true
            );
        })
        .catch(() => {
            setRadStatus(
                'Server error while deleting.',
                false
            );
        });
    }

    function clearTemplateSlot(templateSlot) {
        const slot =
            document.getElementById(
                `slot_${templateSlot}`
            );

        if (!slot) {
            return;
        }

        const input =
            slot.querySelector(
                'input[type="file"]'
            );

        const label =
            input?.dataset.slotLabel
            ?? 'Radiograph';

        slot.querySelector(
            '.rad-slot-body'
        ).innerHTML = `
            <div class="rad-slot-empty">
                <svg width="29"
                     height="29"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>

                <span>
                    Upload ${escapeHtml(label)}
                </span>
            </div>
        `;

        slot.querySelector(
            '.rad-slot-upload'
        ).textContent =
            'Choose File';
    }

    function refreshRadCount() {
        const gallery =
            document.getElementById(
                'radGallery'
            );

        const count =
            gallery.querySelectorAll(
                '.rad-gallery-card'
            ).length;

        document.getElementById(
            'radCount'
        ).textContent =
            count;

        if (
            count === 0
            &&
            !document.getElementById(
                'radEmpty'
            )
        ) {
            const empty =
                document.createElement('p');

            empty.id =
                'radEmpty';

            empty.className =
                'rad-empty';

            empty.textContent =
                'No radiographs uploaded yet.';

            gallery.before(empty);
        }
    }

    function setRadStatus(
        message,
        success
    ) {
        const status =
            document.getElementById(
                'radUploadStatus'
            );

        status.textContent =
            `${success ? '✅' : '❌'} ${message}`;

        status.style.color =
            success
                ? '#2e7d32'
                : '#c0392b';
    }

    function escapeHtml(value) {
        const element =
            document.createElement('div');

        element.textContent =
            value ?? '';

        return element.innerHTML;
    }

    function escapeAttribute(value) {
        return escapeHtml(value)
            .replace(/"/g, '&quot;');
    }

    function escapeJs(value) {
        return String(value ?? '')
            .replace(/\\/g, '\\\\')
            .replace(/'/g, "\\'");
    }

    document.addEventListener(
        'DOMContentLoaded',
        function () {
            changeRadiographMode();

            const normalZone =
                document.getElementById(
                    'normalUploadZone'
                );

            normalZone.addEventListener(
                'dragover',
                function (event) {
                    event.preventDefault();
                    normalZone.style.borderColor =
                        '#1a237e';
                }
            );

            normalZone.addEventListener(
                'dragleave',
                function () {
                    normalZone.style.borderColor =
                        '#c5cad5';
                }
            );

            normalZone.addEventListener(
                'drop',
                function (event) {
                    event.preventDefault();

                    normalZone.style.borderColor =
                        '#c5cad5';

                    const input =
                        document.getElementById(
                            'normalRadFile'
                        );

                    const transfer =
                        new DataTransfer();

                    Array.from(
                        event.dataTransfer.files
                    ).forEach(
                        file => transfer.items.add(file)
                    );

                    input.files =
                        transfer.files;

                    uploadNormalRadiographs(
                        input
                    );
                }
            );

            const pageReadOnly =
                @pageReadOnly.ToString().ToLower();

            const root =
                document.getElementById(
                    'radiographsReadOnlyRoot'
                );

            if (pageReadOnly && root) {
                root.classList.add(
                    'closed-visit-readonly'
                );

                root.querySelectorAll(
                    'input:not([type="hidden"]), select'
                ).forEach(
                    element => {
                        element.disabled = true;
                    }
                );

                root.querySelectorAll(
                    '.rad-slot-upload, .rad-slot-delete, .rad-gallery-delete, .rad-normal-upload'
                ).forEach(
                    element => {
                        element.classList.add(
                            'readonly-disabled-action'
                        );
                    }
                );
            }
        }
    );
</script>
