<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>

    /* =============================================
    المواعيد المتاحة

    صباحاً = 09:00 فقط
    مساءً  = 13:00 فقط

    لا توجد قائمة بأربع ساعات.
    اختيار الفترة يحدد الوقت تلقائياً.
    =============================================== */

    const BOOKING_START_DATE =
    "2026-07-26";

    const DEFAULT_APPOINTMENTS = {

    AM: {
    value: "09:00",
    label: "09:00 صباحاً"
    },

    PM: {
    value: "13:00",
    label: "01:00 مساءً"
    }

    };

    /*
    * true  = الموعد متاح
    * false = الموعد ممتلئ
    */
    let slotAvailability = {};

    let isWholeDayFull =
    false;

    let isSelectedSlotFull =
    false;

    function getAllDefaultAppointments() {

    return [
    DEFAULT_APPOINTMENTS.AM,
    DEFAULT_APPOINTMENTS.PM
    ];
    }

    function setSubmitDisabled(
    disabled
    ) {

    const button =
    document.getElementById(
    "submitBtn"
    );

    button.disabled =
    disabled;

    button.style.opacity =
    disabled
    ? "0.6"
    : "1";
    }

    function updateSubmitButtonState() {

    setSubmitDisabled(
    isWholeDayFull
    ||
    isSelectedSlotFull
    );
    }

    function hideCapacityMessages() {

    document.getElementById(
    "capacityWarning"
    ).classList.add(
    "d-none"
    );

    document.getElementById(
    "dayCapacityWarning"
    ).classList.add(
    "d-none"
    );
    }

    function clearSelectedAppointment() {

    document.getElementById(
    "AppointmentTimeHidden"
    ).value = "";

    document.getElementById(
    "selectedTimeText"
    ).textContent = "—";

    document.getElementById(
    "selectedTimeRow"
    ).style.display = "none";

    document.querySelectorAll(
    'input[name="TimePeriod"]'
    ).forEach(
    function (radio) {

    radio.checked = false;
    radio.disabled = false;
    }
    );

    isSelectedSlotFull =
    false;

    updateSubmitButtonState();
    }

    /*
    * اختيار صباحاً أو مساءً:
    *
    * AM يضع 09:00 تلقائياً.
    * PM يضع 13:00 تلقائياً.
    */
    async function selectDefaultAppointment(
    period
    ) {

    const date =
    document.getElementById(
    "appointmentDatePicker"
    ).value;

    const selectedAppointment =
    DEFAULT_APPOINTMENTS[
    period
    ];

    const hiddenInput =
    document.getElementById(
    "AppointmentTimeHidden"
    );

    const selectedTimeText =
    document.getElementById(
    "selectedTimeText"
    );

    const selectedTimeRow =
    document.getElementById(
    "selectedTimeRow"
    );

    const warning =
    document.getElementById(
    "capacityWarning"
    );

    warning.classList.add(
    "d-none"
    );

    isSelectedSlotFull =
    false;

    if (!date) {

    hiddenInput.value = "";

    selectedTimeRow.style.display =
    "none";

    alert(
    "يرجى اختيار تاريخ الموعد أولاً."
    );

    const selectedRadio =
    document.querySelector(
    'input[name="TimePeriod"]:checked'
    );

    if (selectedRadio) {
    selectedRadio.checked = false;
    }

    return;
    }

    hiddenInput.value =
    selectedAppointment.value;

    selectedTimeText.textContent =
    selectedAppointment.label;

    selectedTimeRow.style.removeProperty(
    "display"
    );

    /*
    * إذا كانت نتيجة فحص اليوم تؤكد أن الموعد ممتلئ،
    * نظهر الرسالة مباشرة.
    */
    if (
    slotAvailability[
    selectedAppointment.value
    ] === false
    ) {

    warning.textContent =
    "⚠️ هذا الموعد ممتلئ (10/10). "
    +
    "يرجى اختيار الفترة الأخرى أو يوماً آخر.";

    warning.classList.remove(
    "d-none"
    );

    hiddenInput.value = "";

    isSelectedSlotFull =
    true;

    updateSubmitButtonState();

    return;
    }

    updateSubmitButtonState();

    await checkCapacity();
    }

    /* =============================================
    فحص الموعدين الافتراضيين لليوم

    09:00 و13:00 فقط
    =============================================== */

    async function checkDayAvailability() {

    const date =
    document.getElementById(
    "appointmentDatePicker"
    ).value;

    const dayWarning =
    document.getElementById(
    "dayCapacityWarning"
    );

    slotAvailability = {};

    isWholeDayFull =
    false;

    isSelectedSlotFull =
    false;

    hideCapacityMessages();

    updateSubmitButtonState();

    if (!date) {
    return;
    }

    try {

    const results =
    await Promise.all(

    getAllDefaultAppointments()
    .map(
    async function (
    appointment
    ) {

    const response =
    await fetch(
    `/Patients/CheckSlot?date=${encodeURIComponent(date)}&time=${encodeURIComponent(appointment.value)}`,
    {
    cache: "no-store"
    }
    );

    if (!response.ok) {

    throw new Error(
    "تعذر فحص الموعد"
    );
    }

    const data =
    await response.json();

    return {
    value:
    appointment.value,

    available:
    data.available === true
    };
    }
    )
    );

    results.forEach(
    function (
    result
    ) {

    slotAvailability[
    result.value
    ] =
    result.available;
    }
    );

    isWholeDayFull =
    results.every(
    function (
    result
    ) {

    return (
    result.available
    === false
    );
    }
    );

    const morningRadio =
    document.querySelector(
    'input[name="TimePeriod"][value="AM"]'
    );

    const eveningRadio =
    document.querySelector(
    'input[name="TimePeriod"][value="PM"]'
    );

    morningRadio.disabled =
    slotAvailability["09:00"]
    === false;

    eveningRadio.disabled =
    slotAvailability["13:00"]
    === false;

    if (isWholeDayFull) {

    dayWarning.classList.remove(
    "d-none"
    );
    }
    else {

    dayWarning.classList.add(
    "d-none"
    );
    }

    updateSubmitButtonState();
    }
    catch (
    error
    ) {

    console.warn(
    "فشل فحص مواعيد اليوم:",
    error
    );

    /*
    * عند تعذر الاتصال لا نعتبر الموعد ممتلئاً
    * من الواجهة. يبقى فحص الخادم هو المرجع النهائي.
    */
    slotAvailability = {};

    isWholeDayFull =
    false;

    dayWarning.classList.add(
    "d-none"
    );

    document.querySelectorAll(
    'input[name="TimePeriod"]'
    ).forEach(
    function (
    radio
    ) {

    radio.disabled =
    false;
    }
    );

    updateSubmitButtonState();
    }
    }

    /* =============================================
    إعادة فحص الموعد المختار قبل الحفظ
    =============================================== */

    async function checkCapacity() {

    const date =
    document.getElementById(
    "appointmentDatePicker"
    ).value;

    const timeValue =
    document.getElementById(
    "AppointmentTimeHidden"
    ).value;

    const warning =
    document.getElementById(
    "capacityWarning"
    );

    if (
    !date
    ||
    !timeValue
    ) {

    return false;
    }

    try {

    const response =
    await fetch(
    `/Patients/CheckSlot?date=${encodeURIComponent(date)}&time=${encodeURIComponent(timeValue)}`,
    {
    cache: "no-store"
    }
    );

    if (!response.ok) {

    throw new Error(
    "تعذر فحص الموعد"
    );
    }

    const data =
    await response.json();

    const available =
    data.available === true;

    slotAvailability[
    timeValue
    ] =
    available;

    if (!available) {

    warning.textContent =
    "⚠️ هذا الموعد ممتلئ (10/10). "
    +
    "يرجى اختيار الفترة الأخرى أو يوماً آخر.";

    warning.classList.remove(
    "d-none"
    );

    isSelectedSlotFull =
    true;
    }
    else {

    warning.classList.add(
    "d-none"
    );

    isSelectedSlotFull =
    false;
    }

    updateSubmitButtonState();

    return available;
    }
    catch (
    error
    ) {

    console.warn(
    "فشل فحص الموعد المختار:",
    error
    );

    warning.classList.add(
    "d-none"
    );

    isSelectedSlotFull =
    false;

    updateSubmitButtonState();

    /*
    * عند تعذر الاتصال لا نوقف المستخدم من الواجهة،
    * والخادم يعيد التحقق عند الحفظ.
    */
    return true;
    }
    }

    /* =============================================
    Flatpickr — أول يوم متاح 26/07/2026
    =============================================== */

    flatpickr(
    "#appointmentDatePicker",
    {

    dateFormat:
    "Y-m-d",

    minDate:
    BOOKING_START_DATE,

    disable: [
    function (
    date
    ) {

    /*
    * منع الجمعة والسبت.
    */
    return (
    date.getDay() === 5
    ||
    date.getDay() === 6
    );
    }
    ],

    onChange:
    async function () {

    clearSelectedAppointment();

    await checkDayAvailability();
    }
    }
    );

    /* =============================================
    اختيار الفترة
    =============================================== */

    document.querySelectorAll(
    'input[name="TimePeriod"]'
    ).forEach(
    function (
    radio
    ) {

    radio.addEventListener(
    "change",
    async function () {

    await selectDefaultAppointment(
    this.value
    );
    }
    );
    });

    /* =============================================
    تاريخ الميلاد — يظهر يوم/شهر/سنة
    والقيمة المرسلة للـ Controller تبقى سنة-شهر-يوم
    =============================================== */
    function updateParentBlockByBirthDate(selectedDate) {
    const block = document.getElementById("ParentBlock");

    if (!selectedDate || isNaN(selectedDate.getTime())) {
    block.classList.add("d-none");
    block.querySelectorAll("input").forEach(function (i) { i.value = ""; });
    return;
    }

    const today = new Date();
    let age = today.getFullYear() - selectedDate.getFullYear();
    const monthDifference = today.getMonth() - selectedDate.getMonth();

    if (
    monthDifference < 0 ||
    (monthDifference === 0 && today.getDate() < selectedDate.getDate())
    ) {
    age--;
    }

    if (age < 18) {
    block.classList.remove("d-none");
    } else {
    block.classList.add("d-none");
    block.querySelectorAll("input").forEach(function (i) { i.value = ""; });
    }
    }

    flatpickr("#DateOfBirth", {
    dateFormat: "Y-m-d",       // القيمة التي تُرسل إلى ASP.NET
    altInput: true,
    altFormat: "d/m/Y",        // الشكل الظاهر: يوم/شهر/سنة
    maxDate: "today",
    allowInput: true,
    disableMobile: true,
    onChange: function (selectedDates) {
    updateParentBlockByBirthDate(
    selectedDates.length > 0 ? selectedDates[0] : null
    );
    }
    });

    /* =============================================
    نوع الهوية: أردني / جواز سفر
    =============================================== */
    const nationalityRadios =
    document.querySelectorAll('input[name="Nationality"]');

    const identityInput =
    document.getElementById("idInput");

    const identityLabel =
    document.getElementById("idLabel");

    const identityError =
    document.getElementById("identityClientError");

    const nationalityError =
    document.getElementById("nationalityClientError");

    function normalizeArabicDigits(value) {
    if (!value) return "";

    const arabicDigits = "٠١٢٣٤٥٦٧٨٩";
    const persianDigits = "۰۱۲۳۴۵۶۷۸۹";

    return value
    .replace(/[٠-٩]/g, function (digit) {
    return arabicDigits.indexOf(digit).toString();
    })
    .replace(/[۰-۹]/g, function (digit) {
    return persianDigits.indexOf(digit).toString();
    });
    }

    function getSelectedNationality() {
    return document.querySelector('input[name="Nationality"]:checked');
    }

    function showNationalityError(message) {
    nationalityError.textContent = message || "";
    nationalityError.classList.toggle("d-none", !message);
    }

    function showIdentityError(message) {
    identityError.textContent = message || "";
    identityError.classList.toggle("d-none", !message);
    identityInput.classList.toggle("is-invalid", !!message);
    }

    function configureIdentityField(clearValue) {
    const selectedNationality = getSelectedNationality();

    showNationalityError("");
    showIdentityError("");

    if (!selectedNationality) {
    identityInput.disabled = true;
    identityInput.value = "";
    identityInput.placeholder = "اختر نوع الهوية أولاً";
    identityLabel.textContent = "* الرقم الوطني / رقم الجواز";
    identityInput.removeAttribute("pattern");
    identityInput.removeAttribute("maxlength");
    return;
    }

    identityInput.disabled = false;
    identityInput.required = true;

    if (clearValue === true) {
    identityInput.value = "";
    }

    if (selectedNationality.value === "1") {
    identityLabel.textContent = "* الرقم الوطني";
    identityInput.placeholder = "أدخل الرقم الوطني المكون من 10 أرقام";
    identityInput.maxLength = 10;
    identityInput.inputMode = "numeric";
    identityInput.setAttribute("pattern", "[0-9]{10}");
    identityInput.setAttribute(
    "title",
    "الرقم الوطني يجب أن يتكون من 10 أرقام بالضبط"
    );
    } else {
    identityLabel.textContent = "* رقم جواز السفر";
    identityInput.placeholder = "أدخل رقم جواز السفر";
    identityInput.maxLength = 20;
    identityInput.inputMode = "text";
    identityInput.setAttribute("pattern", "[A-Za-z0-9-]{5,20}");
    identityInput.setAttribute(
    "title",
    "رقم الجواز يجب أن يكون من 5 إلى 20 خانة من الأحرف الإنجليزية أو الأرقام"
    );
    }
    }

    nationalityRadios.forEach(function (radio) {
    radio.addEventListener("change", function () {
    configureIdentityField(true);
    identityInput.focus();
    });
    });

    identityInput.addEventListener("input", function () {
    const selectedNationality = getSelectedNationality();

    showIdentityError("");

    if (!selectedNationality) {
    this.value = "";
    return;
    }

    let value = normalizeArabicDigits(this.value);

    if (selectedNationality.value === "1") {
    value = value
    .replace(/[^0-9]/g, "")
    .substring(0, 10);
    } else {
    value = value
    .toUpperCase()
    .replace(/\s+/g, "")
    .replace(/[^A-Z0-9-]/g, "")
    .substring(0, 20);
    }

    this.value = value;
    });

    function validateNationalityAndIdentity() {
    const selectedNationality = getSelectedNationality();
    const identityValue = normalizeArabicDigits(
    identityInput.value.trim()
    );

    showNationalityError("");
    showIdentityError("");

    if (!selectedNationality) {
    showNationalityError(
    "⚠️ يرجى اختيار أردني أو جواز سفر."
    );

    const firstRadio =
    document.getElementById("nationalityJordanian");

    firstRadio.focus();
    firstRadio.scrollIntoView({
    behavior: "smooth",
    block: "center"
    });

    return false;
    }

    if (identityValue === "") {
    showIdentityError(
    selectedNationality.value === "1"
    ? "⚠️ يرجى إدخال الرقم الوطني."
    : "⚠️ يرجى إدخال رقم جواز السفر."
    );

    identityInput.focus();
    identityInput.scrollIntoView({
    behavior: "smooth",
    block: "center"
    });

    return false;
    }

    if (selectedNationality.value === "1") {
    if (!/^[0-9]{10}$/.test(identityValue)) {
    showIdentityError(
    "⚠️ الرقم الوطني يجب أن يتكون من 10 أرقام بالضبط."
    );
    identityInput.focus();
    return false;
    }
    } else {
    if (!/^[A-Za-z0-9-]{5,20}$/.test(identityValue)) {
    showIdentityError(
    "⚠️ رقم الجواز يجب أن يكون من 5 إلى 20 خانة، ويحتوي على أحرف إنجليزية أو أرقام فقط."
    );
    identityInput.focus();
    return false;
    }
    }

    identityInput.value =
    selectedNationality.value === "1"
    ? identityValue
    : identityValue.toUpperCase();

    return true;
    }

    // في حال رجعت الصفحة من السيرفر وبداخلها قيم سابقة،
    // نعرض نوع الحقل الصحيح من دون حذف القيمة.
    configureIdentityField(false);

    /* =============================================
    معاينة الصورة
    =============================================== */
    document.getElementById("ProfilePhotoFile").addEventListener("change", function () {
    const file       = this.files[0];
    const preview    = document.getElementById("photoPreview");
    const photoError = document.getElementById("photoError");

    photoError.classList.add("d-none");
    if (!file) return;

    if (file.size > 2 * 1024 * 1024) {
    photoError.innerText = "⚠️ حجم الصورة يجب أن يكون أقل من 2MB";
    photoError.classList.remove("d-none");
    this.value = "";
    return;
    }

    const reader  = new FileReader();
    reader.onload = function (e) {
    preview.innerHTML = `<img src="${e.target.result}"
    style="width:100%; height:100%; object-fit:cover; border-radius:50%;" />`;
    };
    reader.readAsDataURL(file);
    });


    /* =============================================
    CAPTCHA محلية — بدون Session
    =============================================== */
    let captchaCorrectAnswer = null;
    let captchaCreatedAt = Date.now();

    function setCaptchaError(message) {
    const error = document.getElementById("captchaError");
    error.textContent = message || "";
    error.classList.toggle("d-none", !message);
    }

    function generateCaptcha() {
    const firstNumber  = Math.floor(Math.random() * 9) + 1;
    const secondNumber = Math.floor(Math.random() * 9) + 1;
    const useAddition  = Math.random() >= 0.5;

    let numberOne;
    let numberTwo;
    let operator;

    if (useAddition) {
    numberOne = firstNumber;
    numberTwo = secondNumber;
    operator = "+";
    captchaCorrectAnswer = numberOne + numberTwo;
    } else {
    // إبقاء نتيجة الطرح موجبة أو صفراً لتكون سهلة وواضحة.
    numberOne = Math.max(firstNumber, secondNumber);
    numberTwo = Math.min(firstNumber, secondNumber);
    operator = "−";
    captchaCorrectAnswer = numberOne - numberTwo;
    }

    document.getElementById("captchaQuestion").textContent =
    `${numberOne} ${operator} ${numberTwo} = ؟`;

    document.getElementById("captchaAnswer").value = "";
    captchaCreatedAt = Date.now();
    setCaptchaError("");
    }

    function validateCaptcha() {
    const answerInput = document.getElementById("captchaAnswer");
    const honeypot    = document.getElementById("websiteUrl");
    const answerText  = answerInput.value.trim();
    const elapsedTime = Date.now() - captchaCreatedAt;

    // إذا تم تعبئة الحقل المخفي فغالباً الإرسال آلي.
    if (honeypot && honeypot.value.trim() !== "") {
    setCaptchaError("تعذر قبول الطلب. يرجى تحديث الصفحة والمحاولة مرة أخرى.");
    return false;
    }

    if (answerText === "") {
    setCaptchaError("⚠️ يرجى إدخال إجابة سؤال التحقق.");
    answerInput.focus();
    return false;
    }

    if (!/^-?\d+$/.test(answerText)) {
    setCaptchaError("⚠️ يرجى إدخال أرقام فقط.");
    answerInput.focus();
    return false;
    }

    if (elapsedTime < 1500) {
    setCaptchaError("⚠️ يرجى الانتظار للحظة ثم إعادة المحاولة.");
    return false;
    }

    if (Number(answerText) !== captchaCorrectAnswer) {
    generateCaptcha();
    setCaptchaError("⚠️ الإجابة غير صحيحة. تم إنشاء سؤال جديد.");
    answerInput.focus();
    return false;
    }

    setCaptchaError("");
    return true;
    }

    document.getElementById("refreshCaptcha").addEventListener("click", function () {
    generateCaptcha();
    document.getElementById("captchaAnswer").focus();
    });

    document.getElementById("captchaAnswer").addEventListener("input", function () {
    setCaptchaError("");
    });

    generateCaptcha();

    /* =============================================
    إرسال النموذج
    =============================================== */
    document.getElementById("mainForm").addEventListener("submit", async function (e) {
    e.preventDefault();

    // التحقق من اختيار نوع الهوية ومن الرقم الوطني أو رقم الجواز.
    if (!validateNationalityAndIdentity()) {
    return;
    }

    // تشغيل تحقق ASP.NET Core / jQuery Validation لجميع حقول الموديل.
    if (window.jQuery &&
    $.validator &&
    !$(this).valid()) {
    const firstInvalid = this.querySelector(".input-validation-error, .is-invalid");
    if (firstInvalid) {
    firstInvalid.scrollIntoView({
    behavior: "smooth",
    block: "center"
    });
    }
    return;
    }

    // تحقق HTML5 للحقول التي تحمل required أو pattern.
    if (!this.checkValidity()) {
    this.reportValidity();
    return;
    }

    const pledge          = document.getElementById("pledge");
    const pledgeError     = document.getElementById("pledgeError");
    const capacityWarning    = document.getElementById("capacityWarning");
    const dayCapacityWarning = document.getElementById("dayCapacityWarning");
    const timeValue          = document.getElementById("AppointmentTimeHidden").value;

    // 1) التحقق من التعهد
    if (!pledge.checked) {
    pledge.style.outline = "2px solid red";
    pledgeError.classList.remove("d-none");
    pledge.scrollIntoView({ behavior: "smooth", block: "center" });
    return;
    }

    // 2) التحقق من CAPTCHA
    if (!validateCaptcha()) {
    document.getElementById("captchaAnswer")
    .scrollIntoView({ behavior: "smooth", block: "center" });
    return;
    }

    // 3) التحقق من اختيار الفترة والوقت الافتراضي
    if (!timeValue) {

    const appointmentDate =
    document.getElementById(
    "appointmentDatePicker"
    ).value;

    if (!appointmentDate) {

    document.getElementById(
    "appointmentDatePicker"
    ).scrollIntoView({
    behavior: "smooth",
    block: "center"
    });

    alert(
    "يرجى اختيار تاريخ الموعد."
    );
    }
    else {

    document.querySelector(
    'input[name="TimePeriod"]'
    ).scrollIntoView({
    behavior: "smooth",
    block: "center"
    });

    alert(
    "يرجى اختيار الفترة: صباحاً أو مساءً."
    );
    }

    return;
    }

    // 4) التحقق من امتلاء اليوم أو الموعد
    if (!dayCapacityWarning.classList.contains("d-none") ||
    !capacityWarning.classList.contains("d-none")) {
    return;
    }

    // نعيد الفحص قبل الإرسال مباشرة لتقليل احتمال حجز المقعد الأخير بالتزامن.
    const selectedSlotStillAvailable = await checkCapacity();
    if (!selectedSlotStillAvailable) {
    document.getElementById("selectedTimeRow")
    .scrollIntoView({ behavior: "smooth", block: "center" });
    return;
    }

    // 5) التحقق من التكرار
    const idNumber  = document.getElementById("idInput").value.trim();
    const firstName = document.querySelector('[name="FirstName"]').value.trim();
    const lastName  = document.querySelector('[name="FourthName"]').value.trim();
    const dob       = document.getElementById("DateOfBirth").value.trim();

    if (idNumber || (firstName && lastName)) {
    try {
    const params = new URLSearchParams({ idNumber, firstName, lastName, dob });
    const res    = await fetch(`/Patients/CheckDuplicate?${params.toString()}`);
    const data   = await res.json();

    if (data.isDuplicate) {
    const modal = new bootstrap.Modal(document.getElementById("duplicateModal"));
    modal.show();
    return;
    }
    } catch (err) {
    console.warn("Duplicate check failed, proceeding.", err);
    }
    }

    this.submit();
    });

    document.getElementById("pledge").addEventListener("change", function () {
    this.style.outline = "";
    document.getElementById("pledgeError").classList.add("d-none");
    });

</script>