@model DentalCollegeManagementSystem_AAU.Models.Patient

@{
    ViewData["Title"] = "إضافة مريض جديد";
    Layout = null;
}

<!--
    الترتيب مهم:
    Bootstrap أولاً، ثم الإضافات، ثم Site.css في النهاية.
-->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

<link rel="stylesheet"
      href="~/css/all.min.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/Site.css"
      asp-append-version="true" />

<style>
    .mb-2 {
        margin-bottom: 1.5rem !important;
    }

    .py-4 {
        padding-top: 2.5rem !important;
        padding-bottom: 1.5rem !important;
    }

    .section-box {
        background-color: #ffffff;
        border: 1px solid #d9d9d9 !important;
    }
    /*
                                                    ملفات الخط يجب أن تكون داخل:

                                                    wwwroot
                                                    └── Fonts
                                                        └── NeoSansArabic
                                                            ├── NEOSANSARABIC.TTF
                                                            ├── NEOSANSARABIC-LIGHT.TTF
                                                            ├── NEOSANSARABIC-MEDIUM.TTF
                                                            ├── NEOSANSARABIC-BOLD.TTF
                                                            ├── NEOSANSARABIC-BLACK.TTF
                                                            └── NEOSANSARABIC-ULTRA.TTF

                                                    نكتب @@font-face داخل ملف cshtml حتى يقوم Razor
                                                    بطباعة font -face بشكل صحيح داخل CSS.
                                            */

    @@font-face {
        font-family: 'NeoSansArabic';
        src: url('@Url.Content("~/Fonts/NeoSansArabic/NEOSANSARABIC-LIGHT.TTF")') format('truetype');
        font-weight: 300;
        font-style: normal;
        font-display: swap;
    }

    @@font-face {
        font-family: 'NeoSansArabic';
        src: url('@Url.Content("~/Fonts/NeoSansArabic/NEOSANSARABIC.TTF")') format('truetype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
    }

    @@font-face {
        font-family: 'NeoSansArabic';
        src: url('@Url.Content("~/Fonts/NeoSansArabic/NEOSANSARABIC-MEDIUM.TTF")') format('truetype');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
    }

    @@font-face {
        font-family: 'NeoSansArabic';
        src: url('@Url.Content("~/Fonts/NeoSansArabic/NEOSANSARABIC-BOLD.TTF")') format('truetype');
        font-weight: 600 700;
        font-style: normal;
        font-display: swap;
    }

    @@font-face {
        font-family: 'NeoSansArabic';
        src: url('@Url.Content("~/Fonts/NeoSansArabic/NEOSANSARABIC-ULTRA.TTF")') format('truetype');
        font-weight: 800;
        font-style: normal;
        font-display: swap;
    }

    @@font-face {
        font-family: 'NeoSansArabic';
        src: url('@Url.Content("~/Fonts/NeoSansArabic/NEOSANSARABIC-BLACK.TTF")') format('truetype');
        font-weight: 900;
        font-style: normal;
        font-display: swap;
    }

    :root {
        --bs-body-font-family: 'NeoSansArabic', Tahoma, Arial, sans-serif;
    }

    html,
    body,
    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    p,
    label,
    a,
    span,
    strong,
    small,
    input,
    textarea,
    select,
    option,
    button,
    table,
    th,
    td,
    .btn,
    .form-control,
    .form-select,
    .form-check-label,
    .modal,
    .flatpickr-calendar,
    .flatpickr-day,
    .flatpickr-month,
    .flatpickr-current-month {
        font-family: 'NeoSansArabic', Tahoma, Arial, sans-serif !important;
    }

    /*
                                                    نحافظ على خط Font Awesome حتى لا تختفي الأيقونات.
                                                */
    .fa,
    .fas,
    .far,
    .fal,
    .fab,
    .fa-solid,
    .fa-regular,
    .fa-brands {
        font-family: "Font Awesome 6 Free", "Font Awesome 5 Free", "Font Awesome 6 Brands", "Font Awesome 5 Brands" !important;
    }

    body {
        background: #f5f5f5;
    }

    .flatpickr-input {
        background-color: #fff !important;
    }

    .slot-btn {
        border: 2px solid #252468;
        color: #252468;
        background: #fff;
        font-size: 14px;
        font-weight: 600;
        padding: 8px 24px;
        border-radius: 0;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
        min-width: 110px;
    }

        .slot-btn:hover {
            background: #eeedf7;
        }

        .slot-btn.selected {
            background: #252468;
            color: #fff;
        }

        .slot-btn:disabled,
        .slot-btn.full {
            border-color: #ccc;
            color: #aaa;
            background: #f5f5f5;
            cursor: not-allowed;
            text-decoration: line-through;
        }

    /* =============================================
               بطاقة إرشادات الحجز
               =============================================== */
    .booking-guide {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 16px;
        border: 1px solid #e2e4f0;
        border-right: 4px solid #daa328;
        background: #fbfbfe;
    }

    .booking-guide-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #252468;
        color: #fff;
        border-radius: 50%;
        font-size: 17px;
    }

    .booking-guide-content {
        flex: 1;
        min-width: 0;
    }

    .booking-guide-title {
        color: #252468;
        font-size: 15px;
        font-weight: 800;
        margin-bottom: 3px;
    }

    .booking-guide-text {
        color: #4f5563;
        font-size: 13px;
        line-height: 1.8;
    }

    .booking-guide-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 9px;
    }

    .booking-guide-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .booking-guide-chip.current {
            color: #235c42;
            background: #edf8f2;
            border: 1px solid #ccebd9;
        }

        .booking-guide-chip.new {
            color: #252468;
            background: #efeffa;
            border: 1px solid #d9d9ee;
        }

    .booking-guide-muted {
        margin-top: 8px;
        color: #777d89;
        font-size: 12px;
    }

    .booking-capacity-note {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 14px;
        padding: 7px 10px;
        color: #6d5314;
        background: #fff9e9;
        border: 1px solid #f0dfaa;
        font-size: 12px;
        font-weight: 600;
    }

    @@media (max-width: 767.98px) {
        .booking-guide {
            padding: 12px;
        }

        .booking-guide-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
        }

        .booking-guide-chip {
            white-space: normal;
        }
    }

    /* =============================================
                                               CAPTCHA محلية — بدون Session أو إعدادات إضافية
                                               =============================================== */
    .local-captcha-box {
        border: 1px solid #d9d9d9;
        background: #f8f8fb;
        padding: 18px;
    }

    .local-captcha-question {
        min-width: 190px;
        min-height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px 16px;
        border: 1px dashed #252468;
        background: #ffffff;
        color: #252468;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 3px;
        user-select: none;
    }

    .local-captcha-refresh {
        width: 52px;
        height: 52px;
        border: 0;
        background: #daa328;
        color: #ffffff;
        font-size: 21px;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

        .local-captcha-refresh:hover {
            opacity: 0.9;
            transform: rotate(-20deg);
        }

    .local-captcha-error {
        color: #dc3545;
        font-size: 13px;
        margin-top: 6px;
    }

    .captcha-honeypot {
        position: absolute !important;
        right: -10000px !important;
        width: 1px !important;
        height: 1px !important;
        overflow: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
    }

    @@media (max-width: 767.98px) {
        .local-captcha-content {
            flex-direction: column;
            align-items: stretch !important;
        }

        .local-captcha-question {
            width: 100%;
        }
    }

</style>
<div class="patient-banner">
    <img src="@Url.Content("~/images/teeth/Header.jpg")"
         asp-append-version="true"
         class="patient-banner-image"
         alt="كلية طب الأسنان - جامعة عمان الأهلية" />
</div>
<!-- PAGE TITLE -->
<div class="bg-white w-100 py-4 px-5 border-bottom mb-4">
    <div class="container-xl">
        <section id="title-wrapper" style="justify-content:flex-start;">
            <div class="lineright" style="display:block; background-color:#daa328; max-width:650px;"></div>
            <h1 class="sectiontitle heading6">
                <p style="text-align:right; color:#252468; white-space:nowrap;"> تسجيل بيانات المريض </p>
            </h1>

        </section>
    </div>
</div>
<!-- MAIN CONTENT -->
<div class="container-xl pb-5" dir="rtl">

    <form asp-action="SavePublic" method="post" enctype="multipart/form-data" id="mainForm">

        <!-- المعلومات الشخصية -->
        <div class="mb-4">
            <p class="fw-bold fs-5 text-end mb-2" style="color:#252468;">المعلومات الشخصية</p>

            <div class="bg-white p-3">
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">* الاسم الأول</label>
                            <div class="flex-fill">
                                <input asp-for="FirstName" type="text" class="form-control rounded-0" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">* الاسم الثاني</label>
                            <div class="flex-fill">
                                <input asp-for="SecondName" type="text" class="form-control rounded-0" />
                                <span asp-validation-for="SecondName" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">الاسم الثالث</label>
                            <div class="flex-fill">
                                <input asp-for="ThirdName" type="text" class="form-control rounded-0" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">* اسم العائلة</label>
                            <div class="flex-fill">
                                <input asp-for="FourthName" type="text" class="form-control rounded-0" />
                                <span asp-validation-for="FourthName" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <div class="d-flex align-items-start gap-2">
                            <label class="fw-semibold text-nowrap"
                                   style="width:140px; color:#252468;">
                                * نوع الهوية
                            </label>

                            <div class="flex-fill">
                                <div class="d-flex gap-3 align-items-center flex-wrap">
                                    <label class="d-flex align-items-center gap-1 fw-medium"
                                           style="color:#252468;">
                                        <input type="radio"
                                               asp-for="Nationality"
                                               id="nationalityJordanian"
                                               value="1"
                                               class="form-check-input mt-0"
                                               style="accent-color:#252468;"
                                               required />
                                        أردني
                                    </label>

                                    <label class="d-flex align-items-center gap-1 fw-medium"
                                           style="color:#252468;">
                                        <input type="radio"
                                               asp-for="Nationality"
                                               id="nationalityPassport"
                                               value="2"
                                               class="form-check-input mt-0"
                                               style="accent-color:#252468;"
                                               required />
                                        جواز سفر / غير أردني
                                    </label>
                                </div>

                                <span asp-validation-for="Nationality"
                                      class="text-danger small"></span>

                                <span id="nationalityClientError"
                                      class="text-danger small d-none"
                                      role="alert"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">* الجنس</label>
                            <div class="flex-fill">
                                <div class="d-flex gap-3 align-items-center">
                                    <label class="d-flex align-items-center gap-1 fw-medium" style="color:#252468;">
                                        <input type="radio" asp-for="Gender" value="Male" class="form-check-input mt-0" style="accent-color:#252468;" /> ذكر
                                    </label>
                                    <label class="d-flex align-items-center gap-1 fw-medium" style="color:#252468;">
                                        <input type="radio" asp-for="Gender" value="Female" class="form-check-input mt-0" style="accent-color:#252468;" /> أنثى
                                    </label>
                                </div>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- الهوية ومعلومات التواصل -->
        <div class="mb-4">
            <p class="fw-bold fs-5 text-end mb-2" style="color:#252468;">الهوية ومعلومات التواصل</p>

            <div class="bg-white p-3">
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <div class="d-flex align-items-start gap-2">
                            <label id="idLabel"
                                   for="idInput"
                                   class="fw-semibold text-nowrap"
                                   style="width:140px; color:#252468;">
                                * الرقم الوطني / رقم الجواز
                            </label>

                            <div class="flex-fill">
                                <input asp-for="NationalID_PassportNumber"
                                       id="idInput"
                                       type="text"
                                       class="form-control rounded-0"
                                       placeholder="اختر نوع الهوية أولاً"
                                       autocomplete="off"
                                       required
                                       disabled />

                                <span asp-validation-for="NationalID_PassportNumber"
                                      class="text-danger small"></span>

                                <span id="identityClientError"
                                      class="text-danger small d-none"
                                      role="alert"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">* رقم الهاتف</label>
                            <div class="flex-fill">
                                <input asp-for="PhoneNumber" type="text" class="form-control rounded-0" placeholder="07XXXXXXXX" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">تاريخ الميلاد</label>
                            <div class="flex-fill">
                                <input asp-for="DateOfBirth"
                                       type="text"
                                       id="DateOfBirth"
                                       class="form-control rounded-0"
                                       placeholder="أختر تاريخ الميلاد"
                                       autocomplete="off" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">العنوان</label>
                            <div class="flex-fill">
                                <input asp-for="Address" type="text" class="form-control rounded-0" placeholder="المدينة، الشارع..." />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ولي الأمر -->
        <div id="ParentBlock" class="mb-4 d-none">
            <p class="fw-bold fs-5 text-end mb-2" style="color:#252468;">ولي الأمر / المسؤول</p>

            <div class="bg-white p-3">
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">اسم الأب</label>
                            <div class="flex-fill">
                                <input asp-for="FatherName" type="text" class="form-control rounded-0" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">هاتف الأب</label>
                            <div class="flex-fill">
                                <input asp-for="FatherPhone" type="text" class="form-control rounded-0" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">اسم الأم</label>
                            <div class="flex-fill">
                                <input asp-for="MotherName" type="text" class="form-control rounded-0" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap" style="width:140px; color:#252468;">هاتف الأم</label>
                            <div class="flex-fill">
                                <input asp-for="MotherPhone" type="text" class="form-control rounded-0" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- الموعد الأول -->
        <div class="mb-4">
            <p class="fw-bold fs-5 text-end mb-2" style="color:#252468;">
                الموعد الأول
            </p>

            <div class="bg-white p-3">
                <div class="row g-3 mb-3">

                    <!-- Appointment Date -->
                    <div class="col-md-6">
                        <div class="d-flex align-items-start gap-2">
                            <label class="fw-semibold text-nowrap"
                                   style="width:140px; color:#252468;">
                                * تاريخ الموعد
                            </label>

                            <div class="flex-fill">
                                <input asp-for="AppointmentDate"
                                       type="text"
                                       id="appointmentDatePicker"
                                       class="form-control rounded-0"
                                       placeholder="اختر التاريخ"
                                       autocomplete="off" />

                                <span asp-validation-for="AppointmentDate"
                                      class="text-danger small"></span>

                                <div class="booking-guide"
                                     style="justify-content:center; align-items:center; text-align:center;">
                                    <span class="booking-guide-chip new"
                                          style="font-size:13px; padding:7px 12px;">
                                        الجدول الجديد يبدأ 25/10/2026
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Available appointment slots -->
                    <div class="col-md-6">
                        <div class="d-flex align-items-start gap-2">
                            <label class="fw-semibold text-nowrap"
                                   style="width:140px; color:#252468;">
                                * الوقت المتاح
                            </label>

                            <div class="flex-fill">
                                <div id="slotsHelpText"
                                     class="small mb-2"
                                     style="color:#6c757d;">
                                    اختر تاريخ الموعد أولاً لتظهر المواعيد المتاحة.
                                </div>

                                <div id="slotButtons"
                                     class="d-flex flex-wrap gap-2">
                                </div>

                                <input asp-for="AppointmentTime"
                                       type="hidden"
                                       id="AppointmentTimeHidden" />

                                <span asp-validation-for="AppointmentTime"
                                      class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Selected appointment -->
                <div class="row g-3 mb-2" id="selectedTimeRow" style="display:none;">
                    <div class="col-md-6"></div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <label class="fw-semibold text-nowrap"
                                   style="width:140px; color:#252468;">
                                الوقت المحدد
                            </label>

                            <div class="flex-fill">
                                <div id="selectedTimeText"
                                     class="form-control rounded-0"
                                     style="background:#f7f7fb; border-color:#ced4da; color:#252468; font-weight:700;">
                                    —
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Whole-day warning -->
                <div id="dayCapacityWarning"
                     class="alert alert-warning rounded-0 mt-3 mb-2 d-none"
                     role="alert"
                     style="border-right:4px solid #daa328; color:#252468;">
                    <i class="fa-solid fa-calendar-xmark ms-1"></i>
                    جميع مواعيد هذا اليوم ممتلئة. يرجى اختيار يوم آخر.
                </div>

                <!-- Selected slot warning -->
                <div id="capacityWarning"
                     class="text-danger small mt-2 d-none">
                    ⚠️ هذا الموعد ممتلئ (8/8). يرجى اختيار موعد آخر.
                </div>

                <div class="booking-capacity-note">
                    <i class="fa-solid fa-user-group"></i>
                    <span>الحد الأقصى لكل فترة: <strong>8 مرضى</strong></span>
                </div>
            </div>
        </div>

        <!-- الصورة الشخصية -->
        <div class="mb-4">
            <p class="fw-bold fs-5 text-end mb-2" style="color:#252468;">الصورة الشخصية</p>

            <div class="bg-white p-3">
