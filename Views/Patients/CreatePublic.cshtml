<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>

    /* =============================================
    نظام المواعيد الجديد

    حتى 07/09/2026:
    يبقى الحجز الحالي متاحاً حتى آخر يوم محدد.

    من 08/09/2026 إلى 24/10/2026:
    الحجز متوقف بالكامل.

    من 25/10/2026:
    الأحد / الاثنين / الثلاثاء:
      09:00 - 11:00
      11:00 - 13:00

    الأربعاء:
      09:00 - 11:00
      11:00 - 13:00
      13:00 - 15:00
      15:00 - 17:00

    الخميس / الجمعة / السبت:
    لا يوجد حجز.

    الحد الأقصى لكل فترة = 8 مرضى.
    =============================================== */

    const OLD_BOOKING_START_DATE = "2026-09-06";
    const LAST_OLD_BOOKING_DATE = "2026-09-07";
    const NEW_BOOKING_START_DATE = "2026-10-25";
    const MAX_PATIENTS_PER_SLOT = 8;

    // آخر يومين قبل الإيقاف يستخدمان النظام السابق الموجود عندك.
    const OLD_SLOTS = [
        { value: "09:00", label: "09:00 - 11:00" },
        { value: "13:00", label: "13:00 - 15:00" }
    ];

    const NORMAL_DAY_SLOTS = [
        { value: "09:00", label: "09:00 - 11:00" },
        { value: "11:00", label: "11:00 - 13:00" }
    ];

    const WEDNESDAY_SLOTS = [
        { value: "09:00", label: "09:00 - 11:00" },
        { value: "11:00", label: "11:00 - 13:00" },
        { value: "13:00", label: "13:00 - 15:00" },
        { value: "15:00", label: "15:00 - 17:00" }
    ];

    let slotAvailability = {};
    let isWholeDayFull = false;
    let isSelectedSlotFull = false;

    function parseLocalDate(dateString) {
        if (!dateString) return null;

        const parts = dateString.split("-");
        if (parts.length !== 3) return null;

        return new Date(
            Number(parts[0]),
            Number(parts[1]) - 1,
            Number(parts[2]),
            0, 0, 0, 0
        );
    }

    function formatDateLocal(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
    }

    function getSlotsForDate(dateString) {
        if (!dateString) return [];

        // النظام السابق فقط يومي الأحد 06/09/2026 والاثنين 07/09/2026.
        if (
            dateString >= OLD_BOOKING_START_DATE &&
            dateString <= LAST_OLD_BOOKING_DATE
        ) {
            return OLD_SLOTS;
        }

        // فترة الإيقاف.
        if (dateString < NEW_BOOKING_START_DATE) {
            return [];
        }

        const date = parseLocalDate(dateString);
        if (!date) return [];

        const dayOfWeek = date.getDay();

        // Sunday = 0, Monday = 1, Tuesday = 2
        if (dayOfWeek === 0 || dayOfWeek === 1 || dayOfWeek === 2) {
            return NORMAL_DAY_SLOTS;
        }

        // Wednesday = 3
        if (dayOfWeek === 3) {
            return WEDNESDAY_SLOTS;
        }

        // Thursday / Friday / Saturday
        return [];
    }

    function isBlockedAppointmentDate(date) {
        const dateString = formatDateLocal(date);

        // أي تاريخ بعد الشفتات القديمة وقبل 25/10/2026 لا يوجد فيه حجز.
        if (
            dateString > LAST_OLD_BOOKING_DATE &&
            dateString < NEW_BOOKING_START_DATE
        ) {
            return true;
        }

        // من 25/10/2026: الخميس والجمعة والسبت ممنوعة.
        if (dateString >= NEW_BOOKING_START_DATE) {
            const dayOfWeek = date.getDay();
            return dayOfWeek === 4 || dayOfWeek === 5 || dayOfWeek === 6;
        }

        return false;
    }

    function setSubmitDisabled(disabled) {
        const button = document.getElementById("submitBtn");
        button.disabled = disabled;
        button.style.opacity = disabled ? "0.6" : "1";
    }

    function updateSubmitButtonState() {
        // يبقى الزر متاحاً، والفحص النهائي يتم عند الإرسال.
        setSubmitDisabled(false);
    }

    function hideCapacityMessages() {
        document.getElementById("capacityWarning").classList.add("d-none");
        document.getElementById("dayCapacityWarning").classList.add("d-none");
    }

    function showSlotFullModal(message) {
        const messageElement = document.getElementById("slotFullModalMessage");

        messageElement.textContent =
            message ||
            "هذا الموعد ممتلئ. يرجى اختيار موعد آخر.";

        const modalElement = document.getElementById("slotFullModal");
        const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
        modal.show();
    }

    function clearSelectedAppointment() {
        document.getElementById("AppointmentTimeHidden").value = "";
        document.getElementById("selectedTimeText").textContent = "—";
        document.getElementById("selectedTimeRow").style.display = "none";

        document.querySelectorAll("#slotButtons .slot-btn").forEach(function(button) {
            button.classList.remove("selected");
        });

        isSelectedSlotFull = false;
        updateSubmitButtonState();
    }

    function selectAppointmentSlot(value, label, button) {
        clearSelectedAppointment();

        document.getElementById("AppointmentTimeHidden").value = value;
        document.getElementById("selectedTimeText").textContent = label;
        document.getElementById("selectedTimeRow").style.removeProperty("display");

        if (button) {
            button.classList.add("selected");
        }

        document.getElementById("capacityWarning").classList.add("d-none");
        isSelectedSlotFull = false;
    }

    async function fetchSlotAvailability(date, slot) {
        const response = await fetch(
            `/Patients/CheckSlot?date=${encodeURIComponent(date)}&time=${encodeURIComponent(slot.value)}`,
            { cache: "no-store" }
        );

        if (!response.ok) {
            throw new Error("تعذر فحص الموعد");
        }

        const data = await response.json();

        return {
            value: slot.value,
            label: slot.label,
            available: data.available === true,
            count: Number.isFinite(Number(data.count)) ? Number(data.count) : 0,
            reason: data.reason || ""
        };
    }

    async function renderAvailableSlots() {
        const date = document.getElementById("appointmentDatePicker").value;
        const slotButtons = document.getElementById("slotButtons");
        const helpText = document.getElementById("slotsHelpText");
        const dayWarning = document.getElementById("dayCapacityWarning");

        clearSelectedAppointment();
        hideCapacityMessages();
        slotButtons.innerHTML = "";
        slotAvailability = {};
        isWholeDayFull = false;

        if (!date) {
            helpText.textContent = "اختر تاريخ الموعد أولاً لتظهر المواعيد المتاحة.";
            return;
        }

        const slots = getSlotsForDate(date);

        if (slots.length === 0) {
            helpText.textContent = "لا يوجد حجز في هذا التاريخ. يرجى اختيار يوم متاح.";
            return;
        }

        helpText.textContent = "اختر إحدى الفترات المتاحة:";

        try {
            const results = await Promise.all(
                slots.map(function(slot) {
                    return fetchSlotAvailability(date, slot);
                })
            );

            results.forEach(function(result) {
                slotAvailability[result.value] = result.available;

                const button = document.createElement("button");
                button.type = "button";
                button.className = "slot-btn";
                button.dataset.value = result.value;

                if (result.available) {
                    button.textContent = result.label;
                    button.title = `المحجوز حالياً: ${result.count} من ${MAX_PATIENTS_PER_SLOT}`;

                    button.addEventListener("click", function() {
                        selectAppointmentSlot(result.value, result.label, button);
                    });
                }
                else {
                    button.disabled = true;
                    button.classList.add("full");
                    button.textContent = `${result.label} - ممتلئ`;
                    button.title = `ممتلئ (${MAX_PATIENTS_PER_SLOT}/${MAX_PATIENTS_PER_SLOT})`;
                }

                slotButtons.appendChild(button);
            });

            isWholeDayFull = results.every(function(result) {
                return result.available === false;
            });

            if (isWholeDayFull) {
                dayWarning.classList.remove("d-none");
            }
        }
        catch (error) {
            console.error("فشل تحميل المواعيد:", error);
            helpText.textContent = "تعذر التحقق من المواعيد حالياً. يرجى تحديث الصفحة والمحاولة مرة أخرى.";
            slotButtons.innerHTML = "";
        }
    }

    async function checkCapacity() {
        const date = document.getElementById("appointmentDatePicker").value;
        const timeValue = document.getElementById("AppointmentTimeHidden").value;
        const warning = document.getElementById("capacityWarning");

        if (!date || !timeValue) {
            return false;
        }

        try {
            const response = await fetch(
                `/Patients/CheckSlot?date=${encodeURIComponent(date)}&time=${encodeURIComponent(timeValue)}`,
                { cache: "no-store" }
            );

            if (!response.ok) {
                throw new Error("تعذر فحص الموعد");
            }

            const data = await response.json();
            const available = data.available === true;

            slotAvailability[timeValue] = available;

            if (!available) {
                warning.textContent =
                    `⚠️ هذا الموعد غير متاح أو ممتلئ (${MAX_PATIENTS_PER_SLOT}/${MAX_PATIENTS_PER_SLOT}). يرجى اختيار موعد آخر.`;
                warning.classList.remove("d-none");
                isSelectedSlotFull = true;

                showSlotFullModal(
                    data.reason ||
                    "هذا الموعد ممتلئ. يرجى اختيار فترة أخرى أو يوماً آخر."
                );
            }
            else {
                warning.classList.add("d-none");
                isSelectedSlotFull = false;
            }

            updateSubmitButtonState();
            return available;
        }
        catch (error) {
            console.error("فشل فحص الموعد المختار:", error);

            warning.textContent =
                "⚠️ تعذر التحقق من توفر الموعد حالياً. يرجى المحاولة مرة أخرى.";
            warning.classList.remove("d-none");
            isSelectedSlotFull = true;

            updateSubmitButtonState();

            showSlotFullModal(
                "تعذر التحقق من توفر الموعد حالياً. يرجى تحديث الصفحة والمحاولة مرة أخرى."
            );

            return false;
        }
    }

    /* =============================================
    Flatpickr — نظام الإيقاف والجدول الجديد
    =============================================== */

    flatpickr("#appointmentDatePicker", {
        dateFormat: "Y-m-d",
        minDate: "today",
        disableMobile: true,
        disable: [
            function(date) {
                return isBlockedAppointmentDate(date);
            }
        ],
        onChange: async function() {
            await renderAvailableSlots();
        }
    });

    /* =============================================
    تاريخ الميلاد — يظهر يوم/شهر/سنة
    والقيمة المرسلة للـ Controller تبقى سنة-شهر-يوم
    =============================================== */
    function updateParentBlockByBirthDate(selectedDate) {
        const block = document.getElementById("ParentBlock");

        if (!selectedDate || isNaN(selectedDate.getTime())) {
            block.classList.add("d-none");
            block.querySelectorAll("input").forEach(function(i) { i.value = ""; });
            return;
        }

        const today = new Date();
        let age = today.getFullYear() - selectedDate.getFullYear();
        const monthDifference = today.getMonth() - selectedDate.getMonth();

        if (
            monthDifference < 0 ||
            (monthDifference === 0 && today.getDate() < selectedDate.getDate())
        ) {
            age--;
        }

        if (age < 18) {
            block.classList.remove("d-none");
        } else {
            block.classList.add("d-none");
            block.querySelectorAll("input").forEach(function(i) { i.value = ""; });
        }
    }

    flatpickr("#DateOfBirth", {
        dateFormat: "Y-m-d",       // القيمة التي تُرسل إلى ASP.NET
        altInput: true,
        altFormat: "d/m/Y",        // الشكل الظاهر: يوم/شهر/سنة
        maxDate: "today",
        allowInput: true,
        disableMobile: true,
        onChange: function(selectedDates) {
            updateParentBlockByBirthDate(
                selectedDates.length > 0 ? selectedDates[0] : null
            );
        }
    });

    /* =============================================
    نوع الهوية: أردني / جواز سفر
    =============================================== */
    const nationalityRadios =
        document.querySelectorAll('input[name="Nationality"]');

    const identityInput =
        document.getElementById("idInput");

    const identityLabel =
        document.getElementById("idLabel");

    const identityError =
        document.getElementById("identityClientError");

    const nationalityError =
        document.getElementById("nationalityClientError");

    function normalizeArabicDigits(value) {
        if (!value) return "";

        const arabicDigits = "٠١٢٣٤٥٦٧٨٩";
        const persianDigits = "۰۱۲۳۴۵۶۷۸۹";

        return value
            .replace(/[٠-٩]/g, function(digit) {
                return arabicDigits.indexOf(digit).toString();
            })
            .replace(/[۰-۹]/g, function(digit) {
                return persianDigits.indexOf(digit).toString();
            });
    }

    function getSelectedNationality() {
        return document.querySelector('input[name="Nationality"]:checked');
    }

    function showNationalityError(message) {
        nationalityError.textContent = message || "";
        nationalityError.classList.toggle("d-none", !message);
    }

    function showIdentityError(message) {
        identityError.textContent = message || "";
        identityError.classList.toggle("d-none", !message);
        identityInput.classList.toggle("is-invalid", !!message);
    }

    function configureIdentityField(clearValue) {
        const selectedNationality = getSelectedNationality();

        showNationalityError("");
        showIdentityError("");

        if (!selectedNationality) {
            identityInput.disabled = true;
            identityInput.value = "";
            identityInput.placeholder = "اختر نوع الهوية أولاً";
            identityLabel.textContent = "* الرقم الوطني / رقم الجواز";
            identityInput.removeAttribute("pattern");
            identityInput.removeAttribute("maxlength");
            return;
        }

        identityInput.disabled = false;
        identityInput.required = true;

        if (clearValue === true) {
            identityInput.value = "";
        }

        if (selectedNationality.value === "1") {
            identityLabel.textContent = "* الرقم الوطني";
            identityInput.placeholder = "أدخل الرقم الوطني المكون من 10 أرقام";
            identityInput.maxLength = 10;
            identityInput.inputMode = "numeric";
            identityInput.setAttribute("pattern", "[0-9]{10}");
            identityInput.setAttribute(
                "title",
                "الرقم الوطني يجب أن يتكون من 10 أرقام بالضبط"
            );
        } else {
            identityLabel.textContent = "* رقم جواز السفر";
            identityInput.placeholder = "أدخل رقم جواز السفر";
            identityInput.maxLength = 20;
            identityInput.inputMode = "text";
            identityInput.setAttribute("pattern", "[A-Za-z0-9-]{5,20}");
            identityInput.setAttribute(
                "title",
                "رقم الجواز يجب أن يكون من 5 إلى 20 خانة من الأحرف الإنجليزية أو الأرقام"
            );
        }
    }

    nationalityRadios.forEach(function(radio) {
        radio.addEventListener("change", function() {
            configureIdentityField(true);
            identityInput.focus();
        });
    });

    identityInput.addEventListener("input", function() {
        const selectedNationality = getSelectedNationality();

        showIdentityError("");

        if (!selectedNationality) {
            this.value = "";
            return;
        }

        let value = normalizeArabicDigits(this.value);

        if (selectedNationality.value === "1") {
            value = value
                .replace(/[^0-9]/g, "")
                .substring(0, 10);
        } else {
            value = value
                .toUpperCase()
                .replace(/\s+/g, "")
                .replace(/[^A-Z0-9-]/g, "")
                .substring(0, 20);
        }

        this.value = value;
    });

    function validateNationalityAndIdentity() {
        const selectedNationality = getSelectedNationality();
        const identityValue = normalizeArabicDigits(
            identityInput.value.trim()
        );

        showNationalityError("");
        showIdentityError("");

        if (!selectedNationality) {
            showNationalityError(
                "⚠️ يرجى اختيار أردني أو جواز سفر."
            );

            const firstRadio =
                document.getElementById("nationalityJordanian");

            firstRadio.focus();
            firstRadio.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });

            return false;
        }

        if (identityValue === "") {
            showIdentityError(
                selectedNationality.value === "1"
                    ? "⚠️ يرجى إدخال الرقم الوطني."
                    : "⚠️ يرجى إدخال رقم جواز السفر."
            );

            identityInput.focus();
            identityInput.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });

            return false;
        }

        if (selectedNationality.value === "1") {
            if (!/^[0-9]{10}$/.test(identityValue)) {
                showIdentityError(
                    "⚠️ الرقم الوطني يجب أن يتكون من 10 أرقام بالضبط."
                );
                identityInput.focus();
                return false;
            }
        } else {
            if (!/^[A-Za-z0-9-]{5,20}$/.test(identityValue)) {
                showIdentityError(
                    "⚠️ رقم الجواز يجب أن يكون من 5 إلى 20 خانة، ويحتوي على أحرف إنجليزية أو أرقام فقط."
                );
                identityInput.focus();
                return false;
            }
        }

        identityInput.value =
            selectedNationality.value === "1"
                ? identityValue
                : identityValue.toUpperCase();

        return true;
    }

    // في حال رجعت الصفحة من السيرفر وبداخلها قيم سابقة،
    // نعرض نوع الحقل الصحيح من دون حذف القيمة.
    configureIdentityField(false);

    /* =============================================
    معاينة الصورة
    =============================================== */
    document.getElementById("ProfilePhotoFile").addEventListener("change", function() {
        const file = this.files[0];
        const preview = document.getElementById("photoPreview");
        const photoError = document.getElementById("photoError");

        photoError.classList.add("d-none");
        if (!file) return;

        if (file.size > 2 * 1024 * 1024) {
            photoError.innerText = "⚠️ حجم الصورة يجب أن يكون أقل من 2MB";
            photoError.classList.remove("d-none");
            this.value = "";
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            preview.innerHTML = `<img src="${e.target.result}"
                    style="width:100%; height:100%; object-fit:cover; border-radius:50%;" />`;
        };
        reader.readAsDataURL(file);
    });


    /* =============================================
    CAPTCHA محلية — بدون Session
    =============================================== */
    let captchaCorrectAnswer = null;
    let captchaCreatedAt = Date.now();

    function setCaptchaError(message) {
        const error = document.getElementById("captchaError");
        error.textContent = message || "";
        error.classList.toggle("d-none", !message);
    }

    function generateCaptcha() {
        const firstNumber = Math.floor(Math.random() * 9) + 1;
        const secondNumber = Math.floor(Math.random() * 9) + 1;
        const useAddition = Math.random() >= 0.5;

        let numberOne;
        let numberTwo;
        let operator;

        if (useAddition) {
            numberOne = firstNumber;
            numberTwo = secondNumber;
            operator = "+";
            captchaCorrectAnswer = numberOne + numberTwo;
        } else {
            // إبقاء نتيجة الطرح موجبة أو صفراً لتكون سهلة وواضحة.
            numberOne = Math.max(firstNumber, secondNumber);
            numberTwo = Math.min(firstNumber, secondNumber);
            operator = "−";
            captchaCorrectAnswer = numberOne - numberTwo;
        }

        document.getElementById("captchaQuestion").textContent =
            `${numberOne} ${operator} ${numberTwo} = ؟`;

        document.getElementById("captchaAnswer").value = "";
        captchaCreatedAt = Date.now();
        setCaptchaError("");
    }

    function validateCaptcha() {
        const answerInput = document.getElementById("captchaAnswer");
        const honeypot = document.getElementById("websiteUrl");
        const answerText = answerInput.value.trim();
        const elapsedTime = Date.now() - captchaCreatedAt;

        // إذا تم تعبئة الحقل المخفي فغالباً الإرسال آلي.
        if (honeypot && honeypot.value.trim() !== "") {
            setCaptchaError("تعذر قبول الطلب. يرجى تحديث الصفحة والمحاولة مرة أخرى.");
            return false;
        }

        if (answerText === "") {
            setCaptchaError("⚠️ يرجى إدخال إجابة سؤال التحقق.");
            answerInput.focus();
            return false;
        }

        if (!/^-?\d+$/.test(answerText)) {
            setCaptchaError("⚠️ يرجى إدخال أرقام فقط.");
            answerInput.focus();
            return false;
        }

        if (elapsedTime < 1500) {
            setCaptchaError("⚠️ يرجى الانتظار للحظة ثم إعادة المحاولة.");
            return false;
        }

        if (Number(answerText) !== captchaCorrectAnswer) {
            generateCaptcha();
            setCaptchaError("⚠️ الإجابة غير صحيحة. تم إنشاء سؤال جديد.");
            answerInput.focus();
            return false;
        }

        setCaptchaError("");
        return true;
    }

    document.getElementById("refreshCaptcha").addEventListener("click", function() {
        generateCaptcha();
        document.getElementById("captchaAnswer").focus();
    });

    document.getElementById("captchaAnswer").addEventListener("input", function() {
        setCaptchaError("");
    });

    generateCaptcha();

    /* =============================================
    إرسال النموذج
    =============================================== */
    document.getElementById("mainForm").addEventListener("submit", async function(e) {
        e.preventDefault();

        // التحقق من اختيار نوع الهوية ومن الرقم الوطني أو رقم الجواز.
        if (!validateNationalityAndIdentity()) {
            return;
        }

        // تشغيل تحقق ASP.NET Core / jQuery Validation لجميع حقول الموديل.
        if (window.jQuery &&
            $.validator &&
            !$(this).valid()) {
            const firstInvalid = this.querySelector(".input-validation-error, .is-invalid");
            if (firstInvalid) {
                firstInvalid.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });
            }
            return;
        }

        // تحقق HTML5 للحقول التي تحمل required أو pattern.
        if (!this.checkValidity()) {
            this.reportValidity();
            return;
        }

        const pledge = document.getElementById("pledge");
        const pledgeError = document.getElementById("pledgeError");
        const capacityWarning = document.getElementById("capacityWarning");
        const dayCapacityWarning = document.getElementById("dayCapacityWarning");
        const timeValue = document.getElementById("AppointmentTimeHidden").value;

        // 1) التحقق من التعهد
        if (!pledge.checked) {
            pledge.style.outline = "2px solid red";
            pledgeError.classList.remove("d-none");
            pledge.scrollIntoView({ behavior: "smooth", block: "center" });
            return;
        }

        // 2) التحقق من CAPTCHA
        if (!validateCaptcha()) {
            document.getElementById("captchaAnswer")
                .scrollIntoView({ behavior: "smooth", block: "center" });
            return;
        }

        // 3) التحقق من اختيار التاريخ والموعد
        if (!timeValue) {
            const appointmentDate =
                document.getElementById("appointmentDatePicker").value;

            if (!appointmentDate) {
                document.getElementById("appointmentDatePicker")
                    .scrollIntoView({ behavior: "smooth", block: "center" });

                alert("يرجى اختيار تاريخ الموعد.");
            }
            else {
                document.getElementById("slotButtons")
                    .scrollIntoView({ behavior: "smooth", block: "center" });

                alert("يرجى اختيار أحد المواعيد المتاحة.");
            }

            return;
        }

        // 4) عند الضغط على تقديم الطلب نتحقق من امتلاء اليوم أو الفترة المختارة.
        if (isWholeDayFull || slotAvailability[timeValue] === false) {

            showSlotFullModal(
                "يرجى اختيار تاريخ للزيارة في يوم مختلف بسبب امتلاء الحجوزات لهذا اليوم."
            );

            return;
        }

        // نعيد الفحص قبل الإرسال مباشرة لتقليل احتمال حجز المقعد الأخير بالتزامن.
        const selectedSlotStillAvailable = await checkCapacity();
        if (!selectedSlotStillAvailable) {
            document.getElementById("selectedTimeRow")
                .scrollIntoView({ behavior: "smooth", block: "center" });
            return;
        }

        // 5) التحقق من التكرار
        const idNumber = document.getElementById("idInput").value.trim();
        const firstName = document.querySelector('[name="FirstName"]').value.trim();
        const lastName = document.querySelector('[name="FourthName"]').value.trim();
        const dob = document.getElementById("DateOfBirth").value.trim();

        if (idNumber || (firstName && lastName)) {
            try {
                const params = new URLSearchParams({ idNumber, firstName, lastName, dob });
                const res = await fetch(`/Patients/CheckDuplicate?${params.toString()}`);
                const data = await res.json();

                if (data.isDuplicate) {
                    const modal = new bootstrap.Modal(document.getElementById("duplicateModal"));
                    modal.show();
                    return;
                }
            } catch (err) {
                console.warn("Duplicate check failed, proceeding.", err);
            }
        }

        this.submit();
    });

    document.getElementById("pledge").addEventListener("change", function() {
        this.style.outline = "";
        document.getElementById("pledgeError").classList.add("d-none");
    });

</script>

@if (TempData["SlotFullMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const message =
                @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                TempData["SlotFullMessage"]?.ToString()
                )
                );

            showSlotFullModal(message);
        });
    </script>
}
