                        <label for="captchaAnswer"
                               class="fw-semibold text-nowrap"
                               style="width:140px; color:#252468;">
                            * أجب عن السؤال
                        </label>

                        <div class="d-flex align-items-center gap-2 flex-wrap flex-fill">
                            <div id="captchaQuestion"
                                 class="local-captcha-question"
                                 aria-live="polite">
                            </div>

                            <button type="button"
                                    id="refreshCaptcha"
