                                    title="تغيير السؤال"
                                    aria-label="تغيير سؤال التحقق">
                                <i class="fa-solid fa-rotate-right"></i>
                            </button>

                            <div class="flex-fill" style="min-width:180px;">
                                <input type="text"
                                       id="captchaAnswer"
                                       class="form-control rounded-0"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       maxlength="3"
                                       placeholder="أدخل الإجابة" />

                                <div id="captchaError"
                                     class="local-captcha-error d-none"
                                     role="alert">
