@model DentalCollegeManagementSystem_AAU.Models.User

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var roles =
        ViewBag.Roles as List<string>
        ?? new List<string>();
}

<style>
    .edit-login-user-page {
        max-width: 1050px;
        margin: 30px auto;
        padding: 0 15px;
    }

    .edit-login-user-title {
        text-align: center;
        color: #252468;
        font-size: 1.55rem;
        font-weight: 800;
        margin-bottom: 28px;
    }

    .edit-login-user-title-line {
        display: block;
        width: 220px;
        height: 3px;
        margin: 8px auto 0;
        background: #daa328;
    }

    .edit-login-user-card {
        border: 2px solid #daa328;
        border-radius: 8px;
        background: #fff;
        padding: 30px;
    }

    .edit-login-user-label {
        display: block;
        margin-bottom: 7px;
        color: #252468;
        font-size: .88rem;
        font-weight: 800;
    }

    .edit-login-user-input,
    .edit-login-user-select {
        width: 100%;
        min-height: 44px;
        border: 1px solid #d6d6d6;
        border-radius: 4px;
        padding: 9px 12px;
        background: #fff;
        color: #333;
        font-size: .9rem;
        outline: none;
    }

        .edit-login-user-input:focus,
        .edit-login-user-select:focus {
            border-color: #252468;
            box-shadow: 0 0 0 3px rgba(37, 36, 104, .10);
        }

    .edit-status-panel {
        border: 1px solid #d9dced;
        border-radius: 7px;
        background: #f8f9ff;
        padding: 14px;
    }

    .edit-status-description {
        margin-top: 8px;
        font-size: .77rem;
        font-weight: 700;
    }

        .edit-status-description.active {
            color: #217a36;
        }

        .edit-status-description.unactive {
            color: #b42318;
        }

    .password-message {
        border: 1px solid #b8c4e4;
        border-radius: 7px;
        background: #f5f7ff;
        color: #3949ab;
        padding: 11px 13px;
        font-size: .8rem;
        font-weight: 700;
    }

    .edit-login-user-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
    }

    .edit-login-user-save {
        min-width: 180px;
        border: none;
        border-radius: 4px;
        padding: 12px 28px;
        background: #c0006a;
        color: #fff;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
    }

        .edit-login-user-save:hover {
            background: #a6005b;
        }

    .edit-login-user-cancel {
        min-width: 180px;
        border-radius: 4px;
        padding: 12px 28px;
        background: #6b7280;
        color: #fff;
        font-size: 1rem;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
    }

        .edit-login-user-cancel:hover {
            background: #4b5563;
            color: #fff;
        }

    @@media (max-width: 767px) {
        .edit-login-user-card {
            padding: 20px 15px;
        }
    }
</style>

<div class="edit-login-user-page">

    <h2 class="edit-login-user-title">
        EDIT USER
        <span class="edit-login-user-title-line"></span>
    </h2>

    @if (TempData["Errors"] != null)
    {
        <div class="alert alert-danger text-center">
            @TempData["Errors"]
        </div>
    }

    <div asp-validation-summary="All"
         class="alert alert-danger"
         style="display:@(ViewData.ModelState.IsValid ? "none" : "block");">
    </div>

    <div class="edit-login-user-card">

        <form method="post"
              asp-controller="SearchNewUsers"
              asp-action="Edit">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="UserID"
                   value="@Model.UserID" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="edit-login-user-label">
                        * Username
                    </label>

                    <input type="text"
                           name="Username"
                           value="@Model.Username"
                           class="edit-login-user-input"
                           required />
                </div>

                <div class="col-md-6">
                    <label class="edit-login-user-label">
                        * Full Name
                    </label>

                    <input type="text"
                           name="FullName"
                           value="@Model.FullName"
                           class="edit-login-user-input"
                           required />
                </div>

                <div class="col-md-6">
                    <label class="edit-login-user-label">
                        * Email
                    </label>

                    <input type="email"
                           name="Email"
                           value="@Model.Email"
                           class="edit-login-user-input"
                           required />
                </div>

                <div class="col-md-6">
                    <label class="edit-login-user-label">
                        Phone Number
                    </label>

                    <input type="text"
                           name="PhoneNumber"
                           value="@Model.PhoneNumber"
                           maxlength="15"
                           class="edit-login-user-input" />
                </div>

                <div class="col-md-6">
                    <label class="edit-login-user-label">
                        * User Role
                    </label>

                    <select name="UserRole"
                            class="edit-login-user-select"
                            required>

                        <option value="">
                            -- Select User Role --
                        </option>

                        @foreach (string role in roles)
                        {
                            if (
                                string.Equals(
                                    role,
                                    Model.UserRole,
                                    StringComparison.OrdinalIgnoreCase
                                )
                            )
                            {
                                <option value="@role"
                                        selected="selected">
                                    @role
                                </option>
                            }
                            else
                            {
                                <option value="@role">
                                    @role
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <div class="edit-status-panel">

                        <label class="edit-login-user-label">
                            * User Status
                        </label>

                        <select name="IsActive"
                                id="userStatus"
                                class="edit-login-user-select"
                                onchange="updateStatusDescription()"
                                required>

                            @if (Model.IsActive == 1)
                            {
                                <option value="1"
                                        selected="selected">
                                    Active
                                </option>

                                <option value="0">
                                    UnActive
                                </option>
                            }
                            else
                            {
                                <option value="1">
                                    Active
                                </option>

                                <option value="0"
                                        selected="selected">
                                    UnActive
                                </option>
                            }

                        </select>

                        <div id="statusDescription"
                             class="edit-status-description">
                        </div>

                    </div>
                </div>

                <div class="col-md-12">
                    <div class="password-message">
                        🔒 The password is not changed from this page.
                    </div>
                </div>

            </div>

            <div class="edit-login-user-actions">

                <button type="submit"
                        class="edit-login-user-save">
                    Save Changes
                </button>

                <a asp-controller="SearchNewUsers"
                   asp-action="Details"
                   asp-route-id="@Model.UserID"
                   class="edit-login-user-cancel">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

<script>
    function updateStatusDescription() {
        const select =
            document.getElementById("userStatus");

        const description =
            document.getElementById("statusDescription");

        if (!select || !description) {
            return;
        }

        if (select.value === "1") {
            description.className =
                "edit-status-description active";

            description.textContent =
                "Active: Users.IsActive will be saved as 1.";
        }
        else {
            description.className =
                "edit-status-description unactive";

            description.textContent =
                "UnActive: Users.IsActive will be saved as 0.";
        }
    }

    document.addEventListener(
        "DOMContentLoaded",
        updateStatusDescription
    );
</script>
