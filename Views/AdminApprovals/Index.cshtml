                            !string.IsNullOrWhiteSpace(
                                v.AppointmentPeriod
                            )
                        )
                        {
                            <span style="
                                background:#e8eaf6;
                                color:#3949ab;
                                border-radius:4px;
                                padding:1px 8px;
                                font-size:.72rem;
                                margin-left:6px;">
                                @v.AppointmentPeriod
                            </span>
                        }
                    </div>

                    <div class="ap-card-date">
                        Submitted:
                        @v.CreatedDate.ToString(
                            "dd-MM-yyyy hh:mm tt"
                        )
                    </div>
                </div>

                <div class="ap-actions">
                    <form asp-controller="Visits"
                          asp-action="AdminApprove"
                          method="post"
                          class="ap-visit-approve-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="visitId"
                               value="@v.VisitID" />

                        <input type="hidden"
                               name="patientId"
                               value="@v.PatientID" />

                        <div class="ap-complexity-wrap">
                            <label class="ap-complexity-label">
                                Case Complexity
                            </label>

                            @if (hasCaseComplexity)
                            {
                                <span class="ap-complexity-value">
                                    @savedComplexity
                                </span>

                                <input type="hidden"
                                       name="caseComplexity"
                                       value="@savedComplexity" />

                                <div style="
                                    margin-top:5px;
                                    color:#607d8b;
                                    font-size:.72rem;">
                                    Saved from the first visit
                                </div>
