@using DentalCollegeManagementSystem_AAU.Models

@{
    var pendingVisits =
        ViewBag.PendingVisits
        as List<Visit>
        ?? new();

    var pendingDiagnosisTreatmentPlans =
        ViewBag.PendingDiagnosisTreatmentPlans
        as List<TreatmentPlanDiagnosis>
        ?? new();

    var pendingProcedures =
        ViewBag.PendingProcedures
        as List<TreatmentProcedure>
        ?? new();

    var pendingOrders =
        ViewBag.PendingOrders
        as List<Order>
        ?? new();

    var pendingStudentNotes =
        ViewBag.PendingStudentNotes
        as List<Note>
        ?? new();

    var caseComplexityByPatient =
        ViewBag.CaseComplexityByPatient
        as Dictionary<int, string>
        ?? new Dictionary<int, string>();

    int totalPending = ViewBag.TotalPending ?? 0;
}

@functions {
    string GetPatientName(Patient? p) =>
        p == null ? "Unknown Patient"
                  : $"{p.FirstName} {p.SecondName} {p.ThirdName} {p.FourthName}".Trim();
}

<style>
    .ap-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
    }

    .ap-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: #1a237e;
    }

    .ap-subtitle {
        font-size: .85rem;
        color: #888;
        margin-top: 3px;
    }

    .ap-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 14px;
        margin-bottom: 28px;
    }

    .ap-stat {
        background: #fff;
        border: 1.5px solid #e0e4f0;
        border-radius: 10px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ap-stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ap-stat-label {
        font-size: .8rem;
        color: #888;
    }

    .ap-stat-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: #1a237e;
    }

    .ap-section {
        background: #fff;
        border: 1.5px solid #e0e4f0;
        border-radius: 12px;
        margin-bottom: 24px;
        overflow: hidden;
    }

    .ap-section-header {
        background: #1a237e;
        color: #fff;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ap-section-title {
        font-size: .95rem;
        font-weight: 700;
    }

    .ap-count-badge {
        background: #daa328;
        color: #fff;
        border-radius: 20px;
        padding: 2px 12px;
        font-size: .78rem;
        font-weight: 700;
    }

    .ap-approve-all-btn {
        background: #fff;
        color: #1a237e;
        border: none;
        border-radius: 6px;
        padding: 6px 16px;
        font-size: .8rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s;
        white-space: nowrap;
    }

        .ap-approve-all-btn:hover {
            background: #e8eaf6;
        }

    .ap-card {
        border-bottom: 1px solid #f0f2f8;
        padding: 16px 20px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

        .ap-card:last-child {
            border-bottom: none;
        }

        .ap-card:hover {
            background: #fafbff;
        }

    .ap-card-info {
        flex: 1;
        min-width: 200px;
    }

    .ap-card-patient {
        font-size: .82rem;
        color: #888;
        margin-bottom: 4px;
    }

    .ap-card-title {
        font-size: .92rem;
        font-weight: 700;
        color: #1a237e;
        margin-bottom: 4px;
    }

    .ap-card-detail {
        font-size: .8rem;
        color: #555;
    }

    .ap-card-date {
        font-size: .75rem;
        color: #aaa;
        margin-top: 4px;
    }

    .ap-actions {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-shrink: 0;
    }

    .ap-approve-btn {
        background: #2e7d32;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s;
    }

        .ap-approve-btn:hover {
            background: #1b5e20;
        }

    .ap-reject-btn {
        background: #fff;
        color: #e53935;
        border: 1.5px solid #e53935;
        border-radius: 6px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s;
    }

        .ap-reject-btn:hover {
            background: #ffebee;
        }

    .ap-empty {
        padding: 30px;
        text-align: center;
        color: #aaa;
        font-size: .88rem;
    }

    .ap-complexity-wrap {
        min-width: 190px;
    }

    .ap-complexity-label {
        display: block;
        margin-bottom: 5px;
        color: #555;
        font-size: .75rem;
        font-weight: 700;
    }

    .ap-complexity-select {
        width: 100%;
        min-width: 180px;
        padding: 7px 10px;
        border: 1.5px solid #c5cae9;
        border-radius: 6px;
        background: #fff;
        color: #1a237e;
        font-size: .82rem;
        font-weight: 700;
    }

        .ap-complexity-select:focus {
            outline: none;
            border-color: #1a237e;
            box-shadow: 0 0 0 3px rgba(26, 35, 126, .10);
        }

    .ap-complexity-value {
        display: inline-block;
        padding: 5px 11px;
        border: 1px solid #90caf9;
        border-radius: 6px;
        background: #e3f2fd;
        color: #1565c0;
        font-size: .8rem;
        font-weight: 700;
    }

    .ap-first-visit-note {
        margin-top: 5px;
        color: #e65100;
        font-size: .72rem;
    }

    .ap-general-note-text {
        margin-top: 8px;
        padding: 10px 12px;
        border-radius: 7px;
        background: #f8f9ff;
        border-left: 4px solid #1a237e;
        color: #374151;
        font-size: .84rem;
        line-height: 1.6;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .ap-note-actions {
        display: block;
        min-width: 520px;
        max-width: 650px;
        flex: 1;
    }

    .ap-note-edit-form {
        margin: 0 0 10px;
        padding: 12px;
        border: 1px solid #d9def0;
        border-radius: 9px;
        background: #f8f9ff;
    }

    .ap-note-edit-label {
        display: block;
        margin-bottom: 6px;
        color: #1a237e;
        font-size: .76rem;
        font-weight: 800;
    }

    .ap-note-content-input {
        width: 100%;
        min-height: 105px;
        resize: vertical;
        border: 1.5px solid #b8c1df;
        border-radius: 7px;
        padding: 10px 12px;
        color: #263238;
        background: #fff;
        font-size: .84rem;
        line-height: 1.55;
        outline: none;
        box-sizing: border-box;
    }

        .ap-note-content-input:focus {
            border-color: #1a237e;
            box-shadow: 0 0 0 3px rgba(26, 35, 126, .10);
        }

    .ap-note-save-row {
        display: flex;
        justify-content: flex-end;
        margin-top: 8px;
    }

    .ap-note-save-btn {
        background: #1565c0;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 7px 18px;
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
    }

        .ap-note-save-btn:hover {
            background: #0d47a1;
        }

    .ap-note-decision-row {
        display: grid;
        grid-template-columns: auto minmax(260px, 1fr);
        align-items: start;
        gap: 10px;
    }

    .ap-note-reject-form {
        display: grid;
        grid-template-columns: minmax(190px, 1fr) auto;
        gap: 8px;
        margin: 0;
    }

    .ap-note-reason-input {
        height: 38px;
        border: 1.5px solid #ef9a9a;
        border-radius: 6px;
        padding: 0 10px;
        font-size: .8rem;
        outline: none;
    }

        .ap-note-reason-input:focus {
            border-color: #e53935;
            box-shadow: 0 0 0 3px rgba(229, 57, 53, .10);
        }

    .ap-note-closed-info {
        padding: 9px 11px;
        border: 1px solid #90caf9;
        border-radius: 7px;
        background: #e3f2fd;
        color: #0d47a1;
        font-size: .77rem;
        font-weight: 700;
        line-height: 1.45;
    }

    @@media (max-width: 760px) {
        .ap-note-actions {
            min-width: 100%;
            width: 100%;
        }

        .ap-note-decision-row,
        .ap-note-reject-form {
            grid-template-columns: 1fr;
            width: 100%;
        }
    }

    @@media (max-width: 1100px) {
        .ap-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 650px) {
        .ap-stats {
            grid-template-columns: 1fr;
        }
    }
</style>

<style>
    /* =========================================================
                           Improved Visits Approval Layout
                           ========================================================= */
    .ap-visits-section {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(26, 35, 126, .08);
        overflow: hidden;
    }

        .ap-visits-section .ap-section-header {
            min-height: 58px;
            padding: 16px 22px;
            background: linear-gradient(135deg, #171f70 0%, #283593 100%);
        }

        .ap-visits-section .ap-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 1rem;
            letter-spacing: .1px;
        }

        .ap-visits-section .ap-count-badge {
            min-width: 82px;
            padding: 5px 13px;
            text-align: center;
            background: #daa328;
            box-shadow: 0 4px 12px rgba(218, 163, 40, .24);
        }

        .ap-visits-section .ap-visit-card {
            display: grid;
            grid-template-columns: minmax(270px, 1fr) minmax(620px, 760px);
            align-items: center;
            gap: 26px;
            padding: 22px 24px;
            border-bottom: 1px solid #e9edf5;
            background: #fff;
            transition: background .18s ease, transform .18s ease;
        }

            .ap-visits-section .ap-visit-card:nth-child(odd) {
                background: #fbfcff;
            }

            .ap-visits-section .ap-visit-card:hover {
                background: #f6f8ff;
            }

        .ap-visits-section .ap-card-info {
            min-width: 0;
            padding: 2px 0 2px 4px;
        }

        .ap-visits-section .ap-card-patient {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 9px;
            color: #4b5563;
            font-size: .88rem;
            font-weight: 700;
        }

        .ap-visits-section .ap-card-title {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 7px;
            color: #1a237e;
            font-size: 1rem;
            font-weight: 800;
        }

        .ap-visits-section .ap-card-date {
            color: #94a0b2;
            font-size: .76rem;
        }

        .ap-visits-section .ap-actions {
            display: block;
            width: 100%;
            padding: 14px;
            border: 1px solid #e1e6f2;
            border-radius: 13px;
            background: #f8f9ff;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .8);
        }

    .ap-visit-approve-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 155px;
        align-items: end;
        gap: 14px;
        width: 100%;
        margin: 0;
    }

    .ap-visit-reject-form {
        margin: 0;
        align-self: end;
    }

    .ap-visits-section .ap-complexity-wrap {
        min-width: 0;
        width: 100%;
    }

    .ap-visits-section .ap-visit-approve-form .ap-complexity-wrap {
        flex: 1;
    }

    .ap-visits-section .ap-visit-approve-form .ap-approve-btn {
        align-self: anchor-center;
        letter-spacing: .1px;
    }

    .ap-visits-section .ap-complexity-label {
        margin-bottom: 7px;
        color: #313a54;
        font-size: .76rem;
        font-weight: 800;
    }

    .ap-visits-section .ap-complexity-select {
        width: 100%;
        min-width: 0;
        height: 46px;
        padding: 0 15px;
        border: 1.5px solid #bcc6e6;
        border-radius: 9px;
        background: #fff;
        color: #1a237e;
        font-size: .82rem;
        font-weight: 700;
        box-shadow: 0 2px 7px rgba(26, 35, 126, .05);
    }

        .ap-visits-section .ap-complexity-select:hover {
            border-color: #7d8dc8;
        }

        .ap-visits-section .ap-complexity-select:focus {
            border-color: #1a237e;
            box-shadow: 0 0 0 3px rgba(26, 35, 126, .10);
        }

    .ap-visits-section .ap-complexity-value {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 16px;
        border: 1px solid #90caf9;
        border-radius: 9px;
        background: linear-gradient(180deg, #edf7ff 0%, #e3f2fd 100%);
        color: #1565c0;
        font-size: .82rem;
        font-weight: 800;
        box-shadow: 0 2px 7px rgba(21, 101, 192, .06);
    }

    .ap-visits-section .ap-first-visit-note {
        margin-top: 6px;
        color: #e65100;
        font-size: .69rem;
        font-weight: 600;
        line-height: 1.35;
    }

    .ap-visits-section .ap-approve-btn,
    .ap-visits-section .ap-reject-btn {
        width: 100%;
        min-width: 155px;
        height: 46px;
        padding: 0 22px;
        border-radius: 9px;
        font-size: .88rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .ap-visits-section .ap-approve-btn {
        background: linear-gradient(180deg, #32923a 0%, #2e7d32 100%);
        box-shadow: 0 5px 12px rgba(46, 125, 50, .18);
    }

        .ap-visits-section .ap-approve-btn:hover {
            background: #256b2a;
            transform: translateY(-1px);
        }

    .ap-visits-section .ap-reject-btn {
        background: #fff;
        box-shadow: 0 3px 9px rgba(229, 57, 53, .06);
    }

        .ap-visits-section .ap-reject-btn:hover {
            background: #fff3f3;
            transform: translateY(-1px);
        }

    @@media (max-width: 1120px) {
        .ap-visits-section .ap-visit-card {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .ap-visits-section .ap-actions {
            max-width: none;
        }
    }

    @@media (max-width: 720px) {
        .ap-visits-section .ap-visit-card {
            padding: 18px 15px;
        }

        .ap-visits-section .ap-actions {
            display: block;
            padding: 10px;
        }

        .ap-visit-approve-form {
            grid-template-columns: 1fr;
        }

        .ap-visits-section .ap-approve-btn,
        .ap-visits-section .ap-reject-btn {
            width: 100%;
        }
    }
</style>


@if (TempData["Success"] != null)
{
    <div style="background:#d1e7dd; color:#0a3622; padding:12px 16px;
        border-radius:8px; margin-bottom:20px; font-size:.88rem;">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background:#fdecea; color:#b71c1c; padding:12px 16px;
        border:1px solid #ef9a9a; border-radius:8px;
        margin-bottom:20px; font-size:.88rem;">
        @TempData["Error"]
    </div>
}

<!-- Header -->
