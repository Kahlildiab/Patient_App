                            else
                            {
                                <select name="caseComplexity"
                                        class="ap-complexity-select"
                                        required>

                                    <option value="">
                                        -- Select Complexity --
                                    </option>

                                    <option value="Mild">
                                        1 - Mild
                                    </option>

                                    <option value="Moderate">
                                        2 - Moderate
                                    </option>

                                    <option value="Advance">
                                        3 - Advance
                                    </option>
                                </select>

                                <div class="ap-first-visit-note">
                                    Required before approving
                                    the patient's first visit
                                </div>
                            }
                        </div>

                        <button type="submit"
                                class="ap-approve-btn">
                            ✓ Approve
                        </button>
                    </form>

                    @* <form asp-controller="Visits"
                          asp-action="AdminReject"
                          method="post"
                          class="ap-visit-reject-form"
                          onsubmit="
                        return confirm(
                        'Reject and delete this visit?'
                        )">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="visitId"
                               value="@v.VisitID" />

                        <input type="hidden"
                               name="patientId"
                               value="@v.PatientID" />

                        <button type="submit"
                                class="ap-reject-btn">
                            ✗ Reject
                        </button>
                    </form> *@
                </div>
            </div>
        }
    }
</div>


