<!-- ===== STUDENT NOTES ===== -->
<div class="ap-section">
    <div class="ap-section-header">
        <span class="ap-section-title">
            📝 Student Notes
        </span>

        <span class="ap-count-badge">
            @pendingStudentNotes.Count pending
        </span>
    </div>

    @if (!pendingStudentNotes.Any())
    {
        <div class="ap-empty">
            ✅ No pending student notes
        </div>
    }
    else
    {
        foreach (var note in pendingStudentNotes)
        {
            bool noteVisitIsClosed =
                note.Visit != null
                &&
                note.Visit.IsClosed;

            <div class="ap-card">
                <div class="ap-card-info">
                    <div class="ap-card-patient">
                        👤 @GetPatientName(note.Patient)

                        <span style="color:#aaa; margin-left:8px;">
                            by @note.CreatedBy
                        </span>
                    </div>

                    <div class="ap-card-title">
                        Student Note

                        @if (note.VisitId.HasValue)
                        {
                            <span style="
                                color:#777;
                                font-size:.76rem;
                                font-weight:500;
                                margin-left:6px;">
                                Visit #@note.VisitId
                            </span>
                        }

                        @if (noteVisitIsClosed)
                        {
                            <span style="
                                display:inline-block;
                                margin-left:7px;
                                padding:2px 8px;
                                border-radius:12px;
                                background:#ffebee;
                                color:#b71c1c;
                                font-size:.7rem;
                                font-weight:800;">
                                Visit Closed
                            </span>
                        }
                    </div>

                    <div class="ap-card-date">
                        Submitted:
                        @note.CreatedAt.ToString(
                            "dd-MM-yyyy hh:mm tt"
                        )

                        @if (note.Visit != null)
                        {
                            <text>
                                — Visit date:
                                @note.Visit.VisitDate.ToString(
                                    "dd-MM-yyyy"
                                )
                            </text>
                        }
                    </div>
                </div>

                <div class="ap-note-actions">

                    <!-- Admin / Supervisor may edit even after End Visit -->
                    <form asp-controller="AdminApprovals"
                          asp-action="EditStudentNote"
                          method="post"
                          class="ap-note-edit-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="noteId"
                               value="@note.Id" />

                        <label class="ap-note-edit-label">
                            Note Content — Editable by Admin / Supervisor
                        </label>

                        <textarea name="content"
                                  class="ap-note-content-input"
                                  maxlength="4000"
                                  required>@note.Content</textarea>

                        <div class="ap-note-save-row">
                            <button type="submit"
                                    class="ap-note-save-btn">
                                ✎ Save Changes
                            </button>
                        </div>
                    </form>

                    <div class="ap-note-decision-row">

                        <form asp-controller="AdminApprovals"
                              asp-action="ApproveStudentNote"
                              method="post"
                              style="margin:0;">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="noteId"
                                   value="@note.Id" />

                            <button type="submit"
                                    class="ap-approve-btn"
                                    onclick="return confirm('Approve this student note?');">
                                ✓ Approve
                            </button>
                        </form>

                        @if (noteVisitIsClosed)
                        {
                            <div class="ap-note-closed-info">
                                The visit is closed and the student cannot
                                revise the note. Edit it above when needed,
                                then approve it.
                            </div>
                        }
                        else
                        {
                            <form asp-controller="AdminApprovals"
                                  asp-action="RejectStudentNote"
                                  method="post"
                                  class="ap-note-reject-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="noteId"
                                       value="@note.Id" />

                                <input type="text"
                                       name="rejectionReason"
                                       class="ap-note-reason-input"
                                       maxlength="500"
                                       placeholder="Rejection reason..."
                                       required />

                                <button type="submit"
                                        class="ap-reject-btn"
                                        onclick="return confirm('Reject this note and return it to the student for correction?');">
                                    ✗ Reject
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>


<!-- ===== VISITS ===== -->
<div class="ap-section ap-visits-section">
