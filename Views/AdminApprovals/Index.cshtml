<!-- ===== ORDERS ===== -->
<div class="ap-section">
    <div class="ap-section-header">
        <span class="ap-section-title">📋 Orders</span>
        <div style="display:flex; align-items:center; gap:12px;">
            <span class="ap-count-badge">@pendingOrders.Count pending</span>
            @if (pendingOrders.Any())
            {
                <form asp-controller="AdminApprovals" asp-action="ApproveAllOrders"
                      method="post" class="m-0 p-0"
                      onsubmit="return confirm('Approve all @pendingOrders.Count pending order(s)?')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ap-approve-all-btn">✓ Approve All</button>
                </form>
            }
        </div>
    </div>

    @if (!pendingOrders.Any())
    {
        <div class="ap-empty">✅ No pending orders</div>
    }
    else
    {
        foreach (var o in pendingOrders)
        {
            string description = o.OrderType switch
            {
                "Consent" => o.ConsentDetail?.ConsentType + " consent",
                "Referral" => $"Referral to {o.ReferralDetail?.Specialty} for {o.ReferralDetail?.Reason}",
                "Medication" => $"{o.MedicationDetail?.MedicationName} {o.MedicationDetail?.Dosage} - {o.MedicationDetail?.Frequency}",
                "XRay" => $"{o.XRayDetail?.XRayType} radiograph{(o.XRayDetail?.ToothNumber != null ? " - Tooth " + o.XRayDetail.ToothNumber : "")}",
                "Discharge" => o.DischargeDetail?.DischargeReason,
                _ => o.Notes
            } ?? "";

            <div class="ap-card">
                <div class="ap-card-info">
                    <div class="ap-card-patient">
                        👤 @GetPatientName(o.Patient)
                        <span style="color:#aaa; margin-left:8px;">
                            by @(o.CreatedByUser?.FullName ?? "Unknown")
                        </span>
                    </div>
                    <div class="ap-card-title">
                        @o.OrderType
                        <span style="color:#aaa; font-size:.78rem; font-weight:400; margin-left:6px;">
                            (@o.OrderNumber)
                        </span>
                    </div>
                    <div class="ap-card-detail">@description</div>
                    <div class="ap-card-date">Submitted: @o.CreatedDate.ToString("dd-MM-yyyy hh:mm tt")</div>
                </div>
                <div class="ap-actions">
                    <form asp-controller="Orders" asp-action="AdminApprove" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@o.OrderID" />
                        <input type="hidden" name="patientId" value="@o.PatientID" />
                        <button type="submit" class="ap-approve-btn">✓ Approve</button>
                    </form>
                    <form asp-controller="Orders" asp-action="AdminReject" method="post"
                          onsubmit="return confirm('Reject and delete this order?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@o.OrderID" />
                        <input type="hidden" name="patientId" value="@o.PatientID" />
                        <button type="submit" class="ap-reject-btn">✗ Reject</button>
                    </form>
                </div>
            </div>
        }
    }
</div>

<script>
    (function () {
        "use strict";

        const PAGE_SIZE = 5;

        function initializeApprovalPagination() {
            const searchForm =
                document.getElementById("apSearchForm");

            const searchInput =
                document.getElementById("apGlobalSearch");

            const clearButton =
                document.getElementById("apClearSearch");

            const searchSummary =
                document.getElementById("apSearchSummary");

            if (
                !searchForm
                || !searchInput
                || !clearButton
                || !searchSummary
            ) {
                return;
            }

            const sections =
                Array.from(document.querySelectorAll(".ap-section"))
                    .map(function (section, index) {
                        const cards =
                            Array.from(section.children)
                                .filter(function (child) {
                                    return child.classList.contains("ap-card");
                                });

                        if (cards.length === 0) {
                            return null;
                        }

                        const existingEmpty =
                            Array.from(section.children)
                                .find(function (child) {
                                    return child.classList.contains("ap-empty");
                                });

                        const searchEmpty =
                            document.createElement("div");

                        searchEmpty.className =
                            "ap-section-search-empty";

                        searchEmpty.textContent =
                            "No matching records were found in this section.";

                        const pagination =
                            document.createElement("div");

                        pagination.className =
                            "ap-pagination";

                        const paginationInfo =
                            document.createElement("div");

                        paginationInfo.className =
                            "ap-pagination-info";

                        const paginationButtons =
                            document.createElement("div");

                        paginationButtons.className =
                            "ap-pagination-buttons";

                        pagination.appendChild(paginationInfo);
                        pagination.appendChild(paginationButtons);
                        section.appendChild(searchEmpty);
                        section.appendChild(pagination);

                        cards.forEach(function (card) {
                            card.dataset.apSearchText =
                                getCardSearchText(card);
                        });

                        return {
                            id: index,
                            section: section,
                            cards: cards,
                            existingEmpty: existingEmpty,
                            searchEmpty: searchEmpty,
                            pagination: pagination,
                            paginationInfo: paginationInfo,
                            paginationButtons: paginationButtons,
                            filteredCards: cards.slice(),
                            currentPage: 1
                        };
                    })
                    .filter(Boolean);

            function normalizeText(value) {
                return (value || "")
                    .toString()
                    .toLocaleLowerCase()
                    .replace(/\s+/g, " ")
                    .trim();
            }

            function getCardSearchText(card) {
                const fieldValues =
                    Array.from(
                        card.querySelectorAll(
                            "input:not([type='hidden']), textarea, select"
                        )
                    )
                    .map(function (field) {
                        if (field.tagName === "SELECT") {
                            const option =
                                field.options[field.selectedIndex];

                            return option
                                ? option.text + " " + option.value
                                : field.value;
                        }

                        return field.value || "";
                    })
                    .join(" ");

                return normalizeText(
                    card.innerText
                    + " "
                    + card.textContent
                    + " "
                    + fieldValues
                );
            }

            function createPageButton(
                label,
                page,
                isActive,
                isDisabled,
                state
            ) {
                const button =
                    document.createElement("button");

                button.type = "button";
                button.className =
                    "ap-page-btn"
                    + (isActive ? " active" : "");

                button.textContent = label;
                button.disabled = isDisabled;

                button.addEventListener("click", function () {
                    if (isDisabled || state.currentPage === page) {
                        return;
                    }

                    state.currentPage = page;
                    renderSection(state, true);
                });

                return button;
            }

            function appendDots(container) {
                const dots =
                    document.createElement("span");

                dots.className = "ap-page-dots";
                dots.textContent = "…";
                container.appendChild(dots);
            }

            function getVisiblePageNumbers(
                currentPage,
                totalPages
            ) {
                if (totalPages <= 7) {
                    return Array.from(
                        { length: totalPages },
                        function (_, index) {
                            return index + 1;
                        }
                    );
                }

                const pages = [1];
                let start = Math.max(2, currentPage - 1);
                let end = Math.min(totalPages - 1, currentPage + 1);

                if (currentPage <= 3) {
                    start = 2;
                    end = 4;
                }
                else if (currentPage >= totalPages - 2) {
                    start = totalPages - 3;
                    end = totalPages - 1;
                }

                for (let page = start; page <= end; page++) {
                    pages.push(page);
                }

                pages.push(totalPages);
                return pages;
            }

            function renderPaginationButtons(
                state,
                totalPages
            ) {
                const container =
                    state.paginationButtons;

                container.innerHTML = "";

                container.appendChild(
                    createPageButton(
                        "‹ Previous",
                        Math.max(1, state.currentPage - 1),
                        false,
                        state.currentPage === 1,
                        state
                    )
                );

                const pages =
                    getVisiblePageNumbers(
                        state.currentPage,
                        totalPages
                    );

                let previousPage = null;

                pages.forEach(function (page) {
                    if (
                        previousPage !== null
                        && page - previousPage > 1
                    ) {
                        appendDots(container);
                    }

                    container.appendChild(
                        createPageButton(
                            page.toString(),
                            page,
                            page === state.currentPage,
                            false,
                            state
                        )
                    );

                    previousPage = page;
                });

                container.appendChild(
                    createPageButton(
                        "Next ›",
                        Math.min(
                            totalPages,
                            state.currentPage + 1
                        ),
                        false,
                        state.currentPage === totalPages,
                        state
                    )
                );
            }

            function renderSection(
                state,
                scrollToSection
            ) {
                const totalItems =
                    state.filteredCards.length;

                const totalPages =
                    Math.max(
                        1,
                        Math.ceil(totalItems / PAGE_SIZE)
                    );

                if (state.currentPage > totalPages) {
                    state.currentPage = totalPages;
                }

                state.cards.forEach(function (card) {
                    card.hidden = true;
                });

                if (state.existingEmpty) {
                    state.existingEmpty.style.display = "none";
                }

                if (totalItems === 0) {
                    state.searchEmpty.style.display = "block";
                    state.pagination.style.display = "none";
                    return;
                }

                state.searchEmpty.style.display = "none";

                const startIndex =
                    (state.currentPage - 1) * PAGE_SIZE;

                const endIndex =
                    Math.min(
                        startIndex + PAGE_SIZE,
                        totalItems
                    );

                state.filteredCards
                    .slice(startIndex, endIndex)
                    .forEach(function (card) {
                        card.hidden = false;
                    });

                state.paginationInfo.textContent =
                    "Showing "
                    + (startIndex + 1)
                    + "–"
                    + endIndex
                    + " of "
                    + totalItems;

                if (totalPages > 1) {
                    state.pagination.style.display = "flex";
                    renderPaginationButtons(state, totalPages);
                }
                else {
                    state.pagination.style.display = "flex";
                    state.paginationButtons.innerHTML = "";
                }

                if (scrollToSection) {
                    const header =
                        state.section.querySelector(
                            ".ap-section-header"
                        );

                    if (header) {
                        header.scrollIntoView({
                            behavior: "smooth",
                            block: "start"
                        });
                    }
                }
            }

            function applySearch() {
                const query =
                    normalizeText(searchInput.value);

                let totalMatches = 0;
                let totalRecords = 0;

                sections.forEach(function (state) {
                    totalRecords += state.cards.length;

                    /* Refresh the searchable text so edited textarea
                       content is included before filtering. */
                    state.cards.forEach(function (card) {
                        card.dataset.apSearchText =
                            getCardSearchText(card);
                    });

                    state.filteredCards =
                        query.length === 0
                            ? state.cards.slice()
                            : state.cards.filter(function (card) {
                                return (
                                    card.dataset.apSearchText || ""
                                ).includes(query);
                            });

                    totalMatches +=
                        state.filteredCards.length;

                    state.currentPage = 1;
                    renderSection(state, false);
                });

                if (query.length === 0) {
                    searchSummary.textContent =
                        "Showing all "
                        + totalRecords
                        + " pending records. Each section displays "
                        + PAGE_SIZE
                        + " records per page.";
                }
                else {
                    searchSummary.textContent =
                        totalMatches
                        + " matching record(s) found across all sections.";
                }
            }

            let searchTimer = null;

            searchForm.addEventListener(
                "submit",
                function (event) {
                    event.preventDefault();
                    window.clearTimeout(searchTimer);
                    applySearch();
                }
            );

            searchInput.addEventListener("input", function () {
                window.clearTimeout(searchTimer);

                searchTimer = window.setTimeout(
                    applySearch,
                    150
                );
            });

            clearButton.addEventListener("click", function () {
                searchInput.value = "";
                applySearch();
                searchInput.focus();
            });

            applySearch();
        }

        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded",
                initializeApprovalPagination
            );
        }
        else {
            initializeApprovalPagination();
        }
    })();
</script>