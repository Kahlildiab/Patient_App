    <div class="ap-stat">
        <div class="ap-stat-icon" style="background:#fff3e0;">
            <svg width="20" height="20" fill="none" stroke="#e65100" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
            </svg>
        </div>
        <div>
            <div class="ap-stat-label">Pending Orders</div>
            <div class="ap-stat-value">@pendingOrders.Count</div>
        </div>
    </div>
</div>



<style>
    /* =========================================================
           Search design + Independent Pagination (5 cards per section)
           ========================================================= */
    .ap-search-shell {
        width: 100vw;
        position: relative;
        left: 50%;
        margin-left: -50vw;
        box-sizing: border-box;
        padding: 30px 40px;
        margin-bottom: 28px;
        background: #e9e8e8;
    }

    .ap-search-inner {
        width: 100%;
        max-width: 1300px;
        margin: 0 auto;
    }

    .ap-search-heading {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .ap-search-gold-line {
        display: block;
        width: 100%;
        max-width: 650px;
        height: 4px;
        margin-bottom: 7px;
        background: #daa328;
    }

    .ap-search-main-title {
        margin: 0;
        color: #252468;
        font-size: 1.65rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: .2px;
    }

    .ap-search-form {
        margin-top: 22px;
    }

    .ap-search-white-box {
        padding: 16px 20px;
        background: #fff;
    }

    .ap-search-field-row {
        display: grid;
        grid-template-columns: 190px minmax(0, 1fr) 90px;
        align-items: center;
        gap: 12px;
    }

    .ap-search-field-label {
        margin: 0;
        color: #252468;
        font-size: 13px;
        font-weight: 700;
    }

    .ap-search-input-wrap {
        position: relative;
        min-width: 0;
    }

    .ap-search-icon {
        position: absolute;
        top: 50%;
        left: 13px;
        transform: translateY(-50%);
        color: #7b86a6;
        pointer-events: none;
    }

    .ap-search-input {
        width: 100%;
        height: 42px;
        box-sizing: border-box;
        padding: 0 14px 0 40px;
        border: 1px solid #ddd;
        border-radius: 0;
        background: #fff;
        color: #263238;
        font-size: .88rem;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
    }

        .ap-search-input:focus {
            border-color: #252468;
            box-shadow: 0 0 0 2px rgba(37, 36, 104, .10);
        }

    .ap-search-clear {
        width: 100%;
        height: 42px;
        border: 1px solid #ddd;
        border-radius: 0;
        background: #f8f8f8;
        color: #252468;
        font-size: .8rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s, color .15s;
    }

        .ap-search-clear:hover {
            background: #ecebfa;
            color: #1a237e;
        }

    .ap-search-submit-wrap {
        text-align: center;
    }

    .ap-search-submit {
        width: 90%;
        margin-top: 3px;
        padding: 12px;
        border: none;
        border-radius: 0;
        background: #c81589;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 1px;
        cursor: pointer;
        transition: background .15s;
    }

