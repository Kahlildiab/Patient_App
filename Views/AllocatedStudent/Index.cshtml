@model DentalCollegeManagementSystem_AAU.Models.AllocatedStudentIndexViewModel

@{
    ViewData["Title"] = "Allocated Students";

    int visiblePages = 4;
    int startPage = Math.Max(1, Model.CurrentPage - 1);
    int endPage = Math.Min(Model.TotalPages, startPage + visiblePages - 1);

    if (endPage - startPage + 1 < visiblePages)
    {
        startPage = Math.Max(1, endPage - visiblePages + 1);
    }

    int rowStart = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
}

<link rel="stylesheet" href="~/css/Site.css" />
<link rel="stylesheet" href="~/css/RTE.css" />

<style>
    .active-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 14px;
    }

    .filter-tag {
        background: #e8eaf6;
        color: #252468;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .allocation-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 92px;
        border-radius: 20px;
        padding: 4px 11px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .allocation-assigned {
        background: #d1e7dd;
        color: #0f5132;
        border: 1px solid #a3cfbb;
    }

    .allocation-unassigned {
        background: #e2e3e5;
        color: #5f6368;
        border: 1px solid #d6d8db;
    }

    .patient-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 28px;
        border-radius: 16px;
        padding: 0 10px;
        background: #eef2ff;
        color: #252468;
        border: 1px solid #c7d2fe;
        font-size: 12px;
        font-weight: 800;
    }

    .assigned-patients-cell {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-view-patients {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: none;
        background: #252468;
        color: #fff;
        padding: 6px 12px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: opacity .15s ease;
    }

        .btn-view-patients:hover {
            opacity: .88;
            color: #fff;
        }

    .patient-status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 82px;
        border-radius: 18px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .patient-status-screening {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffc107;
    }

    .patient-status-allocated {
        background: #d1e7dd;
        color: #0f5132;
        border: 1px solid #a3cfbb;
    }

    .patient-status-discharged {
        background: #e2e3e5;
        color: #383d41;
        border: 1px solid #d6d8db;
    }

    .compact-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 22px;
        padding-left: 0;
    }

        .compact-pagination .page-link {
            min-width: 36px;
            height: 36px;
            padding: 0 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #cdd4e8 !important;
            border-radius: 7px !important;
            background: #fff;
            color: #1a237e;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            box-shadow: none !important;
        }

            .compact-pagination .page-link:hover {
                background: #e8eaf6;
                border-color: #9fa8da !important;
                color: #1a237e;
            }

        .compact-pagination .page-item.active .page-link {
            background: #1a237e;
            border-color: #1a237e !important;
            color: #fff;
        }

        .compact-pagination .page-item.disabled .page-link {
            opacity: .45;
            pointer-events: none;
        }

        .compact-pagination .pagination-dots {
            min-width: 24px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #8b94a8;
            font-weight: 800;
        }

        .compact-pagination .pagination-navigation .page-link {
            padding: 0 14px;
            white-space: nowrap;
        }
</style>

<div>
    <section id="title-wrapper" style="justify-content:End;">
        <div class="lineleft"></div>
        <h1 class="sectiontitle heading6">
            <p style="text-align:center;">
                <span style="color:#252468;">STUDENTS ALLOCATION</span>
            </p>
        </h1>
        <div class="lineright" style="display:block;background-color:#daa328;"></div>
    </section>
</div>

<div class="container-fluid padding margin">
    <div class="row g-4">
        <div class="col-lg-4 col-md-6 d-grid">
            <div class="countersection">
                <h2 class="countertitle"><p><span class="heading8">ACTIVE STUDENTS</span></p></h2>
                <span class="countercorner"></span>
                <div class="counterposition">
                    <div class="counterarea heading5">
                        <span style="color:inherit;" data-toggle="counterUp">@Model.TotalActiveStudents</span>
                        <span class="counterareacorner"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 d-grid">
            <div class="countersection">
                <h2 class="countertitle"><p><span class="heading8">WITH PATIENTS</span></p></h2>
                <span class="countercorner"></span>
                <div class="counterposition">
                    <div class="counterarea heading5">
                        <span style="color:inherit;" data-toggle="counterUp">@Model.TotalAssignedStudents</span>
                        <span class="counterareacorner"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 d-grid">
            <div class="countersection">
                <h2 class="countertitle"><p><span class="heading8">WITHOUT PATIENTS</span></p></h2>
                <span class="countercorner"></span>
                <div class="counterposition">
                    <div class="counterarea heading5">
                        <span style="color:inherit;" data-toggle="counterUp">@Model.TotalUnassignedStudents</span>
                        <span class="counterareacorner"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="custom-card">

        <div style="background:#e9e8e8;width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;padding:30px 40px;">
            <div style="max-width:1300px;margin:0 auto;">
                <section id="title-wrapper" style="justify-content:flex-start;">
                    <div class="lineright" style="display:block;background-color:#daa328;max-width:650px;"></div>
                    <h1 class="sectiontitle heading6">
                        <p style="text-align:left;"><span style="color:#252468;">SEARCH STUDENTS</span></p>
                    </h1>
                </section>

                <br />

                <form method="get">
                    <div style="background:white;padding:16px 20px;">
                        <div class="row align-items-center mb-3">
                            <div class="col-md-2">
                                <label style="font-weight:600;font-size:13px;color:#252468;margin:0;">
                                    Student Name
                                </label>
                            </div>
                            <div class="col-md-10">
                                <input type="text"
                                       name="searchName"
                                       value="@Model.SearchName"
                                       placeholder="e.g. Ahmad Mohammad"
                                       class="form-control"
                                       style="border:1px solid #ddd;border-radius:0;" />
                            </div>
                        </div>

                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label style="display:block;font-weight:600;font-size:13px;color:#252468;margin-bottom:7px;">
                                    Student Number
                                </label>
                                <input type="text"
                                       name="studentNo"
                                       value="@Model.StudentNo"
                                       placeholder="e.g. 202310731"
                                       class="form-control"
                                       style="border:1px solid #ddd;border-radius:0;" />
                            </div>

                            <div class="col-md-4">
                                <label style="display:block;font-weight:600;font-size:13px;color:#252468;margin-bottom:7px;">
                                    Email
                                </label>
                                <input type="text"
                                       name="email"
                                       value="@Model.Email"
                                       placeholder="student@ammanu.edu.jo"
                                       class="form-control"
                                       style="border:1px solid #ddd;border-radius:0;" />
                            </div>

                            <div class="col-md-4">
                                <label style="display:block;font-weight:600;font-size:13px;color:#252468;margin-bottom:7px;">
                                    Allocation Status
                                </label>
                                <select name="allocationStatus"
                                        class="form-control"
                                        style="border:1px solid #ddd;border-radius:0;">
                                    <option value="">-- All --</option>
                                    <option value="Assigned" selected="@(Model.AllocationStatus == "Assigned" ? "selected" : null)">
                                        Assigned to Patient(s)
                                    </option>
                                    <option value="Unassigned" selected="@(Model.AllocationStatus == "Unassigned" ? "selected" : null)">
                                        No Assigned Patients
                                    </option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div style="text-align:center;">
                        <button type="submit"
                                style="width:90%;background:#c81589;color:white;border:none;padding:12px;font-size:15px;font-weight:600;cursor:pointer;margin-top:3px;letter-spacing:1px;">
                            Search &nbsp;<i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <br />

        <section id="title-wrapper" style="justify-content:End;">
            <div class="lineleft"></div>
            <h1 class="sectiontitle heading6">
                <p style="text-align:center;"><span style="color:#252468;">STUDENTS</span></p>
            </h1>
            <div class="lineright" style="display:block;background-color:#daa328;"></div>
        </section>

        <br />

        @if (!string.IsNullOrWhiteSpace(Model.SearchName) ||
             !string.IsNullOrWhiteSpace(Model.StudentNo) ||
             !string.IsNullOrWhiteSpace(Model.Email) ||
             !string.IsNullOrWhiteSpace(Model.AllocationStatus))
        {
            <div class="active-filters">
                <span style="font-size:12px;font-weight:600;color:#C81587;align-self:center;">Active filters:</span>

                @if (!string.IsNullOrWhiteSpace(Model.SearchName))
                {
                    <span class="filter-tag"><i class="fa-solid fa-user me-1"></i>@Model.SearchName</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.StudentNo))
                {
                    <span class="filter-tag"><i class="fa-solid fa-id-card me-1"></i>@Model.StudentNo</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <span class="filter-tag"><i class="fa-solid fa-envelope me-1"></i>@Model.Email</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AllocationStatus))
                {
                    <span class="filter-tag"><i class="fa-solid fa-user-check me-1"></i>@Model.AllocationStatus</span>
                }
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3" style="flex-wrap:wrap;gap:10px;">
            <h5 style="color:rgb(38,76,159);font-weight:600;margin:0;">
                Students &nbsp;
                <span style="background-color:#daa328;color:white;padding:4px 12px;font-weight:600;">
                    @Model.TotalItems
                </span>
            </h5>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Student Number</th>
                        <th>Student Name</th>
                        <th>Email</th>
                        <th style="text-align:center;">Allocation Status</th>
                        <th style="text-align:center;min-width:190px;">Assigned Patients</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Students.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fa-solid fa-circle-exclamation me-2"></i>
                                No students found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int rowNum = rowStart;

                        foreach (var student in Model.Students)
                        {
                            <tr>
                                <td style="color:#aaa;font-size:.8rem;">@rowNum</td>
                                <td style="font-weight:700;color:#252468;">@student.StudentNumber</td>
                                <td style="font-weight:600;">@student.FullName</td>
                                <td>@(string.IsNullOrWhiteSpace(student.Email) ? "—" : student.Email)</td>
                                <td style="text-align:center;">
                                    @if (student.HasAssignedPatients)
                                    {
                                        <span class="allocation-badge allocation-assigned">
                                            <i class="fa-solid fa-user-check me-1"></i>Assigned
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="allocation-badge allocation-unassigned">
                                            <i class="fa-solid fa-user-clock me-1"></i>Unassigned
                                        </span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    <div class="assigned-patients-cell">
                                        <span class="patient-count" title="Assigned patients count">
                                            @student.AssignedPatientsCount
                                        </span>
                                        <button type="button"
                                                class="btn-view-patients"
                                                data-student-id="@student.AppUserId"
                                                data-student-name="@student.FullName"
                                                onclick="openStudentPatients(this)">
                                            <i class="fa-solid fa-eye"></i>
                                            View Patients
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            rowNum++;
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3" aria-label="Students pagination">
                <ul class="pagination compact-pagination">
                    <li class="page-item pagination-navigation @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="?page=@(Model.CurrentPage - 1)&searchName=@Uri.EscapeDataString(Model.SearchName)&studentNo=@Uri.EscapeDataString(Model.StudentNo)&email=@Uri.EscapeDataString(Model.Email)&allocationStatus=@Uri.EscapeDataString(Model.AllocationStatus)">
                            ‹ Previous
                        </a>
                    </li>

                    @if (startPage > 1)
                    {
                        <li class="page-item @(Model.CurrentPage == 1 ? "active" : "")">
                            <a class="page-link"
                               href="?page=1&searchName=@Uri.EscapeDataString(Model.SearchName)&studentNo=@Uri.EscapeDataString(Model.StudentNo)&email=@Uri.EscapeDataString(Model.Email)&allocationStatus=@Uri.EscapeDataString(Model.AllocationStatus)">1</a>
                        </li>

                        @if (startPage > 2)
                        {
                            <li class="pagination-dots">…</li>
                        }
                    }

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="?page=@p&searchName=@Uri.EscapeDataString(Model.SearchName)&studentNo=@Uri.EscapeDataString(Model.StudentNo)&email=@Uri.EscapeDataString(Model.Email)&allocationStatus=@Uri.EscapeDataString(Model.AllocationStatus)">@p</a>
                        </li>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        @if (endPage < Model.TotalPages - 1)
                        {
                            <li class="pagination-dots">…</li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "active" : "")">
                            <a class="page-link"
                               href="?page=@Model.TotalPages&searchName=@Uri.EscapeDataString(Model.SearchName)&studentNo=@Uri.EscapeDataString(Model.StudentNo)&email=@Uri.EscapeDataString(Model.Email)&allocationStatus=@Uri.EscapeDataString(Model.AllocationStatus)">@Model.TotalPages</a>
                        </li>
                    }

                    <li class="page-item pagination-navigation @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="?page=@(Model.CurrentPage + 1)&searchName=@Uri.EscapeDataString(Model.SearchName)&studentNo=@Uri.EscapeDataString(Model.StudentNo)&email=@Uri.EscapeDataString(Model.Email)&allocationStatus=@Uri.EscapeDataString(Model.AllocationStatus)">
                            Next ›
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>


<!-- ════ ASSIGNED PATIENTS MODAL ════ -->
<div class="modal fade" id="studentPatientsModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#252468;">
                <h5 class="modal-title text-white fw-bold">
                    <i class="fa-solid fa-user-graduate me-2"></i>
                    Assigned Patients — <span id="studentPatientsName"></span>
                </h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="studentPatientsBody">
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-spinner fa-spin fa-2x"></i>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    async function openStudentPatients(button) {
        const appUserId = button.dataset.studentId;
        const studentName = button.dataset.studentName || 'Student';

        document.getElementById('studentPatientsName').textContent = studentName;

        const body = document.getElementById('studentPatientsBody');
        body.innerHTML = `
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-spinner fa-spin fa-2x"></i>
                    <div style="margin-top:10px;">Loading patients...</div>
                </div>`;

        const modalElement = document.getElementById('studentPatientsModal');
        const modal = bootstrap.Modal.getInstance(modalElement)
            || new bootstrap.Modal(modalElement);

        modal.show();

        try {
            const response = await fetch(
                `/AllocatedStudent/GetStudentPatients?appUserId=${encodeURIComponent(appUserId)}`,
                { cache: 'no-store' }
            );

            const result = await response.json();

            if (!response.ok || result.success === false) {
                throw new Error(result.message || 'Unable to load assigned patients.');
            }

            const patients = Array.isArray(result.patients)
                ? result.patients
                : [];

            if (!patients.length) {
                body.innerHTML = `
                        <div class="text-center py-5">
                            <i class="fa-solid fa-user-slash"
                               style="font-size:44px;color:#9ca3af;margin-bottom:14px;"></i>
                            <div style="font-size:15px;font-weight:600;color:#6b7280;">
                                This student has no assigned patients.
                            </div>
                        </div>`;
                return;
            }

            body.innerHTML = `
                    <div style="background:#f0fdf4;border:1px solid #bbf7d0;
                                padding:12px 16px;margin-bottom:15px;border-radius:7px;">
                        <i class="fa-solid fa-users" style="color:#16a34a;"></i>
                        <strong style="color:#166534;margin-left:5px;">
                            ${patients.length} assigned patient(s)
                        </strong>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped align-middle mb-0">
                            <thead style="background:#252468;color:#fff;">
                                <tr>
                                    <th>#</th>
                                    <th>Patient Name</th>
                                    <th>National ID</th>
                                    <th>Gender</th>
                                    <th>Assigned Date</th>
                                    <th style="text-align:center;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${patients.map((patient, index) => `
                                    <tr>
                                        <td style="color:#9ca3af;">${index + 1}</td>
                                        <td style="font-weight:700;color:#252468;">
                                            ${escapePatientHtml(patient.name || '—')}
                                        </td>
                                        <td>${escapePatientHtml(patient.nationalId || '—')}</td>
                                        <td>${escapePatientHtml(patient.gender || '—')}</td>
                                        <td style="white-space:nowrap;">
                                            ${escapePatientHtml(patient.assignedDate || '—')}
                                        </td>
                                        <td style="text-align:center;">
                                            ${renderPatientStatus(patient.status)}
                                        </td>
                                    </tr>`).join('')}
                            </tbody>
                        </table>
                    </div>`;
        }
        catch (error) {
            console.error(error);
            body.innerHTML = `
                    <div class="alert alert-danger mb-0">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        ${escapePatientHtml(error.message || 'Unable to load assigned patients.')}
                    </div>`;
        }
    }

    function escapePatientHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function renderPatientStatus(status) {
        const normalized = String(status || 'Screening').trim();

        if (normalized === 'Allocated') {
            return `<span class="patient-status-badge patient-status-allocated">
                            <i class="fa-solid fa-user-check me-1"></i>Allocated
                        </span>`;
        }

        if (normalized === 'Discharged') {
            return `<span class="patient-status-badge patient-status-discharged">
                            <i class="fa-solid fa-door-open me-1"></i>Discharged
                        </span>`;
        }

        return `<span class="patient-status-badge patient-status-screening">
                        <i class="fa-solid fa-microscope me-1"></i>Screening
                    </span>`;
    }
</script>
