@model DentalCollegeManagementSystem_AAU.Models.StudentTransfer.StudentTransferPageViewModel

@{
    ViewData["Title"] = "نقل طلاب السنة الثالثة";

    string messageType =
        TempData["MessageType"]?.ToString() ??
        string.Empty;

    string message =
        TempData["Message"]?.ToString() ??
        string.Empty;

    int rowNumber =
        ((Model.Page - 1) * Model.PageSize) + 1;
}

<style>
    .student-transfer-page {
        direction: rtl;
        color: #303544;
        font-family: Tahoma, Arial, sans-serif;
    }

    .student-transfer-header {
        position: relative;
        overflow: hidden;
        margin-bottom: 20px;
        padding: 28px;
        color: #fff;
        background:
            linear-gradient(135deg, #252468 0%, #34338a 100%);
        border-bottom: 5px solid #c7a34b;
        border-radius: 14px;
        box-shadow: 0 8px 22px rgba(37, 36, 104, .16);
    }

    .student-transfer-header::after {
        position: absolute;
        top: -70px;
        left: -50px;
        width: 190px;
        height: 190px;
        content: "";
        background: rgba(255, 255, 255, .08);
        border-radius: 50%;
    }

    .student-transfer-header h1 {
        position: relative;
        z-index: 1;
        margin: 0 0 8px;
        font-size: 26px;
        font-weight: 800;
    }

    .student-transfer-header p {
        position: relative;
        z-index: 1;
        margin: 0;
        opacity: .88;
    }

    .transfer-card {
        margin-bottom: 18px;
        padding: 20px;
        background: #fff;
        border: 1px solid #e1e4ea;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, .055);
    }

    .transfer-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 12px;
    }

    .search-field {
        flex: 1 1 420px;
    }

    .search-field label {
        display: block;
        margin-bottom: 7px;
        color: #3f4454;
        font-weight: 700;
    }

    .transfer-input {
        width: 100%;
        height: 44px;
        padding: 8px 13px;
        border: 1px solid #cfd4dd;
        border-radius: 7px;
        outline: none;
    }

    .transfer-input:focus {
        border-color: #34338a;
        box-shadow: 0 0 0 3px rgba(52, 51, 138, .11);
    }

    .transfer-button {
        display: inline-flex;
        min-height: 44px;
        padding: 10px 18px;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 7px;
        color: #fff !important;
        background: #252468;
        text-decoration: none !important;
        font-weight: 700;
        cursor: pointer;
    }

    .transfer-button:hover {
        opacity: .93;
    }

    .transfer-button-success {
        background: #168347;
    }

    .transfer-button-secondary {
        background: #656a74;
    }

    .summary-grid {
        display: grid;
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
        gap: 13px;
    }

    .summary-item {
        padding: 17px;
        text-align: center;
        background: #fff;
        border: 1px solid #e1e4ea;
        border-radius: 10px;
    }

    .summary-item.total {
        border-top: 4px solid #252468;
    }

    .summary-item.existing {
        border-top: 4px solid #168347;
    }

    .summary-item.pending {
        border-top: 4px solid #c68a00;
    }

    .summary-number {
        display: block;
        margin-bottom: 4px;
        font-size: 29px;
        font-weight: 800;
    }

    .transfer-alert {
        margin-bottom: 18px;
        padding: 13px 15px;
        border-radius: 8px;
        text-align: center;
        font-weight: 700;
    }

    .transfer-alert.success {
        color: #155724;
        background: #d4edda;
        border: 1px solid #c3e6cb;
    }

    .transfer-alert.warning {
        color: #856404;
        background: #fff3cd;
        border: 1px solid #ffeeba;
    }

    .transfer-alert.error {
        color: #721c24;
        background: #f8d7da;
        border: 1px solid #f5c6cb;
    }

    .table-heading {
        margin: 0 0 14px;
        color: #252468;
        font-size: 20px;
        font-weight: 800;
    }

    .table-responsive-custom {
        width: 100%;
        overflow-x: auto;
    }

    .students-table {
        width: 100%;
        min-width: 940px;
        border-collapse: collapse;
    }

    .students-table th {
        padding: 12px 10px;
        color: #fff;
        background: #555a64;
        border: 1px solid #6e737d;
        text-align: center;
        white-space: nowrap;
        font-size: 13px;
    }

    .students-table td {
        padding: 11px 10px;
        background: #fff;
        border: 1px solid #e0e3e8;
        text-align: center;
        vertical-align: middle;
        font-size: 13px;
    }

    .students-table tbody tr:nth-child(even) td {
        background: #f8f9fb;
    }

    .student-name-cell {
        min-width: 230px;
        text-align: right !important;
        font-weight: 700;
    }

    .ltr-cell {
        direction: ltr;
    }

    .status-badge {
        display: inline-block;
        min-width: 112px;
        padding: 6px 10px;
        border-radius: 18px;
        font-size: 11px;
        font-weight: 800;
    }

    .status-existing {
        color: #155724;
        background: #d4edda;
        border: 1px solid #c3e6cb;
    }

    .status-new {
        color: #856404;
        background: #fff3cd;
        border: 1px solid #ffeeba;
    }

    .empty-box {
        padding: 28px;
        color: #8b1d26;
        background: #fff8f8;
        border: 1px dashed #d9a5a9;
        border-radius: 9px;
        text-align: center;
        font-weight: 700;
    }

    .table-footer {
        display: flex;
        flex-wrap: wrap;
        margin-top: 17px;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .pagination-custom {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .page-link-custom {
        display: inline-flex;
        min-width: 39px;
        height: 39px;
        padding: 0 10px;
        align-items: center;
        justify-content: center;
        color: #252468;
        background: #fff;
        border: 1px solid #d5d9e0;
        border-radius: 6px;
        text-decoration: none !important;
        font-weight: 700;
    }

    .page-link-custom.active {
        color: #fff;
        background: #252468;
        border-color: #252468;
    }

    .page-link-custom.disabled {
        opacity: .45;
        pointer-events: none;
    }

    .record-info {
        color: #666b75;
        font-size: 13px;
        font-weight: 700;
    }

    .important-note {
        margin-top: 16px;
        padding: 12px 14px;
        color: #624d12;
        background: #fff9e8;
        border-right: 4px solid #c7a34b;
        border-radius: 7px;
        line-height: 1.8;
    }

    @@media (max-width: 800px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .transfer-toolbar > * {
            width: 100%;
        }

        .transfer-button {
            width: 100%;
        }

        .student-transfer-header h1 {
            font-size: 21px;
        }
    }
</style>

<div class="student-transfer-page">

    <section class="student-transfer-header">
        <h1>نقل بيانات طلاب السنة الثالثة</h1>
        <p>
            قراءة الطلاب من Oracle وإضافتهم أو تحديث بياناتهم في جدول Users.
        </p>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="transfer-alert @messageType">
            @message
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="transfer-alert error">
            @ViewBag.ErrorMessage
        </div>
    }

    <section class="transfer-card">

        <div class="transfer-toolbar">

            <form asp-action="Index"
                  asp-controller="StudentTransfer"
                  method="get"
                  class="transfer-toolbar"
                  style="flex: 1 1 650px;">

                <div class="search-field">

                    <label for="search">
                        البحث عن طالب
                    </label>

                    <input id="search"
                           name="search"
                           value="@Model.Search"
                           class="transfer-input"
                           placeholder="رقم الطالب أو الاسم أو البريد الإلكتروني" />

                    <input type="hidden"
                           name="pageSize"
                           value="@Model.PageSize" />

                </div>

                <button type="submit"
                        class="transfer-button">
                    بحث
                </button>

                <a asp-action="Index"
                   asp-controller="StudentTransfer"
                   class="transfer-button transfer-button-secondary">
                    مسح البحث
                </a>

            </form>

            <form asp-action="Transfer"
                  asp-controller="StudentTransfer"
                  method="post"
                  onsubmit="return confirm('سيتم نقل الطلاب الجدد وتحديث بيانات الطلاب الموجودين. هل تريد المتابعة؟');">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="search"
                       value="@Model.Search" />

                <input type="hidden"
                       name="page"
                       value="@Model.Page" />

                <input type="hidden"
                       name="pageSize"
                       value="@Model.PageSize" />

                <button type="submit"
                        class="transfer-button transfer-button-success">
                    نقل الطلاب إلى SQL
                </button>

            </form>

        </div>

    </section>

    <section class="transfer-card">

        <div class="summary-grid">

            <div class="summary-item total">
                <span class="summary-number">
                    @Model.OracleTotalCount
                </span>
                <span>إجمالي طلاب Oracle</span>
            </div>

            <div class="summary-item existing">
                <span class="summary-number">
                    @Model.ExistingCount
                </span>
                <span>موجودون في SQL</span>
            </div>

            <div class="summary-item pending">
                <span class="summary-number">
                    @Model.NewCount
                </span>
                <span>غير منقولين</span>
            </div>

        </div>

    </section>

    <section class="transfer-card">

        <h2 class="table-heading">
            بيانات الطلاب
        </h2>

        @if (Model.Students.Count == 0)
        {
            <div class="empty-box">
                لا توجد بيانات طلاب مطابقة.
            </div>
        }
        else
        {
            <div class="table-responsive-custom">

                <table class="students-table">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>رقم الطالب الجامعي</th>
                            <th>اسم الطالب</th>
                            <th>البريد الإلكتروني</th>
                            <th>المستوى</th>
                            <th>حالة النقل</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var student in Model.Students)
                        {
                            <tr>

                                <td>
                                    @rowNumber
                                </td>

                                <td class="ltr-cell">
                                    @student.Username
                                </td>

                                <td class="student-name-cell">
                                    @student.FullName
                                </td>

                                <td class="ltr-cell">
                                    @student.Email
                                </td>

                                <td>
                                    @student.LevelDescription
                                </td>

                                <td>

                                    @if (student.IsTransferred)
                                    {
                                        <span class="status-badge status-existing">
                                            موجود في SQL
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-new">
                                            غير منقول
                                        </span>
                                    }

                                </td>

                            </tr>

                            rowNumber++;
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">

                <div class="record-info">
                    عرض @Model.FirstItemNumber إلى
                    @Model.LastItemNumber من
                    @Model.TotalItems سجل
                </div>

                <div class="pagination-custom">

                    <a asp-action="Index"
                       asp-controller="StudentTransfer"
                       asp-route-search="@Model.Search"
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       class="page-link-custom @(Model.HasPreviousPage ? "" : "disabled")">
                        السابق
                    </a>

                    @{
                        int firstPage =
                            Math.Max(
                                1,
                                Model.Page - 2);

                        int lastPage =
                            Math.Min(
                                Model.TotalPages,
                                Model.Page + 2);
                    }

                    @for (int pageNumber = firstPage;
                         pageNumber <= lastPage;
                         pageNumber++)
                    {
                        <a asp-action="Index"
                           asp-controller="StudentTransfer"
                           asp-route-search="@Model.Search"
                           asp-route-page="@pageNumber"
                           asp-route-pageSize="@Model.PageSize"
                           class="page-link-custom @(pageNumber == Model.Page ? "active" : "")">
                            @pageNumber
                        </a>
                    }

                    <a asp-action="Index"
                       asp-controller="StudentTransfer"
                       asp-route-search="@Model.Search"
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       class="page-link-custom @(Model.HasNextPage ? "" : "disabled")">
                        التالي
                    </a>

                </div>

            </div>
        }

        <div class="important-note">
            يتم إنشاء البريد الإلكتروني من رقم الطالب متبوعاً بـ
            <strong>@@ammanu.edu.jo</strong>.
            كلمة المرور الافتراضية للطالب الجديد هي
            <strong>1</strong>.
            لا يتم تغيير كلمة مرور الطالب الموجود إلا عند تفعيل
            ResetExistingPasswords من الإعدادات.
        </div>

    </section>

</div>
